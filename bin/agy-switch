def cmd_actualizar(extra_args: list = None):
    print("\n╭─────────────────────────────────────────────────────────────╮")
    print("│  🔄 ACTUALIZANDO CLI ACCOUNT SWITCH DESDE GITHUB            │")
    print("╰─────────────────────────────────────────────────────────────╯")
    print(f"  • Versión instalada actualmente : \033[1;36mv{VERSION}\033[0m")
    print(f"  • Repositorio oficial           : https://github.com/{GITHUB_REPO}\n")

    here = Path(__file__).resolve().parent
    repo_dir = here.parent if (here.parent / ".git").is_dir() else None

    if repo_dir and shutil.which("git"):
        print(f"  📁 Repositorio git local detectado en: {repo_dir}")
        print("     Sincronizando cambios con 'git pull'...")
        try:
            res_pull = subprocess.run(["git", "-C", str(repo_dir), "pull", "--ff-only"], check=False, capture_output=True, text=True)
            if res_pull.returncode == 0:
                print(f"     {res_pull.stdout.strip()}")
                install_script = repo_dir / "install.sh"
                if install_script.is_file():
                    print("     Reinstalando scripts en el sistema...")
                    res_inst = subprocess.run(["bash", str(install_script)] + (extra_args or []), check=False)
                    if res_inst.returncode == 0:
                        print(f"\n✅ ¡CLI Account Switch se ha actualizado exitosamente a la última versión!")
                        return
            else:
                print(f"⚠️ 'git pull' no pudo completarse limpiamente: {res_pull.stderr.strip()}")
                print("   Intentando actualización directa descargando el instalador oficial...")
        except Exception as e:
            print(f"⚠️ Error al actualizar mediante git: {e}")
            print("   Intentando actualización directa...")

    print(f"  🌐 Descargando instalador oficial desde GitHub...")
    try:
        req = urllib.request.Request(INSTALL_URL, headers={"User-Agent": "cli-account-switch-updater"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            script_content = resp.read().decode("utf-8")
    except Exception as e:
        print(f"❌ Error al conectar con GitHub para descargar el instalador: {e}")
        print("\nPuedes actualizar manualmente ejecutando en tu terminal:")
        print(f"  curl -fsSL {INSTALL_URL} | bash\n")
        sys.exit(1)

    with tempfile.NamedTemporaryFile("w", suffix=".sh", delete=False) as f:
        f.write(script_content)
        installer_path = f.name

    try:
        os.chmod(installer_path, 0o755)
        cmd = ["bash", installer_path] + (extra_args or [])
        res = subprocess.run(cmd, check=False)
        if res.returncode == 0:
            print(f"\n✅ ¡CLI Account Switch se ha actualizado exitosamente desde GitHub!")
            print("   Ejecuta: \033[1;32magy-switch version\033[0m para verificar la versión instalada.\n")
        else:
            print(f"\n❌ El instalador finalizó con código de error: {res.returncode}")
            sys.exit(res.returncode)
    finally:
        if os.path.exists(installer_path):
            os.unlink(installer_path)

    # Actualizar también el cliente Antigravity CLI
    if shutil.which("agy") and "--no-agy" not in (extra_args or []):
        print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
        print("  Verificando y actualizando Antigravity CLI ('agy update')...")
        print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
        try:
            subprocess.run(["agy", "update"], check=False)
        except Exception as e:
            print(f"  ⚠️ No se pudo ejecutar 'agy update': {e}")


def mask_identifier(ident: str) -> str:
    if not ident:
        return "Desconocido"
    if "@" in ident:
        parts = ident.split("@", 1)
        user, domain = parts[0], parts[1]
        if len(user) <= 1:
            masked_user = user + "***"
        elif len(user) == 2:
            masked_user = user[0] + "***"
        else:
            masked_user = user[0] + "***" + user[-1]
        return f"{masked_user}@{domain}"
    if len(ident) > 6:
        return ident[:2] + "***" + ident[-2:]
    return "***"


def acquire_file_lock(lock_file: Path, timeout: float = 3.0):
    try:
        import fcntl
        lock_file.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(str(lock_file), os.O_CREAT | os.O_RDWR, 0o600)
        start = time.time()
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return fd
            except (BlockingIOError, OSError):
                if time.time() - start > timeout:
                    os.close(fd)
                    return None
                time.sleep(0.05)
    except Exception:
        return None


def release_file_lock(fd):
    if fd is not None:
        try:
            import fcntl
            fcntl.flock(fd, fcntl.LOCK_UN)
            os.close(fd)
        except Exception:
            pass


def cmd_cuentas_json() -> dict:
    sync_active_profile()
    token_path = get_token_path(auto_sync=False)
    cuentas_dir = get_cuentas_dir()
    active_profile = find_active_profile_name(cuentas_dir, token_path) if token_path.is_file() else ""
    guardadas = sorted(cuentas_dir.glob("*.token"))
    accounts = []
    for f in guardadas:
        p_name = f.stem
        is_active = (p_name == active_profile)
        email = decode_email_from_token(f)
        plan = "Antigravity"
        try:
            f_data = json.loads(f.read_text(encoding="utf-8"))
            plan = f_data.get("plan") or plan
        except Exception:
            pass
        accounts.append({
            "alias": p_name,
            "es_activa": is_active,
            "identificador_enmascarado": mask_identifier(email),
            "identidad_opaca": compute_opaque_identity(f),
            "plan": plan.upper(),
            "estado": "disponible"
        })
    return {
        "disponible": True,
        "perfil_activo": active_profile,
        "cuentas": accounts
    }


def cmd_cuota_json(target: str = "") -> dict:
    sync_active_profile()
    token_path = get_token_path(auto_sync=False)
    cuentas_dir = get_cuentas_dir()
    active_profile = find_active_profile_name(cuentas_dir, token_path) if token_path.is_file() else ""
    guardadas = sorted(cuentas_dir.glob("*.token"))
    if target:
        guardadas = [f for f in guardadas if f.stem == target]

    now_dt = datetime.now(timezone.utc)
    accounts = []
    for f in guardadas:
        p_name = f.stem
        is_active = (p_name == active_profile)
        email = decode_email_from_token(f)
        plan = "Antigravity"
        try:
            f_data = json.loads(f.read_text(encoding="utf-8"))
            plan = f_data.get("plan") or plan
        except Exception:
            pass

        try:
            q = fetch_agy_quota(f, active_profile="")
        except Exception as e:
            q = {"err_msg": str(e)}

        err = q.get("err_msg")
        models = q.get("models", {})
        models_data = {}
        if isinstance(models, dict):
            for m_name, m_info in models.items():
                if isinstance(m_info, dict):
                    q_info = m_info.get("quotaInfo", {}) if isinstance(m_info.get("quotaInfo"), dict) else {}
                    frac = float(q_info.get("remainingFraction", 1.0))
                    reset_str = q_info.get("resetTime", "")
                    models_data[m_name] = {
                        "restante_porcentaje": round(frac * 100, 1),
                        "resetea_en_timestamp": reset_str or None,
                        "agotada": frac <= 0.05
                    }

        status_code = "disponible"
        if err:
            err_lower = err.lower()
            if "expirado" in err_lower or "401" in err_lower or "login" in err_lower:
                status_code = "invalid_auth"
            elif "conexión" in err_lower or "conexion" in err_lower or "timeout" in err_lower:
                status_code = "network_error"
            else:
                status_code = "unknown_quota"

        accounts.append({
            "alias": p_name,
            "es_activa": is_active,
            "identificador_enmascarado": mask_identifier(email),
            "identidad_opaca": compute_opaque_identity(f),
            "plan": plan.upper(),
            "estado": status_code,
            "error": err,
            "frescura": now_dt.isoformat(),
            "modelos": models_data
        })

    return {
        "disponible": True,
        "perfil_activo": active_profile,
        "cuentas": accounts
    }


def find_active_parallel_leases() -> list[str]:
    runtimes_dir = get_base_dir() / "runtimes"
    if not runtimes_dir.is_dir():
        return []
    busy_leases = []
    for lease_file in runtimes_dir.glob("*.lease"):
        if lease_file.name.startswith(".id_"):
            continue
        try:
            fd = os.open(str(lease_file), os.O_RDWR)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                fcntl.flock(fd, fcntl.LOCK_UN)
            except (BlockingIOError, OSError):
                busy_leases.append(lease_file.stem)
            finally:
                os.close(fd)
        except Exception:
            pass
    return busy_leases


def cmd_ocupacion_json() -> dict:
    sync_active_profile()
    running_clients = find_running_clients("agy")
    parallel_busy = find_active_parallel_leases()
    token_path = get_token_path(auto_sync=False)
    cuentas_dir = get_cuentas_dir()
    active_profile = find_active_profile_name(cuentas_dir, token_path) if token_path.is_file() else ""
    is_busy = len(running_clients) > 0 or len(parallel_busy) > 0
    desc = []
    if running_clients:
        desc.append(f"{len(running_clients)} sesión(es) de Antigravity activa(s)")
    if parallel_busy:
        desc.append(f"{len(parallel_busy)} worker(s) paralelo(s) activo(s): {', '.join(parallel_busy)}")
    if not desc:
        desc.append("Sin sesiones activas")

    return {
        "ocupado": is_busy,
        "puede_conmutar": not is_busy,
        "motivo": "active_session" if is_busy else None,
        "descripcion": " · ".join(desc),
        "perfil_activo": active_profile,
        "procesos": running_clients,
        "procesos_paralelos": parallel_busy
    }


def cmd_seleccionar_json(nombre: str, dry_run: bool = False, lock_timeout: int = 5) -> dict:
    validate_alias(nombre)
    cuentas_dir = get_cuentas_dir()
    src = cuentas_dir / f"{nombre}.token"
    if not src.is_file():
        return {
            "solicitud": {"proveedor": "agy", "cuenta_destino": nombre, "dry_run": dry_run},
            "permitido": False,
            "codigo": "invalid_auth",
            "mensaje": f"La cuenta '{nombre}' no existe en {cuentas_dir}",
            "bloqueo_adquirido": False,
            "cambio_realizado": False
        }
    running = find_running_clients("agy")
    if running:
        return {
            "solicitud": {"proveedor": "agy", "cuenta_destino": nombre, "dry_run": dry_run},
            "permitido": False,
            "codigo": "active_session",
            "mensaje": f"No se puede conmutar: se detectaron {len(running)} sesiones activas de Antigravity.",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
            "procesos": running
        }
    parallel_busy = find_active_parallel_leases()
    if parallel_busy:
        return {
            "solicitud": {"proveedor": "agy", "cuenta_destino": nombre, "dry_run": dry_run},
            "permitido": False,
            "codigo": "active_session",
            "mensaje": f"No se puede conmutar: hay workers paralelos activos ({', '.join(parallel_busy)}).",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
            "procesos_paralelos": parallel_busy
        }
    if dry_run:
        return {
            "solicitud": {"proveedor": "agy", "cuenta_destino": nombre, "dry_run": True},
            "permitido": True,
            "codigo": "ok",
            "mensaje": "Conmutación viable y segura (dry-run verificado)",
            "bloqueo_adquirido": False,
            "cambio_realizado": False
        }
    lock_file = get_base_dir() / "switch.lock"
    fd = acquire_file_lock(lock_file, timeout=float(lock_timeout))
    if fd is None:
        return {
            "solicitud": {"proveedor": "agy", "cuenta_destino": nombre, "dry_run": False},
            "permitido": False,
            "codigo": "lock_failed",
            "mensaje": "No se pudo adquirir el bloqueo atómico para conmutación",
            "bloqueo_adquirido": False,
            "cambio_realizado": False
        }
    try:
        token_path = get_token_path(auto_sync=False)
        active_before = find_active_profile_name(cuentas_dir, token_path)
        prev_active = get_recorded_active_profile() or active_before
        if prev_active and not prev_active.startswith("(") and prev_active != nombre:
            prev_file = cuentas_dir / f"{prev_active}.token"
            if prev_file.is_file() and token_path.is_file() and token_path.stat().st_size > 10:
                try:
                    if prev_file.read_bytes() != token_path.read_bytes():
                        private_copy(token_path, prev_file)
                except Exception:
                    pass
        private_copy(src, token_path)
        set_recorded_active_profile(nombre)
        try:
            raw_tok = token_path.read_text(encoding="utf-8")
            if not sync_token_to_keyring(raw_tok):
                clear_token_from_keyring()
        except Exception:
            pass
        return {
            "solicitud": {"proveedor": "agy", "cuenta_destino": nombre, "dry_run": False},
            "permitido": True,
            "codigo": "ok",
            "mensaje": f"Cuenta conmutada exitosamente a '{nombre}' de forma atómica.",
            "bloqueo_adquirido": True,
            "cambio_realizado": True,
            "cuenta_previa": active_before,
            "cuenta_activa": nombre
        }
    finally:
        release_file_lock(fd)


def cmd_paralelo(nombre: str, extra_cmd: list[str]):
    validate_alias(nombre)
    cuentas_dir = get_cuentas_dir()
    src = cuentas_dir / f"{nombre}.token"
    if not src.is_file():
        print(f"❌ Error: La cuenta '{nombre}' no existe en {cuentas_dir}.", file=sys.stderr)
        sys.exit(1)

    opaque_id = compute_opaque_identity(src)
    runtimes_dir = get_base_dir() / "runtimes"
    runtimes_dir.mkdir(parents=True, exist_ok=True, mode=0o700)

    # 1. Alias lease lock
    alias_lease_file = runtimes_dir / f"{nombre}.lease"
    try:
        alias_lease_fd = os.open(str(alias_lease_file), os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(alias_lease_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        os.ftruncate(alias_lease_fd, 0)
        os.write(alias_lease_fd, f"pid={os.getpid()}\nalias={nombre}\nstarted={int(time.time())}\n".encode())
    except (BlockingIOError, OSError):
        print(f"❌ Error [alias_lease_busy]: El alias '{nombre}' ya está en ejecución paralela activa (lease ocupado).", file=sys.stderr)
        sys.exit(101)

    # 2. Identity lease lock
    id_lease_fd = None
    if opaque_id:
        id_lease_file = runtimes_dir / f".id_{opaque_id}.lease"
        try:
            id_lease_fd = os.open(str(id_lease_file), os.O_CREAT | os.O_RDWR, 0o600)
            fcntl.flock(id_lease_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.ftruncate(id_lease_fd, 0)
            os.write(id_lease_fd, f"pid={os.getpid()}\nalias={nombre}\nid={opaque_id}\nstarted={int(time.time())}\n".encode())
        except (BlockingIOError, OSError):
            try:
                fcntl.flock(alias_lease_fd, fcntl.LOCK_UN)
                os.close(alias_lease_fd)
            except Exception:
                pass
            print(f"❌ Error [identity_collision]: La identidad real ('{opaque_id}') asociada al alias '{nombre}' ya está en ejecución paralela activa bajo otro alias.", file=sys.stderr)
            sys.exit(102)

    runtime_dir = runtimes_dir / nombre
    runtime_agy_dir = runtime_dir / ".gemini" / "antigravity-cli"
    runtime_agy_dir.mkdir(parents=True, exist_ok=True, mode=0o700)

    try:
        isolated_token = runtime_agy_dir / "antigravity-oauth-token"
        private_copy(src, isolated_token)

        real_home = Path(os.environ.get("HOME", Path.home()))
        for item in [".gitconfig", ".ssh"]:
            target = real_home / item
            link_name = runtime_dir / item
            if target.exists() and not link_name.exists():
                try:
                    os.symlink(target, link_name)
                except Exception:
                    pass

        gemini_config = real_home / ".gemini" / "config"
        runtime_gemini = runtime_dir / ".gemini"
        runtime_gemini.mkdir(parents=True, exist_ok=True)
        runtime_config_link = runtime_gemini / "config"
        if gemini_config.exists() and not runtime_config_link.exists():
            try:
                os.symlink(gemini_config, runtime_config_link)
            except Exception:
                pass

        isolated_env = os.environ.copy()
        isolated_env["HOME"] = str(runtime_dir)
        isolated_env["DBUS_SESSION_BUS_ADDRESS"] = ""
        isolated_env["XDG_DATA_HOME"] = str(runtime_dir / ".local" / "share")
        isolated_env["XDG_CONFIG_HOME"] = str(runtime_dir / ".config")
        isolated_env["AGY_PROFILE"] = nombre

        cmd_to_run = extra_cmd if extra_cmd else ["agy"]
        try:
            res = subprocess.run(cmd_to_run, env=isolated_env)
            ret = res.returncode
        except FileNotFoundError:
            print(f"❌ Error: No se encontró el ejecutable '{cmd_to_run[0]}'.", file=sys.stderr)
            ret = 127
        except KeyboardInterrupt:
            ret = 130

        if isolated_token.is_file():
            try:
                if isolated_token.read_bytes() != src.read_bytes():
                    private_copy(isolated_token, src)
            except Exception as e:
                recovery_name = f"recovery-{nombre}-{int(time.time())}.token"
                recovery_path = runtimes_dir / recovery_name
                try:
                    private_copy(isolated_token, recovery_path)
                except Exception:
                    try:
                        recovery_path = Path(tempfile.gettempdir()) / recovery_name
                        private_copy(isolated_token, recovery_path)
                    except Exception:
                        pass
                print(f"❌ Error [refresh_persistence_failed]: No se pudo actualizar el token refrescado en '{src}': {e}. Copia de respaldo guardada en '{recovery_path}'.", file=sys.stderr)
                if ret == 0:
                    ret = 103

        sys.exit(ret)
    finally:
        if id_lease_fd is not None:
            try:
                fcntl.flock(id_lease_fd, fcntl.LOCK_UN)
                os.close(id_lease_fd)
            except Exception:
                pass
        try:
            fcntl.flock(alias_lease_fd, fcntl.LOCK_UN)
            os.close(alias_lease_fd)
        except Exception:
            pass


def main():
    sync_active_profile()
    args = sys.argv[1:]
    if "--json" in args:
        if not args or args[0] in ("status", "estado", "-s", "tokens", "token", "cuota", "quota", "usage", "saldo"):
            target = [a for a in args[1:] if not a.startswith("-")]
            t = target[0] if target else ""
            print(json.dumps(cmd_cuota_json(t), indent=2))
            sys.exit(0)
        elif args[0] in ("cuentas", "accounts", "listar", "list", "ls"):
            print(json.dumps(cmd_cuentas_json(), indent=2))
            sys.exit(0)
        elif args[0] in ("ocupacion", "ocupado", "sesiones", "clients"):
            res = cmd_ocupacion_json()
            print(json.dumps(res, indent=2))
            sys.exit(0 if not res.get("ocupado") else 1)
        elif args[0] in ("seleccionar", "select", "usar", "use"):
            target = [a for a in args[1:] if not a.startswith("-")]
            t = target[0] if target else ""
            dry_run = "--dry-run" in args
            res = cmd_seleccionar_json(t, dry_run=dry_run)
            print(json.dumps(res, indent=2))
            sys.exit(0 if res.get("permitido") else 1)
        elif args[0] in ("preflight", "capabilities", "capacidades"):
            res = {
                "protocol_version": 1,
                "version": VERSION,
                "proveedor": "agy",
                "capabilities": {
                    "parallel": True,
                    "identity_reservation": True,
                    "active_session_detection": True,
                    "refresh_persistence_errors": True
                }
            }
            print(json.dumps(res, indent=2))
            sys.exit(0)

    if not args or args[0] in ("status", "estado", "-s", "tokens", "token", "cuota", "quota", "usage", "saldo"):
        target = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        cmd_status(target)
    elif args[0] in ("version", "--version", "-v", "-V"):
        cmd_version()
    elif args[0] in ("preflight", "capabilities", "capacidades"):
        res = {
            "protocol_version": 1,
            "version": VERSION,
            "proveedor": "agy",
            "capabilities": {
                "parallel": True,
                "identity_reservation": True,
                "active_session_detection": True,
                "refresh_persistence_errors": True
            }
        }
        print(json.dumps(res, indent=2))
        sys.exit(0)
    elif args[0] in ("actualizar", "update", "upgrade"):
        cmd_actualizar(args[1:])
    elif args[0] in ("widget", "gui", "ui", "dashboard"):
        cmd_widget(args[1:])
    elif args[0] in ("tray", "barra", "taskbar"):
        cmd_tray(args[1:])
    elif args[0] in ("listar", "list", "ls"):
        cmd_listar()
    elif args[0] in ("guardar", "save"):
        nombre = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        force = any(a in ("--force", "-f") for a in args[1:])
        cmd_guardar(nombre, force=force)
    elif args[0] in ("eliminar", "borrar", "rm", "delete", "quitar"):
        nombre = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        cmd_eliminar(nombre)
    elif args[0] in ("renombrar", "mv", "rename"):
        actual = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        nuevo = args[2] if len(args) > 2 and not args[2].startswith("-") else ""
        cmd_renombrar(actual, nuevo)
    elif args[0] in ("usar", "use", "switch"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        nombre = positionals[0] if positionals else ""
        force = any(a in ("--force", "-f", "-y", "--yes") for a in args[1:])
        cmd_usar(nombre, force=force)
    elif args[0] in ("reautenticar", "reauth"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        nombre = positionals[0] if positionals else ""
        cmd_reautenticar(nombre)
    elif args[0] in ("agregar", "add"):
        i = 1
        desde = ""
        force = False
        positionals = []
        while i < len(args):
            a = args[i]
            if a in ("--desde", "--from", "--importar", "--import"):
                if i + 1 < len(args):
                    desde = args[i + 1]
                    i += 2
                    continue
                else:
                    print("❌ Error: --desde requiere una ruta de archivo o JSON.")
                    sys.exit(2)
            elif a in ("--force", "-f", "-y", "--yes"):
                force = True
            elif a.startswith("-"):
                print(f"Opción no reconocida: {a}")
                print("Uso: agy-switch agregar <nombre> [--desde <ruta_o_json>] [--force|-y]")
                sys.exit(2)
            else:
                positionals.append(a)
            i += 1
        nombre = positionals[0] if positionals else ""
        cmd_agregar(nombre, desde=desde, force=force)
    elif args[0] in ("nueva", "new", "login", "login-nueva"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        nombre = positionals[0] if positionals else ""
        options = [a for a in args[1:] if a.startswith("-")]
        force = any(a in ("--force", "-f", "-y", "--yes") for a in options)
        aislada = any(a in ("--aislada", "--no-switch", "--isolated") for a in options)
        if nombre and (get_cuentas_dir() / f"{nombre}.token").is_file() and args[0] == "login":
            cmd_reautenticar(nombre)
            sys.exit(0)
        unknown = [option for option in options if option not in ("--force", "-f", "-y", "--yes", "--aislada", "--no-switch", "--isolated")]
        if unknown:
            print(f"Opción no reconocida para nueva cuenta: {unknown[0]}")
            print("Uso: agy-switch nueva <nombre> [--force|-y] [--aislada]")
            sys.exit(2)
        cmd_nueva(nombre, force=force, aislada=aislada)
    elif args[0] in ("continuar", "continue", "resume", "-c"):
        cmd_continuar(args[1:])
    elif args[0] in ("id", "hash"):
        cid = get_most_recent_conversation_id()
        if cid:
            print(cid)
        else:
            sys.exit(1)
    elif args[0] in ("cuentas", "accounts"):
        print(json.dumps(cmd_cuentas_json(), indent=2))
        sys.exit(0)
    elif args[0] in ("cuota", "quota"):
        target = [a for a in args[1:] if not a.startswith("-")]
        t = target[0] if target else ""
        print(json.dumps(cmd_cuota_json(t), indent=2))
        sys.exit(0)
    elif args[0] in ("ocupacion", "ocupado", "sesiones", "clients"):
        res = cmd_ocupacion_json()
        print(json.dumps(res, indent=2))
        sys.exit(0 if not res.get("ocupado") else 1)
    elif args[0] in ("seleccionar", "select"):
        target = [a for a in args[1:] if not a.startswith("-")]
        t = target[0] if target else ""
        dry_run = "--dry-run" in args
        res = cmd_seleccionar_json(t, dry_run=dry_run)
        print(json.dumps(res, indent=2))
        sys.exit(0 if res.get("permitido") else 1)
    elif args[0] in ("paralelo", "parallel", "spawn"):
        if len(args) < 2:
            print("Uso: agy-switch paralelo <cuenta> [-- <comando>...]")
            sys.exit(1)
        nombre = args[1]
        extra_cmd = []
        if "--" in args:
            dash_idx = args.index("--")
            extra_cmd = args[dash_idx + 1:]
        elif len(args) > 2:
            extra_cmd = args[2:]
        cmd_paralelo(nombre, extra_cmd)
    elif args[0] in ("ayuda", "help", "--help", "-h"):
        print("Uso: agy-switch [comando] [argumentos]")
        print("\nComandos disponibles:")
        print("  tray              Inicia el widget de bajo consumo en la barra de tareas / bandeja (alias: barra)")
        print("  widget            Abre el widget gráfico flotante de escritorio (alias: gui, ui)")
        print("  status [nombre]   Consulta en vivo tokens, cuotas y límites restantes (alias: tokens, cuota)")
        print("  listar            Lista rápida de cuentas en disco sin consultar red (offline)")
        print("  agregar <nombre>  Agrega una cuenta en entorno aislado sin tocar la sesión activa (alias: add)")
        print("                    (admite: --desde <archivo_o_json>, --force)")
        print("  guardar <nombre>  Guarda las credenciales activas bajo un alias (evita duplicados)")
        print("  eliminar <nombre> Elimina un perfil guardado en disco (alias: borrar, quitar, rm)")
        print("  renombrar <a1> <a2> Renombra un perfil guardado a un nuevo alias (alias: mv)")
        print("  usar <nombre>     Cambia a la cuenta indicada inmediatamente")
        print("  nueva <nombre>    Inicia sesión interactiva para registrar una nueva cuenta")
        print("  continuar         Reanuda la última conversación registrada")
        print("  id                Muestra el identificador de la última conversación")
        print("  version           Muestra la versión instalada y comandos de actualización (alias: -v, --version)")
        print("  actualizar        Actualiza CLI Account Switch a la última versión desde GitHub (alias: update)")
    else:
        print(f"Comando desconocido: {args[0]}")
        print("Uso: agy-switch [tray | widget | status [nombre] | tokens | listar | agregar <nombre> | guardar <nombre> | eliminar <nombre> | renombrar <a1> <a2> | usar <nombre> | nueva <nombre> | continuar | version | actualizar | id]")
        sys.exit(1)

if __name__ == "__main__":
    main()
