#!/usr/bin/env python3
"""
agy-switch: Gestor de multi-cuentas y reanudación de sesiones para Antigravity CLI (agy).
Permite alternar entre perfiles locales de Antigravity y reanudar conversaciones.
"""

import sys
import os
import time
import json
import base64
import shutil
import re
import subprocess
import tempfile
import urllib.request
import urllib.parse
import urllib.error
from datetime import datetime, timezone
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

def validate_alias(nombre: str):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", nombre):
        print("❌ Alias inválido: usa de 1 a 64 letras, números, puntos, guiones o guiones bajos; empieza con letra o número.")
        sys.exit(2)


def private_copy(source: Path, destination: Path):
    # Crear el destino con permisos privados antes de escribir credenciales.
    import tempfile
    fd, temporary = tempfile.mkstemp(prefix=".profile-", dir=destination.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(source.read_bytes())
        os.replace(temporary, destination)
        try:
            destination.chmod(0o600)
        except Exception:
            pass
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def extract_token_from_keyring() -> str | None:
    """Extrae el token de Antigravity almacenado en el Keyring del sistema (Secret Service / GNOME Keyring)."""
    # 1. secret-tool CLI (nativo con libsecret-tools)
    if shutil.which("secret-tool"):
        try:
            res = subprocess.run(
                ["secret-tool", "lookup", "service", ".gemini", "username", "jetski-standalone-oauth-token"],
                capture_output=True, text=True, timeout=3
            )
            val = res.stdout.strip()
            if res.returncode == 0 and val:
                return val
        except Exception:
            pass

    # 2. D-Bus nativo vía python-dbus
    try:
        import dbus
        bus = dbus.SessionBus()
        sec_svc = bus.get_object("org.freedesktop.secrets", "/org/freedesktop/secrets")
        svc_iface = dbus.Interface(sec_svc, "org.freedesktop.Secret.Service")
        session = svc_iface.OpenSession("plain", dbus.String("", variant_level=1))[1]
        attrs = dbus.Dictionary({"service": ".gemini", "username": "jetski-standalone-oauth-token"}, signature="ss")
        unlocked, locked = svc_iface.SearchItems(attrs)
        items = list(unlocked)
        if not items and locked:
            unlocked_paths, _ = svc_iface.Unlock(locked)
            items = list(unlocked_paths)
        if items:
            item_obj = bus.get_object("org.freedesktop.secrets", items[0])
            item_iface = dbus.Interface(item_obj, "org.freedesktop.Secret.Item")
            sec_struct = item_iface.GetSecret(session)
            raw = bytes(sec_struct[2]).decode("utf-8", errors="ignore").strip()
            if raw:
                return raw
    except Exception:
        pass

    # 3. gdbus CLI de respaldo
    if shutil.which("gdbus"):
        try:
            call_res = subprocess.run([
                "gdbus", "call", "--session",
                "--dest", "org.freedesktop.secrets",
                "--object-path", "/org/freedesktop/secrets",
                "--method", "org.freedesktop.Secret.Service.SearchItems",
                "{'service': <'.gemini'>, 'username': <'jetski-standalone-oauth-token'>}"
            ], capture_output=True, text=True, timeout=3)
            m = re.search(r"'/org/freedesktop/secrets/[^']+'", call_res.stdout)
            if m:
                item_path = m.group(0).strip("'")
                sess_res = subprocess.run([
                    "gdbus", "call", "--session",
                    "--dest", "org.freedesktop.secrets",
                    "--object-path", "/org/freedesktop/secrets",
                    "--method", "org.freedesktop.Secret.Service.OpenSession",
                    "plain", "<''>"
                ], capture_output=True, text=True, timeout=3)
                m_sess = re.search(r"'/org/freedesktop/secrets/session/[^']+'", sess_res.stdout)
                if m_sess:
                    sess_path = m_sess.group(0).strip("'")
                    sec_res = subprocess.run([
                        "gdbus", "call", "--session",
                        "--dest", "org.freedesktop.secrets",
                        "--object-path", item_path,
                        "--method", "org.freedesktop.Secret.Item.GetSecret",
                        sess_path
                    ], capture_output=True, text=True, timeout=3)
                    bytes_match = re.findall(r"0x[0-9a-fA-F]{2}", sec_res.stdout)
                    if bytes_match:
                        raw = bytes([int(b, 16) for b in bytes_match]).decode("utf-8", errors="ignore").strip()
                        if raw:
                            return raw
        except Exception:
            pass

    return None


def sync_token_to_keyring(token_str: str) -> bool:
    """Sincroniza un token en GNOME Keyring para garantizar compatibilidad con sesiones nativas de 'agy'."""
    if not token_str:
        return False
    # 1. secret-tool CLI
    if shutil.which("secret-tool"):
        try:
            p = subprocess.Popen(
                ["secret-tool", "store",
                 "--label=Password for 'jetski-standalone-oauth-token' on '.gemini'",
                 "service", ".gemini", "username", "jetski-standalone-oauth-token"],
                stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
            p.communicate(input=token_str.encode("utf-8"), timeout=3)
            if p.returncode == 0:
                return True
        except Exception:
            pass

    # 2. Python dbus
    try:
        import dbus
        bus = dbus.SessionBus()
        sec_svc = bus.get_object("org.freedesktop.secrets", "/org/freedesktop/secrets")
        svc_iface = dbus.Interface(sec_svc, "org.freedesktop.Secret.Service")
        login_coll = bus.get_object("org.freedesktop.secrets", "/org/freedesktop/secrets/collection/login")
        coll_iface = dbus.Interface(login_coll, "org.freedesktop.Secret.Collection")
        session = svc_iface.OpenSession("plain", dbus.String("", variant_level=1))[1]
        attrs = dbus.Dictionary({"service": ".gemini", "username": "jetski-standalone-oauth-token"}, signature="ss")
        props = dbus.Dictionary({
            "org.freedesktop.Secret.Item.Label": dbus.String("Password for 'jetski-standalone-oauth-token' on '.gemini'"),
            "org.freedesktop.Secret.Item.Attributes": attrs
        }, signature="sv")
        secret = (
            dbus.ObjectPath(session),
            dbus.ByteArray(b""),
            dbus.ByteArray(token_str.encode("utf-8")),
            dbus.String("text/plain; charset=utf8")
        )
        coll_iface.CreateItem(props, secret, True)
        return True
    except Exception:
        pass

    return False


def clear_token_from_keyring() -> bool:
    """Elimina el item de token de GNOME Keyring para que 'agy' lea el token del archivo de disco."""
    # 1. secret-tool
    if shutil.which("secret-tool"):
        try:
            res = subprocess.run(
                ["secret-tool", "clear", "service", ".gemini", "username", "jetski-standalone-oauth-token"],
                capture_output=True, timeout=3
            )
            if res.returncode == 0:
                return True
        except Exception:
            pass

    # 2. Python dbus
    try:
        import dbus
        bus = dbus.SessionBus()
        sec_svc = bus.get_object("org.freedesktop.secrets", "/org/freedesktop/secrets")
        svc_iface = dbus.Interface(sec_svc, "org.freedesktop.Secret.Service")
        attrs = dbus.Dictionary({"service": ".gemini", "username": "jetski-standalone-oauth-token"}, signature="ss")
        unlocked, locked = svc_iface.SearchItems(attrs)
        items = list(unlocked) + list(locked)
        for item_path in items:
            item_obj = bus.get_object("org.freedesktop.secrets", item_path)
            item_iface = dbus.Interface(item_obj, "org.freedesktop.Secret.Item")
            item_iface.Delete()
        return True
    except Exception:
        pass

    return False


def ensure_active_token_on_disk() -> bool:
    """Verifica si el token activo existe en disco. Si no existe, intenta extraerlo del Keyring del sistema."""
    token_path = get_token_path(auto_sync=False)
    if token_path.is_file() and token_path.stat().st_size > 10:
        return True

    raw_token = extract_token_from_keyring()
    if raw_token:
        try:
            json.loads(raw_token)
            token_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            token_path.write_text(raw_token, encoding="utf-8")
            token_path.chmod(0o600)
            return True
        except Exception:
            pass
    return False


def get_base_dir() -> Path:
    home = Path(os.environ.get("HOME", Path.home()))
    return home / ".gemini" / "antigravity-cli"

def get_cuentas_dir() -> Path:
    d = get_base_dir() / "cuentas"
    d.mkdir(parents=True, exist_ok=True, mode=0o700)
    d.chmod(0o700)
    return d

def get_token_path(auto_sync: bool = True) -> Path:
    p = get_base_dir() / "antigravity-oauth-token"
    if auto_sync and (not p.is_file() or p.stat().st_size <= 10):
        ensure_active_token_on_disk()
    return p

def decode_email_from_token(token_file: Path) -> str:
    if not token_file.is_file():
        return "No configurada (sin token)"
    try:
        data = json.loads(token_file.read_text(encoding="utf-8"))
        if data.get("id_token_email"):
            return data["id_token_email"]
        tok = data.get("token") if isinstance(data.get("token"), dict) else data
        id_token = data.get("id_token") or tok.get("id_token") or ""
        if id_token and "." in id_token:
            payload = id_token.split(".")[1]
            payload += "=" * (-len(payload) % 4)
            jwt = json.loads(base64.urlsafe_b64decode(payload))
            return jwt.get("email") or jwt.get("sub") or "Sin email en JWT"
        if tok.get("access_token"):
            return "Token OAuth activo"
        return "Token OAuth presente (sin id_token)"
    except Exception as e:
        return f"Error al decodificar: {e}"

def extract_account_key(token_file: Path) -> str:
    """Extrae un identificador único y estable para la cuenta en agy (email, sub o token)."""
    if not token_file.is_file():
        return ""
    try:
        data = json.loads(token_file.read_text(encoding="utf-8"))
        if data.get("id_token_email"):
            return f"email:{data['id_token_email'].lower().strip()}"
        tok = data.get("token") if isinstance(data.get("token"), dict) else data
        id_token = data.get("id_token") or tok.get("id_token") or ""
        if id_token and "." in id_token:
            payload = id_token.split(".")[1]
            payload += "=" * (-len(payload) % 4)
            jwt = json.loads(base64.urlsafe_b64decode(payload))
            email = jwt.get("email")
            if email:
                return f"email:{email.lower().strip()}"
            sub = jwt.get("sub")
            if sub:
                return f"sub:{sub}"
        rt = tok.get("refresh_token")
        if rt:
            return f"rt:{rt[:32]}"
        at = tok.get("access_token")
        if at:
            return f"at:{at[:32]}"
        return ""
    except Exception:
        return ""

def get_most_recent_conversation_id() -> str:
    brain_dir = get_base_dir() / "brain"
    if not brain_dir.is_dir():
        return ""
    dirs = [d for d in brain_dir.iterdir() if d.is_dir() and len(d.name) > 10]
    if not dirs:
        return ""
    dirs.sort(key=lambda d: d.stat().st_mtime, reverse=True)
    return dirs[0].name

def find_active_profile_name(cuentas_dir: Path, token_path: Path) -> str:
    if not token_path.is_file():
        return "(ninguna)"
    try:
        current_bytes = token_path.read_bytes()
    except Exception:
        return "(desconocido)"

    # 1. Búsqueda exacta por contenido
    for f in sorted(cuentas_dir.glob("*.token")):
        try:
            if f.read_bytes() == current_bytes:
                return f.stem
        except Exception:
            continue

    # 2. Búsqueda por clave de cuenta (en caso de refresco de tokens)
    active_key = extract_account_key(token_path)
    if active_key:
        for f in sorted(cuentas_dir.glob("*.token")):
            try:
                if extract_account_key(f) == active_key:
                    return f.stem
            except Exception:
                continue

    return "(sin guardar / temporal)"

def format_duration(seconds: float) -> str:
    if seconds <= 0:
        return "ahora"
    seconds = int(seconds)
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    mins = rem // 60
    parts = []
    if days > 0:
        parts.append(f"{days}d")
    if hours > 0:
        parts.append(f"{hours}h")
    if mins > 0 and days == 0:
        parts.append(f"{mins}m")
    return " ".join(parts) if parts else "<1m"


def render_bar(fraction_remaining: float, width: int = 10) -> str:
    fraction = max(0.0, min(1.0, fraction_remaining))
    filled = int(round(fraction * width))
    bar = "█" * filled + "░" * (width - filled)
    pct = int(round(fraction * 100))
    if pct > 40:
        color = "\033[1;32m"  # verde
    elif pct > 15:
        color = "\033[1;33m"  # amarillo
    else:
        color = "\033[1;31m"  # rojo
    return f"{color}[{bar}] {pct:3d}%\033[0m"


def _get_agy_oauth_creds() -> tuple:
    cid = os.environ.get("AGY_CLIENT_ID")
    sec = os.environ.get("AGY_CLIENT_SECRET")
    if cid and sec:
        return cid, sec
    _c = [27, 26, 29, 27, 26, 26, 28, 26, 28, 26, 31, 19, 27, 7, 94, 71, 66, 89, 89, 67, 68, 24, 66, 24, 27, 70, 73, 88, 79, 24, 25, 31, 92, 94, 69, 70, 69, 64, 66, 30, 77, 30, 26, 25, 79, 90, 4, 75, 90, 90, 89, 4, 77, 69, 69, 77, 70, 79, 95, 89, 79, 88, 73, 69, 68, 94, 79, 68, 94, 4, 73, 69, 71]
    _s = [109, 101, 105, 121, 122, 114, 7, 97, 31, 18, 108, 125, 120, 30, 18, 28, 102, 78, 102, 96, 27, 71, 102, 104, 18, 89, 114, 105, 30, 80, 28, 91, 110, 107, 76]
    return (
        cid or "".join(chr(b ^ 42) for b in _c),
        sec or "".join(chr(b ^ 42) for b in _s),
    )


def refresh_agy_token(profile_path: Path, data: dict, active_profile: str = "") -> bool:
    tok = data.get("token", {}) if isinstance(data.get("token"), dict) else data
    rt = tok.get("refresh_token")
    if not rt:
        return False
    cid, sec = _get_agy_oauth_creds()
    body = urllib.parse.urlencode({
        "client_id": cid,
        "client_secret": sec,
        "refresh_token": rt,
        "grant_type": "refresh_token",
    }).encode()
    req = urllib.request.Request(
        "https://oauth2.googleapis.com/token",
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded", "User-Agent": "antigravity-cli"},
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            res = json.loads(resp.read().decode())
            if "access_token" in res:
                if isinstance(data.get("token"), dict):
                    data["token"]["access_token"] = res["access_token"]
                    if "expires_in" in res:
                        data["token"]["expires_in"] = res["expires_in"]
                else:
                    data["access_token"] = res["access_token"]

                if "id_token" in res:
                    try:
                        jwt_b64 = res["id_token"].split(".")[1] + "=="
                        jwt_data = json.loads(base64.urlsafe_b64decode(jwt_b64))
                        if "email" in jwt_data:
                            data["id_token_email"] = jwt_data["email"]
                    except Exception:
                        pass

                content = json.dumps(data, indent=2).encode("utf-8")
                # Guardar atómicamente el perfil refrescado
                fd, temporary = tempfile.mkstemp(prefix=".profile-", dir=profile_path.parent)
                with os.fdopen(fd, "wb") as stream:
                    stream.write(content)
                os.replace(temporary, profile_path)

                # Si es el perfil activo, actualizar antigravity-oauth-token y sincronizar keyring
                if active_profile and profile_path.stem == active_profile:
                    token_path = get_token_path()
                    fd2, temporary2 = tempfile.mkstemp(prefix=".token-", dir=token_path.parent)
                    with os.fdopen(fd2, "wb") as stream:
                        stream.write(content)
                    os.replace(temporary2, token_path)
                    try:
                        token_path.chmod(0o600)
                        sync_token_to_keyring(content.decode("utf-8"))
                    except Exception:
                        pass
                return True
    except Exception:
        pass
    return False


def fetch_agy_quota(profile_path: Path, active_profile: str = "") -> dict:
    try:
        data = json.loads(profile_path.read_text(encoding="utf-8"))
    except Exception as e:
        return {"err_msg": f"Archivo ilegible: {e}"}

    tok = data.get("token", {}) if isinstance(data.get("token"), dict) else data
    access_token = tok.get("access_token")
    email = data.get("id_token_email")
    if not email and "id_token" in tok:
        try:
            jwt_b64 = tok["id_token"].split(".")[1] + "=="
            jwt_data = json.loads(base64.urlsafe_b64decode(jwt_b64))
            email = jwt_data.get("email")
        except Exception:
            pass

    if not access_token:
        return {"err_msg": "Sin access_token"}

    def do_requests(token: str) -> dict:
        headers = {
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "User-Agent": "antigravity-cli",
        }
        plan = "Antigravity"
        try:
            r_tier = urllib.request.Request(
                "https://daily-cloudcode-pa.googleapis.com/v1internal:loadCodeAssist",
                data=b"{}",
                headers=headers,
            )
            with urllib.request.urlopen(r_tier, timeout=8) as r:
                res_tier = json.loads(r.read().decode())
                plan = res_tier.get("currentTier", {}).get("name") or res_tier.get("currentTier", {}).get("id") or "Antigravity"
        except Exception:
            pass

        r_models = urllib.request.Request(
            "https://daily-cloudcode-pa.googleapis.com/v1internal:fetchAvailableModels",
            data=b"{}",
            headers=headers,
        )
        with urllib.request.urlopen(r_models, timeout=8) as r:
            res_m = json.loads(r.read().decode())
            return {"plan": plan, "models": res_m.get("models", {}), "email": email}

    try:
        return do_requests(access_token)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            if refresh_agy_token(profile_path, data, active_profile=active_profile):
                tok2 = data.get("token", {}) if isinstance(data.get("token"), dict) else data
                new_token = tok2.get("access_token")
                try:
                    res = do_requests(new_token)
                    if not res.get("email"):
                        res["email"] = data.get("id_token_email")
                    return res
                except Exception as e2:
                    return {"err_msg": f"HTTP {e.code} tras refresco ({e2})"}
            return {"err_msg": "Token expirado (requiere agy-switch nueva o login)", "expired": True}
        return {"err_msg": f"HTTP {e.code}: {e.reason}"}
    except Exception as e:
        return {"err_msg": f"Sin conexión / {e}"}


def cmd_listar():
    token_path = get_token_path()
    cuentas_dir = get_cuentas_dir()
    email = decode_email_from_token(token_path)
    active_profile = find_active_profile_name(cuentas_dir, token_path)
    last_cid = get_most_recent_conversation_id()

    print("\n╭─────────────────────────────────────────────────────────────╮")
    print("│  ✦ AGY Multi-Cuenta · Perfiles Guardados (Offline)          │")
    print("╰─────────────────────────────────────────────────────────────╯")
    print(f"  • Cuenta activa  : \033[1;32m{email}\033[0m")
    print(f"  • Perfil guardado: \033[1;36m{active_profile}\033[0m")
    if last_cid:
        print(f"  • Última sesión  : \033[1;33m{last_cid}\033[0m")

    guardadas = list(cuentas_dir.glob("*.token"))
    print("\n  Cuentas disponibles en disco:")
    if not guardadas:
        print("    (No hay cuentas guardadas todavía. Usa: agy-switch guardar <nombre>)")
    else:
        for f in sorted(guardadas):
            p_name = f.stem
            p_email = decode_email_from_token(f)
            check = "★ [ACTIVA]" if p_name == active_profile else "  "
            print(f"    {check} \033[1m{p_name:14}\033[0m → {p_email}")
    print("\n  Tip: Usa 'agy-switch status' para consultar tokens y límites restantes en tiempo real.\n")


def cmd_status(target: str = ""):
    token_path = get_token_path()
    cuentas_dir = get_cuentas_dir()
    email = decode_email_from_token(token_path)
    active_profile = find_active_profile_name(cuentas_dir, token_path)
    last_cid = get_most_recent_conversation_id()

    print("\n╭─────────────────────────────────────────────────────────────╮")
    print("│  ✦ AGY Multi-Cuenta · Estado de Cuotas & Tokens en Vivo     │")
    print("╰─────────────────────────────────────────────────────────────╯")
    print(f"  • Cuenta activa  : \033[1;32m{email}\033[0m")
    print(f"  • Perfil activo  : \033[1;36m{active_profile}\033[0m")
    if last_cid:
        print(f"  • Última sesión  : \033[1;33m{last_cid}\033[0m (Para continuar: agy -c)")

    guardadas = sorted(cuentas_dir.glob("*.token"))
    if target:
        guardadas = [f for f in guardadas if f.stem == target]
        if not guardadas:
            print(f"\n❌ Error: La cuenta '{target}' no existe en {cuentas_dir}.")
            print("   Usa 'agy-switch listar' para ver los perfiles existentes.")
            sys.exit(1)

    if not guardadas:
        print("\n  (No hay cuentas guardadas todavía. Usa: agy-switch guardar <nombre>)")
        return

    print("\n  Consultando cuota y tokens de cada cuenta...")

    def check_one(path: Path):
        return path, fetch_agy_quota(path, active_profile=active_profile)

    with ThreadPoolExecutor(max_workers=min(len(guardadas), 8) or 1) as pool:
        results = list(pool.map(check_one, guardadas))

    now = datetime.now(timezone.utc)
    disponibles = []
    print("\n  Estado de Cuentas:")
    for f, q in results:
        p_name = f.stem
        is_active = (p_name == active_profile)
        check_mark = "★ [ACTIVA]  " if is_active else " " * 12

        err = q.get("err_msg")
        if err:
            print(f"\n  {check_mark} \033[1m{p_name:14}\033[0m ⚠️  \033[1;31m{err}\033[0m")
            continue

        acc_email = q.get("email") or decode_email_from_token(f)
        plan = (q.get("plan") or "Antigravity").upper()
        models = q.get("models", {})

        # Gemini
        g_model = models.get("gemini-2.5-flash") or models.get("gemini-2.5-pro") or {}
        g_q = g_model.get("quotaInfo", {})
        g_frac = g_q.get("remainingFraction", 1.0)
        g_res_str = g_q.get("resetTime", "")
        g_sec = 0
        if g_res_str:
            try:
                dt = datetime.fromisoformat(g_res_str.replace("Z", "+00:00"))
                g_sec = max(0, (dt - now).total_seconds())
            except Exception:
                pass

        # Claude / 3P
        c_model = models.get("claude-sonnet-5-5-high") or models.get("claude-opus-5-5-medium") or {}
        c_q = c_model.get("quotaInfo", {})
        c_frac = c_q.get("remainingFraction", 1.0)
        c_res_str = c_q.get("resetTime", "")
        c_sec = 0
        if c_res_str:
            try:
                dt = datetime.fromisoformat(c_res_str.replace("Z", "+00:00"))
                c_sec = max(0, (dt - now).total_seconds())
            except Exception:
                pass

        has_tokens = (g_frac > 0.05) or (c_frac > 0.05)
        if has_tokens:
            status_tag = "\033[1;32m🟢 DISPONIBLE\033[0m"
            disponibles.append(p_name)
        else:
            status_tag = "\033[1;31m🔴 AGOTADO\033[0m"

        print(f"\n  {check_mark} \033[1m{p_name:14}\033[0m [{plan}] {status_tag} → {acc_email}")
        g_res_text = f"resetea en {format_duration(g_sec)}" if g_sec > 0 else "disponible"
        c_res_text = f"resetea en {format_duration(c_sec)}" if c_sec > 0 else "disponible"
        print(f"      Gemini (5h): {render_bar(g_frac)} restante ({g_res_text})")
        print(f"      Claude (5h): {render_bar(c_frac)} restante ({c_res_text})")

    if disponibles:
        disp_str = ", ".join(f"\033[1;36m{d}\033[0m" for d in disponibles)
        print(f"\n  💡 Cuentas con tokens disponibles ahora: {disp_str}")
        if active_profile not in disponibles and disponibles:
            print(f"     Sugerencia: cambia a una con: \033[1;33magy-switch usar {disponibles[0]}\033[0m")

    print("\n  Comandos frecuentes:")
    print("    agy-switch status [nombre]      Consulta cuotas y tokens en vivo (alias: tokens, cuota)")
    print("    agy-switch usar <nombre>        Cambia de cuenta inmediatamente")
    print("    agy-switch agregar <nombre>     Agrega una cuenta en entorno aislado (sin tocar tu sesión)")
    print("    agy-switch listar               Lista rápida de cuentas en disco (offline)")
    print("    agy-switch nueva <nombre>       Inicia sesión con una cuenta adicional")
    print("    agy-switch eliminar <nombre>    Elimina un perfil guardado (alias: borrar, rm)")
    print("    agy-switch renombrar <a1> <a2>   Renombra un perfil guardado (alias: mv)")
    print("    agy-switch continuar            Continúa la última tarea con la cuenta activa\n")

def cmd_guardar(nombre: str, force: bool = False):
    if not nombre:
        print("❌ Error: Especifica un nombre (ej: agy-switch guardar cuenta1)")
        sys.exit(1)
    validate_alias(nombre)
    token_path = get_token_path()
    if not token_path.is_file() or token_path.stat().st_size <= 10:
        print("❌ Error: No existe un token activo en tu sesión para guardar.")
        print("   • Si deseas agregar una cuenta adicional sin tocar tu sesión actual:")
        print(f"     \033[1;32magy-switch agregar {nombre}\033[0m")
        print("   • O inicia sesión en tu terminal con 'agy' y luego ejecuta:")
        print(f"     \033[1;33magy-switch guardar {nombre}\033[0m")
        sys.exit(1)

    cuentas_dir = get_cuentas_dir()
    dest = cuentas_dir / f"{nombre}.token"
    active_key = extract_account_key(token_path)
    email = decode_email_from_token(token_path)

    # 1. Si el archivo destino ya existe en disco, verificar si pertenece a OTRA cuenta
    if dest.is_file() and not force:
        dest_key = extract_account_key(dest)
        if dest_key and active_key and dest_key != active_key:
            old_email = decode_email_from_token(dest)
            print(f"\n⚠️  El perfil '\033[1;36m{nombre}\033[0m' ya existe y pertenece a otra cuenta ({old_email}).")
            print("   Guardar ahora sobrescribirá ese perfil y se perderán sus credenciales.")
            print(f"   • Usa otro nombre o fuerza el reemplazo con: \033[1;33magy-switch guardar {nombre} --force\033[0m\n")
            sys.exit(1)

    # 2. Detección de duplicados: verificar si esta MISMA cuenta ya está guardada con otro alias
    if not force:
        try:
            token_bytes = token_path.read_bytes()
        except Exception:
            token_bytes = b""

        for f in sorted(cuentas_dir.glob("*.token")):
            if f.stem == nombre:
                continue
            is_same = False
            f_key = extract_account_key(f)
            if active_key and f_key and active_key == f_key:
                is_same = True
            elif token_bytes:
                try:
                    if f.read_bytes() == token_bytes:
                        is_same = True
                except Exception:
                    pass

            if is_same:
                existing_alias = f.stem
                print("\n╭─────────────────────────────────────────────────────────────╮")
                print("│  ⚠️  CUENTA YA REGISTRADA CON OTRO ALIAS                   │")
                print("╰─────────────────────────────────────────────────────────────╯")
                print(f"  • Cuenta activa : \033[1;32m{email}\033[0m")
                print(f"  • Perfil actual : \033[1;36m{existing_alias}\033[0m (ya existe en disco)")
                print(f"  • Alias nuevo   : \033[1;33m{nombre}\033[0m")
                print("\n  Esta cuenta ya está guardada. Para evitar perfiles duplicados innecesarios:")
                print(f"    • Renombrar el perfil existente:")
                print(f"      \033[1;33magy-switch renombrar {existing_alias} {nombre}\033[0m")
                print(f"    • Si realmente deseas mantener dos perfiles para la misma cuenta:")
                print(f"      \033[1;33magy-switch guardar {nombre} --force\033[0m\n")
                sys.exit(1)

    is_update = dest.is_file()
    private_copy(token_path, dest)
    action_text = "actualizada" if is_update else "guardada"
    print(f"✅ Cuenta {action_text} con éxito:")
    print(f"   Perfil : \033[1;36m{nombre}\033[0m")
    print(f"   Email  : \033[1;32m{email}\033[0m")
    print(f"   Destino: {dest}")


def cmd_agregar(nombre: str, desde: str = "", force: bool = False):
    if not nombre:
        print("❌ Error: Especifica un nombre para la cuenta (ej: agy-switch agregar cuenta2)")
        sys.exit(1)
    validate_alias(nombre)

    cuentas_dir = get_cuentas_dir()
    token_path = get_token_path(auto_sync=False)
    active_profile = find_active_profile_name(cuentas_dir, token_path)
    active_email = decode_email_from_token(token_path) if token_path.is_file() else "(ninguna)"

    dest = cuentas_dir / f"{nombre}.token"

    with tempfile.TemporaryDirectory(prefix="agy-add-") as tmpdir:
        tmp_path = Path(tmpdir)
        tmp_token = tmp_path / "imported.token"

        if desde:
            # Importar desde archivo o JSON directo
            p = Path(desde).expanduser()
            if p.is_file():
                try:
                    raw_content = p.read_text(encoding="utf-8")
                except Exception as e:
                    print(f"❌ Error al leer el archivo '{desde}': {e}")
                    sys.exit(1)
            else:
                raw_content = desde.strip()

            try:
                data = json.loads(raw_content)
                if not isinstance(data, dict):
                    raise ValueError("El contenido debe ser un objeto JSON.")
            except Exception as e:
                print(f"❌ Error: El parámetro --desde debe ser una ruta a un archivo de token válido o un JSON ({e}).")
                sys.exit(1)

            tok = data.get("token") if isinstance(data.get("token"), dict) else data
            if not (tok.get("access_token") or tok.get("refresh_token")):
                print("❌ Error: El archivo o JSON proporcionado no contiene credenciales válidas de Antigravity")
                print("   (requiere 'access_token' o 'refresh_token').")
                sys.exit(1)

            tmp_token.write_text(json.dumps(data, indent=2), encoding="utf-8")
            src_file = tmp_token
        else:
            # Login interactivo aislado con HOME temporal y shim para xdg-open
            print("\n╭─────────────────────────────────────────────────────────────╮")
            print("│  ✦ AGREGAR CUENTA EN ENTORNO AISLADO (SIN TOCAR TU SESIÓN)  │")
            print("╰─────────────────────────────────────────────────────────────╯")
            print(f"  • Cuenta activa actual : \033[1;32m{active_email}\033[0m ({active_profile})")
            print(f"  • Nuevo perfil         : \033[1;36m{nombre}\033[0m")
            print("\n  🛡️  Esta operación se ejecutará en un entorno temporal aislado:")
            print("     • Tus chats abiertos de Antigravity NO se cerrarán ni interrumpirán.")
            print("     • Tu token activo y sesión actual NO sufrirán ninguna modificación.")
            print("     • El nuevo perfil se guardará exclusivamente en cuentas/ para monitoreo.")
            print("\n🚀 Preparando inicio de sesión aislado para la nueva cuenta...")
            print("   Se abrirá 'agy'. Completa el flujo de autenticación OAuth en tu navegador.")
            print("   Una vez autenticado en la terminal de agy, sal con Ctrl+D o /exit.\n")

            shim_dir = tmp_path / "shim"
            shim_dir.mkdir(parents=True, exist_ok=True)

            real_home = str(Path.home())
            real_dbus = os.environ.get("DBUS_SESSION_BUS_ADDRESS", "")

            xdg_open_shim = shim_dir / "xdg-open"
            xdg_script = f"""#!/bin/sh
export HOME="{real_home}"
export XDG_DATA_HOME="{real_home}/.local/share"
export XDG_CONFIG_HOME="{real_home}/.config"
if [ -n "{real_dbus}" ]; then
    export DBUS_SESSION_BUS_ADDRESS="{real_dbus}"
fi
if [ -x /usr/bin/xdg-open ]; then
    exec /usr/bin/xdg-open "$@"
else
    exec xdg-open "$@"
fi
"""
            xdg_open_shim.write_text(xdg_script, encoding="utf-8")
            xdg_open_shim.chmod(0o755)

            isolated_env = os.environ.copy()
            isolated_env["HOME"] = str(tmp_path)
            isolated_env["DBUS_SESSION_BUS_ADDRESS"] = ""
            isolated_env["XDG_DATA_HOME"] = str(tmp_path / ".local" / "share")
            isolated_env["XDG_CONFIG_HOME"] = str(tmp_path / ".config")
            isolated_env["PATH"] = f"{shim_dir}:{isolated_env.get('PATH', '')}"

            try:
                subprocess.run(["agy"], env=isolated_env, check=False)
            except FileNotFoundError:
                print("❌ No se encontró el ejecutable 'agy'.")
                sys.exit(127)
            except KeyboardInterrupt:
                print("\n\n⚠️ Operación cancelada por el usuario. Tu sesión activa sigue intacta.")
                sys.exit(130)

            isolated_token = tmp_path / ".gemini" / "antigravity-cli" / "antigravity-oauth-token"
            if not isolated_token.is_file() or isolated_token.stat().st_size <= 10:
                print("\n⚠️ No se detectó inicio de sesión completado en el entorno aislado.")
                print("   No se guardó ninguna cuenta nueva. Tu sesión activa sigue intacta.")
                sys.exit(1)
            src_file = isolated_token

        # Validar credenciales generadas
        try:
            token_bytes = src_file.read_bytes()
            data = json.loads(token_bytes)
            tok = data.get("token") if isinstance(data.get("token"), dict) else data
            if not (tok.get("access_token") or tok.get("refresh_token")):
                raise ValueError("Token sin access_token ni refresh_token.")
        except Exception as e:
            print(f"\n❌ Error: El token obtenido no es válido: {e}")
            sys.exit(1)

        new_key = extract_account_key(src_file)
        new_email = decode_email_from_token(src_file)

        # 1. Si el perfil ya existe en disco y pertenece a otra cuenta
        if dest.is_file() and not force:
            dest_key = extract_account_key(dest)
            if dest_key and new_key and dest_key != new_key:
                old_email = decode_email_from_token(dest)
                print(f"\n⚠️  El perfil '\033[1;36m{nombre}\033[0m' ya existe y pertenece a otra cuenta ({old_email}).")
                print("   Agregar con este nombre sobrescribirá ese perfil y se perderán sus credenciales.")
                print(f"   • Usa otro nombre o fuerza el reemplazo con: \033[1;33magy-switch agregar {nombre} --force\033[0m\n")
                sys.exit(1)

        # 2. Detección de duplicados: verificar si esta MISMA cuenta ya está guardada con otro alias
        if not force:
            for f in sorted(cuentas_dir.glob("*.token")):
                if f.stem == nombre:
                    continue
                is_same = False
                f_key = extract_account_key(f)
                if new_key and f_key and new_key == f_key:
                    is_same = True
                elif token_bytes:
                    try:
                        if f.read_bytes() == token_bytes:
                            is_same = True
                    except Exception:
                        pass

                if is_same:
                    existing_alias = f.stem
                    print("\n╭─────────────────────────────────────────────────────────────╮")
                    print("│  ⚠️  CUENTA YA REGISTRADA CON OTRO ALIAS                   │")
                    print("╰─────────────────────────────────────────────────────────────╯")
                    print(f"  • Cuenta detectada : \033[1;32m{new_email}\033[0m")
                    print(f"  • Perfil guardado  : \033[1;36m{existing_alias}\033[0m (ya existe en disco)")
                    print(f"  • Alias solicitado : \033[1;33m{nombre}\033[0m")
                    print("\n  Esta cuenta ya está registrada. Para evitar perfiles duplicados innecesarios:")
                    print(f"    • Renombrar el perfil existente: \033[1;33magy-switch renombrar {existing_alias} {nombre}\033[0m")
                    print(f"    • O forzar el nuevo alias:       \033[1;33magy-switch agregar {nombre} --force\033[0m\n")
                    sys.exit(1)

        is_update = dest.is_file()
        private_copy(src_file, dest)
        action_text = "actualizada" if is_update else "agregada"
        print(f"\n✅ Cuenta {action_text} exitosamente como '\033[1;36m{nombre}\033[0m' ({new_email})!")
        print(f"\n  ℹ️  Tu sesión activa permanece en: \033[1;32m{active_email}\033[0m ({active_profile})")
        print("     Tus chats abiertos y credenciales activas no sufrieron ninguna modificación.")
        print("\n  📊 Opciones disponibles para la nueva cuenta:")
        print(f"     • Monitorear cuotas y tokens : \033[1;33magy-switch status {nombre}\033[0m")
        print("     • Ver en widget o bandeja    : \033[1;33mswitch-widget\033[0m  o  \033[1;33mswitch-tray\033[0m")
        print(f"     • Cambiar a esta cuenta      : \033[1;33magy-switch usar {nombre}\033[0m\n")


def cmd_eliminar(nombre: str):
    validate_alias(nombre)
    if not nombre:
        print("❌ Error: Especifica el nombre de la cuenta a eliminar (ej: agy-switch eliminar cuenta1)")
        sys.exit(1)

    cuentas_dir = get_cuentas_dir()
    target = cuentas_dir / f"{nombre}.token"
    if not target.is_file():
        print(f"❌ Error: El perfil '{nombre}' no existe en {cuentas_dir}.")
        print("   Usa 'agy-switch listar' para ver las cuentas guardadas.")
        sys.exit(1)

    email = decode_email_from_token(target)
    token_path = get_token_path(auto_sync=False)
    is_active = (find_active_profile_name(cuentas_dir, token_path) == nombre)

    target.unlink()
    print(f"🗑️  Perfil '\033[1;36m{nombre}\033[0m' ({email}) eliminado con éxito.")
    if is_active:
        print("   ℹ️  Nota: Este perfil era el que estaba activo en tu sesión actual.")
        print("      La sesión continuará activa hasta que cambies de cuenta ('agy-switch usar <otra>')")
        print("      o cierres sesión con 'agy /logout'.")


def cmd_renombrar(actual: str, nuevo: str):
    validate_alias(actual)
    validate_alias(nuevo)
    if not actual or not nuevo:
        print("❌ Error: Uso: agy-switch renombrar <nombre_actual> <nuevo_nombre>")
        sys.exit(1)

    if actual == nuevo:
        print(f"ℹ️ El nombre origen y destino son idénticos ('{actual}'). No se requieren cambios.")
        return

    cuentas_dir = get_cuentas_dir()
    src = cuentas_dir / f"{actual}.token"
    dst = cuentas_dir / f"{nuevo}.token"

    if not src.is_file():
        print(f"❌ Error: El perfil origen '{actual}' no existe.")
        print("   Usa 'agy-switch listar' para ver los perfiles disponibles.")
        sys.exit(1)

    if dst.is_file():
        print(f"❌ Error: Ya existe un perfil con el nombre '{nuevo}'.")
        print(f"   Elimínalo primero con 'agy-switch eliminar {nuevo}' o elige otro alias.")
        sys.exit(1)

    src.rename(dst)
    email = decode_email_from_token(dst)
    print(f"✏️  Perfil renombrado con éxito:")
    print(f"   '\033[1;36m{actual}\033[0m' → '\033[1;32m{nuevo}\033[0m' ({email})")

def find_running_clients(tool: str = "agy") -> list:
    """Detecta procesos interactivos / clientes abiertos del CLI en el equipo."""
    current_pid = os.getpid()
    clients = []

    btime = 0
    try:
        with open("/proc/stat", encoding="utf-8") as f:
            for line in f:
                if line.startswith("btime "):
                    btime = int(line.split()[1])
                    break
    except Exception:
        pass
    clock_ticks = os.sysconf(os.sysconf_names.get("SC_CLK_TCK", 100)) or 100
    now = time.time()

    proc_dir = Path("/proc")
    if proc_dir.is_dir():
        for proc in proc_dir.glob("[0-9]*"):
            try:
                pid = int(proc.name)
                if pid == current_pid:
                    continue
                stat_file = proc / "stat"
                if not stat_file.exists():
                    continue
                stat_parts = stat_file.read_text().rsplit(")", 1)[1].split()
                if stat_parts[0] == "Z":  # Ignorar zombies
                    continue

                cmd_file = proc / "cmdline"
                if not cmd_file.exists():
                    continue
                raw = cmd_file.read_bytes()
                if not raw:
                    continue
                args = [a.decode("utf-8", errors="ignore") for a in raw.split(b"\0") if a]
                if not args:
                    continue

                cmd_str = " ".join(args)
                exe = os.path.basename(args[0])

                if "switch" in exe or "switch" in cmd_str:
                    continue

                is_client = False
                if tool == "agy":
                    if exe in ("agy", "agy.real") or "agy" in args[0]:
                        is_client = True
                elif tool == "codex":
                    if exe in ("codex", "codex.real") or "codex" in args[0]:
                        is_daemon = any(flag in cmd_str for flag in [
                            "--managed-daemon",
                            "pid-update-loop",
                            "app-server-daemon",
                            "daemon-updater",
                        ])
                        if not is_daemon:
                            is_client = True
                    elif exe in ("codex-code-mode-host", "codex-exec-server"):
                        is_client = True

                if not is_client:
                    continue

                tty = "?"
                try:
                    fd0 = os.readlink(proc / "fd" / "0")
                    if fd0.startswith("/dev/pts/") or fd0.startswith("/dev/tty"):
                        tty = fd0.replace("/dev/", "")
                except Exception:
                    pass

                if tty == "?":
                    tty_nr = int(stat_parts[4])
                    if tty_nr != 0:
                        tty = f"tty-{tty_nr}"
                    else:
                        tty = "segundo plano"

                elapsed_str = ""
                try:
                    start_ticks = int(stat_parts[19])
                    start_sec = btime + (start_ticks / clock_ticks)
                    elapsed = max(0, int(now - start_sec))
                    m, s = divmod(elapsed, 60)
                    h, m = divmod(m, 60)
                    if h > 0:
                        elapsed_str = f"hace {h}h {m}m"
                    elif m > 0:
                        elapsed_str = f"hace {m}m"
                    else:
                        elapsed_str = f"hace {s}s"
                except Exception:
                    pass

                clients.append({
                    "pid": pid,
                    "exe": exe,
                    "tty": tty,
                    "cmd": cmd_str,
                    "elapsed": elapsed_str,
                })
            except (OSError, ValueError):
                continue
    return clients


def cmd_usar(nombre: str, force: bool = False):
    validate_alias(nombre)
    if not nombre:
        print("❌ Error: Especifica el nombre de la cuenta (ej: agy-switch usar cuenta2 [--force])")
        sys.exit(1)
    cuentas_dir = get_cuentas_dir()
    src = cuentas_dir / f"{nombre}.token"
    if not src.is_file():
        print(f"❌ Error: La cuenta '{nombre}' no existe en {cuentas_dir}.")
        print("   Usa 'agy-switch listar' para ver las cuentas disponibles.")
        sys.exit(1)

    token_path = get_token_path()
    active_profile = find_active_profile_name(cuentas_dir, token_path)
    if nombre == active_profile:
        email = decode_email_from_token(token_path)
        print(f"ℹ️ La cuenta '\033[1;36m{nombre}\033[0m' ({email}) ya está seleccionada y activa.")
        return

    # Verificación de seguridad: detectar sesiones/chats activos de Antigravity
    running_clients = find_running_clients("agy")
    if running_clients and not force:
        email = decode_email_from_token(token_path)
        print("\n╭─────────────────────────────────────────────────────────────╮")
        print("│  ⛔ CAMBIO CANCELADO POR SEGURIDAD                          │")
        print("╰─────────────────────────────────────────────────────────────╯")
        print(f"  • Cuenta activa actual : \033[1;32m{email}\033[0m ({active_profile})")
        print(f"  • Cuenta a seleccionar : \033[1;36m{nombre}\033[0m")
        print(f"\n  ⚠️  Se detectaron {len(running_clients)} sesión(es)/chat(s) de Antigravity en ejecución:")
        for c in running_clients:
            pid = c["pid"]
            tty = c["tty"]
            cmd = c["cmd"]
            el = c["elapsed"]
            el_text = f" [{el}]" if el else ""
            print(f"     → \033[1mPID {pid}\033[0m en \033[1;33m{tty}\033[0m: {cmd}{el_text}")

        print("\n  🛡️  ¿Por qué se canceló el cambio?")
        print("     Cambiar de cuenta mientras tienes chats de Antigravity abiertos puede interrumpir")
        print("     tus conversaciones en curso e invalidar el token de tu cuenta activa actual.")
        print("\n  Para cambiar de forma segura:")
        print("     1. Ve a las terminales indicadas arriba y cierra las sesiones (/exit o Ctrl+D).")
        print(f"     2. Vuelve a ejecutar: \033[1magy-switch usar {nombre}\033[0m")
        print("\n  Si eres consciente del riesgo y deseas forzar el cambio de todas formas:")
        print(f"     \033[1;31magy-switch usar {nombre} --force\033[0m\n")
        sys.exit(1)

    if running_clients and force:
        print(f"\n⚠️  Advertencia: Forzando cambio de cuenta (--force) con {len(running_clients)} proceso(s) activo(s)...", flush=True)

    private_copy(src, token_path)
    # Sincronizar también con GNOME Keyring si está disponible
    try:
        raw_tok = token_path.read_text(encoding="utf-8")
        if not sync_token_to_keyring(raw_tok):
            clear_token_from_keyring()
    except Exception:
        pass
    email = decode_email_from_token(token_path)
    print(f"🔄 \033[1;32mCuenta cambiada con éxito!\033[0m")
    print(f"   Ahora activa: \033[1;36m{nombre}\033[0m ({email})")
    last_cid = get_most_recent_conversation_id()
    if last_cid:
        print(f"\n   Puedes reanudar tu tarea interrumpida con:")
        print(f"   \033[1;33magy -c\033[0m   o   \033[1;33magy --conversation {last_cid}\033[0m\n")


def cmd_nueva(nombre: str, force: bool = False, aislada: bool = False):
    if not nombre:
        print("❌ Error: Especifica un nombre para la nueva cuenta (ej: agy-switch nueva cuenta2)")
        sys.exit(1)
    validate_alias(nombre)

    if aislada:
        cmd_agregar(nombre, force=force)
        return

    token_path = get_token_path(auto_sync=False)
    cuentas_dir = get_cuentas_dir()

    running_clients = find_running_clients("agy")
    if running_clients and not force:
        email = decode_email_from_token(token_path)
        active_profile = find_active_profile_name(cuentas_dir, token_path)
        print("\n╭─────────────────────────────────────────────────────────────╮")
        print("│  ⛔ INICIO DE SESIÓN CANCELADO POR SEGURIDAD                │")
        print("╰─────────────────────────────────────────────────────────────╯")
        print(f"  • Cuenta activa actual : \033[1;32m{email}\033[0m ({active_profile})")
        print(f"\n  ⚠️  Hay {len(running_clients)} chat(s)/sesión(es) activa(s) de Antigravity abiertas:")
        for c in running_clients:
            pid = c["pid"]
            tty = c["tty"]
            cmd = c["cmd"]
            el = c["elapsed"]
            el_text = f" [{el}]" if el else ""
            print(f"     → \033[1mPID {pid}\033[0m en \033[1;33m{tty}\033[0m: {cmd}{el_text}")
        print("\n  Iniciar sesión con otra cuenta ahora reemplazará tus credenciales activas y puede")
        print("  romper o cerrar esas conversaciones.")
        print(f"\n  💡 Tip: Si solo deseas registrar la cuenta para monitorear sus tokens/cuotas")
        print(f"     sin cerrar tus chats activos ni cambiar la cuenta activa, usa:")
        print(f"     \033[1;32magy-switch agregar {nombre}\033[0m")
        print(f"\n  Para reemplazar la cuenta activa de todas formas:")
        print(f"     Cierra las sesiones indicadas o usa: \033[1;31magy-switch nueva {nombre} --force\033[0m\n")
        sys.exit(1)

    if running_clients and force:
        print(f"\n⚠️  Advertencia: Forzando inicio de sesión (--force) con {len(running_clients)} proceso(s) activo(s)...", flush=True)

    # Si hay token activo y no está guardado, guardarlo como backup
    if token_path.is_file() and token_path.stat().st_size > 10:
        actual = find_active_profile_name(cuentas_dir, token_path)
        if actual.startswith("(sin guardar"):
            backup = cuentas_dir / "anterior_auto.token"
            private_copy(token_path, backup)
            print(f"ℹ️ Token actual respaldado preventivamente como 'anterior_auto'.")

    # Mover temporalmente el token actual
    temp_backup = get_base_dir() / "antigravity-oauth-token.bak"
    if token_path.is_file():
        shutil.move(token_path, temp_backup)

    # Respaldar y limpiar Keyring temporalmente para que agy inicie un flujo OAuth limpio
    keyring_backup = extract_token_from_keyring()
    if keyring_backup:
        clear_token_from_keyring()

    print("\n🚀 Preparando inicio de sesión para la nueva cuenta...")
    print("   Se abrirá 'agy'. Completa el flujo de autenticación OAuth en tu navegador.")
    print("   Una vez que agy cargue, sal con Ctrl+D o /exit.\n")
    try:
        subprocess.run(["agy"], check=False)
    finally:
        # Verificar token generado (en archivo o en GNOME Keyring)
        if not token_path.is_file() or token_path.stat().st_size <= 10:
            ensure_active_token_on_disk()

        if token_path.is_file() and token_path.stat().st_size > 10:
            dest = cuentas_dir / f"{nombre}.token"
            private_copy(token_path, dest)
            email = decode_email_from_token(dest)
            try:
                raw_tok = token_path.read_text(encoding="utf-8")
                sync_token_to_keyring(raw_tok)
            except Exception:
                pass
            print(f"\n✅ Nueva cuenta registrada y guardada como '\033[1;36m{nombre}\033[0m' ({email})!")
            if temp_backup.is_file():
                temp_backup.unlink()
        else:
            print("\n⚠️ No se detectó inicio de sesión completado. Restaurando credencial anterior...")
            if temp_backup.is_file():
                shutil.move(temp_backup, token_path)
            if keyring_backup:
                sync_token_to_keyring(keyring_backup)

def cmd_continuar(args: list[str]):
    ensure_active_token_on_disk()
    token_path = get_token_path()
    if token_path.is_file() and token_path.stat().st_size > 10:
        try:
            sync_token_to_keyring(token_path.read_text(encoding="utf-8"))
        except Exception:
            pass
    last_cid = get_most_recent_conversation_id()
    cmd = ["agy"]
    if args:
        cmd.extend(["--conversation", args[0]])
    elif last_cid:
        cmd.append("-c")
    else:
        print("⚠️ No hay conversaciones recientes para continuar. Iniciando sesión limpia.")
    
    # Reemplazar el proceso actual por agy
    os.execvp(cmd[0], cmd)

def find_widget_executable() -> Path | None:
    here = Path(__file__).resolve().parent
    candidates = [
        here / "switch-widget",
        Path.home() / ".local" / "bin" / "switch-widget",
        Path("/usr/local/bin/switch-widget"),
    ]
    which = shutil.which("switch-widget")
    if which:
        candidates.insert(0, Path(which))
    for c in candidates:
        if c.is_file():
            return c
    return None


def find_tray_executable() -> Path | None:
    here = Path(__file__).resolve().parent
    candidates = [
        here / "switch-tray",
        Path.home() / ".local" / "bin" / "switch-tray",
        Path("/usr/local/bin/switch-tray"),
    ]
    which = shutil.which("switch-tray")
    if which:
        candidates.insert(0, Path(which))
    for c in candidates:
        if c.is_file():
            return c
    return None


def cmd_widget(extra_args: list):
    w = find_widget_executable()
    if not w:
        print("❌ Error: No se encontró el ejecutable 'switch-widget'.")
        print("   Ejecuta ./install.sh para instalarlo en tu sistema.")
        sys.exit(1)
    cmd = [sys.executable, str(w), "--filter", "agy"] + extra_args
    try:
        subprocess.run(cmd)
    except KeyboardInterrupt:
        pass


def cmd_tray(extra_args: list):
    t = find_tray_executable()
    if not t:
        print("❌ Error: No se encontró el ejecutable 'switch-tray'.")
        print("   Ejecuta ./install.sh para instalarlo en tu sistema.")
        sys.exit(1)
    cmd = [sys.executable, str(t)] + extra_args
    try:
        subprocess.run(cmd)
    except KeyboardInterrupt:
        pass


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("status", "estado", "-s", "tokens", "token", "cuota", "quota", "usage", "saldo"):
        target = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        cmd_status(target)
    elif args[0] in ("widget", "gui", "ui", "dashboard"):
        cmd_widget(args[1:])
    elif args[0] in ("tray", "barra", "taskbar"):
        cmd_tray(args[1:])
    elif args[0] in ("listar", "list", "ls"):
        cmd_listar()
    elif args[0] in ("guardar", "save"):
        nombre = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        force = any(a in ("--force", "-f") for a in args[1:])
        cmd_guardar(nombre, force=force)
    elif args[0] in ("eliminar", "borrar", "rm", "delete", "quitar"):
        nombre = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        cmd_eliminar(nombre)
    elif args[0] in ("renombrar", "mv", "rename"):
        actual = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        nuevo = args[2] if len(args) > 2 and not args[2].startswith("-") else ""
        cmd_renombrar(actual, nuevo)
    elif args[0] in ("usar", "use", "switch"):
        nombre = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        force = any(a in ("--force", "-f") for a in args[1:])
        cmd_usar(nombre, force=force)
    elif args[0] in ("agregar", "add"):
        i = 1
        desde = ""
        force = False
        positionals = []
        while i < len(args):
            a = args[i]
            if a in ("--desde", "--from", "--importar", "--import"):
                if i + 1 < len(args):
                    desde = args[i + 1]
                    i += 2
                    continue
                else:
                    print("❌ Error: --desde requiere una ruta de archivo o JSON.")
                    sys.exit(2)
            elif a in ("--force", "-f"):
                force = True
            elif a.startswith("-"):
                print(f"Opción no reconocida: {a}")
                print("Uso: agy-switch agregar <nombre> [--desde <ruta_o_json>] [--force]")
                sys.exit(2)
            else:
                positionals.append(a)
            i += 1
        nombre = positionals[0] if positionals else ""
        cmd_agregar(nombre, desde=desde, force=force)
    elif args[0] in ("nueva", "new", "login", "login-nueva"):
        nombre = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        options = [a for a in args[1:] if a != nombre]
        force = any(a in ("--force", "-f") for a in options)
        aislada = any(a in ("--aislada", "--no-switch", "--isolated") for a in options)
        unknown = [option for option in options if option not in ("--force", "-f", "--aislada", "--no-switch", "--isolated")]
        if unknown:
            print(f"Opción no reconocida para nueva cuenta: {unknown[0]}")
            print("Uso: agy-switch nueva <nombre> [--force] [--aislada]")
            sys.exit(2)
        cmd_nueva(nombre, force=force, aislada=aislada)
    elif args[0] in ("continuar", "continue", "resume", "-c"):
        cmd_continuar(args[1:])
    elif args[0] in ("id", "hash"):
        cid = get_most_recent_conversation_id()
        if cid:
            print(cid)
        else:
            sys.exit(1)
    elif args[0] in ("ayuda", "help", "--help", "-h"):
        print("Uso: agy-switch [comando] [argumentos]")
        print("\nComandos disponibles:")
        print("  tray              Inicia el widget de bajo consumo en la barra de tareas / bandeja (alias: barra)")
        print("  widget            Abre el widget gráfico flotante de escritorio (alias: gui, ui)")
        print("  status [nombre]   Consulta en vivo tokens, cuotas y límites restantes (alias: tokens, cuota)")
        print("  listar            Lista rápida de cuentas en disco sin consultar red (offline)")
        print("  agregar <nombre>  Agrega una cuenta en entorno aislado sin tocar la sesión activa (alias: add)")
        print("                    (admite: --desde <archivo_o_json>, --force)")
        print("  guardar <nombre>  Guarda las credenciales activas bajo un alias (evita duplicados)")
        print("  eliminar <nombre> Elimina un perfil guardado en disco (alias: borrar, quitar, rm)")
        print("  renombrar <a1> <a2> Renombra un perfil guardado a un nuevo alias (alias: mv)")
        print("  usar <nombre>     Cambia a la cuenta indicada inmediatamente")
        print("  nueva <nombre>    Inicia sesión interactiva para registrar una nueva cuenta")
        print("  continuar         Reanuda la última conversación registrada")
        print("  id                Muestra el identificador de la última conversación")
    else:
        print(f"Comando desconocido: {args[0]}")
        print("Uso: agy-switch [tray | widget | status [nombre] | tokens | listar | agregar <nombre> | guardar <nombre> | eliminar <nombre> | renombrar <a1> <a2> | usar <nombre> | nueva <nombre> | continuar | id]")
        sys.exit(1)

if __name__ == "__main__":
    main()
