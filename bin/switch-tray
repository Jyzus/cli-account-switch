# ==============================================================================
# VENTANA FLOTANTE / POPOVER ESTÉTICO NATIVO EN GTK 3
# ==============================================================================

class FloatingTrayWindow:
    """
    Ventana flotante / Popover nativo en GTK 3 sin marco decorativo (flyout).
    Diseñado específicamente para el widget de bandeja en Linux, permitiendo
    mostrar la estética moderna solicitada:
    - Fondo oscuro con bordes redondeados (#0d1117)
    - Tarjetas redondeadas (#161b22) para un máximo de 3 cuentas de cada tipo
    - Barras de progreso dinámicas por nivel de cuota (verde, ámbar, rojo)
    - Tipografía reducida para reinicio semanal y tiempo de refresco
    - Pie horizontal con los 2 botones lado a lado: [ 📊 Abrir Monitor ] [ ↻ Actualizar ]
    """
    def __init__(self, on_switch=None, on_open_monitor=None, on_refresh=None):
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk, Gdk
        self.Gtk = Gtk
        self.Gdk = Gdk
        self.on_switch = on_switch
        self.on_open_monitor = on_open_monitor
        self.on_refresh = on_refresh

        self.win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        self.win.set_title("Switch · Monitor Rápido")
        self.win.set_decorated(False)
        self.win.set_skip_taskbar_hint(True)
        self.win.set_skip_pager_hint(True)
        self.win.set_keep_above(True)
        self.win.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.win.set_resizable(False)
        self.win.set_default_size(360, 490)

        # Eventos para cerrar al hacer clic fuera o pulsar Escape
        self.win.connect("focus-out-event", self._on_focus_out)
        self.win.connect("key-press-event", self._on_key_press)

        # Contenedor raíz con estilo CSS
        self.root_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.root_box.get_style_context().add_class("floating-window")
        self.win.add(self.root_box)

        # 1. Cabecera (Header)
        self.header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.header_box.get_style_context().add_class("popover-header")

        lbl_title = Gtk.Label()
        lbl_title.set_markup("<span><b>✦ Switch · Monitor Rápido</b></span>")
        lbl_title.set_xalign(0.0)

        lbl_badge = Gtk.Label(label="EN VIVO")
        lbl_badge.get_style_context().add_class("header-badge")

        btn_close = Gtk.Button(label="✕")
        btn_close.get_style_context().add_class("btn-close")
        btn_close.connect("clicked", lambda _: self.hide())

        self.header_box.pack_start(lbl_title, False, False, 0)
        self.header_box.pack_start(lbl_badge, False, False, 0)
        self.header_box.pack_end(btn_close, False, False, 0)
        self.root_box.pack_start(self.header_box, False, False, 0)

        # 2. Contenedor de Cuentas
        self.content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.content_box.get_style_context().add_class("content-box")
        self.root_box.pack_start(self.content_box, True, True, 0)

        # 3. Pie horizontal con los 2 botones lado a lado
        self.footer_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.footer_box.get_style_context().add_class("footer-box")

        btn_mon = Gtk.Button(label="📊 Abrir Monitor")
        btn_mon.get_style_context().add_class("footer-btn")
        btn_mon.get_style_context().add_class("btn-monitor")
        btn_mon.connect("clicked", self._on_click_monitor)

        btn_ref = Gtk.Button(label="↻ Actualizar")
        btn_ref.get_style_context().add_class("footer-btn")
        btn_ref.get_style_context().add_class("btn-refresh")
        btn_ref.connect("clicked", self._on_click_refresh)

        self.footer_box.pack_start(btn_mon, True, True, 0)
        self.footer_box.pack_start(btn_ref, True, True, 0)
        self.root_box.pack_start(self.footer_box, False, False, 0)

        self.current_data = {}

    def _on_focus_out(self, widget, event):
        self.hide()
        return False

    def _on_key_press(self, widget, event):
        if event.keyval == self.Gdk.KEY_Escape:
            self.hide()
            return True
        return False

    def _on_click_monitor(self, _):
        self.hide()
        if self.on_open_monitor:
            self.on_open_monitor()

    def _on_click_refresh(self, _):
        if self.on_refresh:
            self.on_refresh()

    def is_visible(self) -> bool:
        return self.win.get_visible()

    def hide(self):
        self.win.hide()

    def show_at_tray_position(self):
        try:
            display = self.Gdk.Display.get_default()
            if display:
                monitor = display.get_primary_monitor() or display.get_monitor(0)
                if monitor:
                    geom = monitor.get_geometry()
                    win_w, win_h = 360, 490
                    pos_x = max(10, geom.x + geom.width - win_w - 18)
                    pos_y = geom.y + 36
                    self.win.move(pos_x, pos_y)
        except Exception:
            pass
        self.win.show_all()
        self.win.present()

    def toggle(self):
        if self.is_visible():
            self.hide()
        else:
            self.show_at_tray_position()

    def update_data(self, status: dict):
        self.current_data = status
        for child in self.content_box.get_children():
            self.content_box.remove(child)

        codex = status.get("codex", {})
        agy = status.get("agy", {})

        # --- SECCIÓN 1: OPENAI CODEX (Top 3) ---
        lbl_c_head = self.Gtk.Label()
        lbl_c_head.set_markup("<span foreground='#34d399'><b>── 🟢 OPENAI CODEX (Top 3 Cuentas) ──</b></span>")
        lbl_c_head.set_xalign(0.0)
        lbl_c_head.set_margin_top(2)
        lbl_c_head.set_margin_bottom(2)
        self.content_box.pack_start(lbl_c_head, False, False, 0)

        c_accounts = (codex.get("accounts") or [])[:3]
        if not c_accounts:
            lbl_empty = self.Gtk.Label(label="  (No hay cuentas guardadas en Codex)")
            lbl_empty.set_xalign(0.0)
            self.content_box.pack_start(lbl_empty, False, False, 2)
        else:
            for acc in c_accounts:
                self.content_box.pack_start(self._build_card("codex", acc), False, False, 0)

        # Separador sutil
        sep = self.Gtk.Separator(orientation=self.Gtk.Orientation.HORIZONTAL)
        sep.set_margin_top(4)
        sep.set_margin_bottom(4)
        self.content_box.pack_start(sep, False, False, 0)

        # --- SECCIÓN 2: GOOGLE AGY (Top 3) ---
        lbl_a_head = self.Gtk.Label()
        lbl_a_head.set_markup("<span foreground='#a78bfa'><b>── 🟣 GOOGLE AGY (Top 3 Cuentas) ──</b></span>")
        lbl_a_head.set_xalign(0.0)
        lbl_a_head.set_margin_top(2)
        lbl_a_head.set_margin_bottom(2)
        self.content_box.pack_start(lbl_a_head, False, False, 0)

        a_accounts = (agy.get("accounts") or [])[:3]
        if not a_accounts:
            lbl_empty = self.Gtk.Label(label="  (No hay cuentas guardadas en AGY)")
            lbl_empty.set_xalign(0.0)
            self.content_box.pack_start(lbl_empty, False, False, 2)
        else:
            for acc in a_accounts:
                self.content_box.pack_start(self._build_card("agy", acc), False, False, 0)

        self.content_box.show_all()

    def _build_card(self, provider: str, acc: dict):
        Gtk = self.Gtk
        name = acc.get("name", "")
        is_act = acc.get("is_active", False)
        err = acc.get("error")

        ev = Gtk.EventBox()
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        card.get_style_context().add_class("account-card")
        if is_act:
            card.get_style_context().add_class("active")

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        prefix = "★ [ACTIVA]" if is_act else "⚡ Usar"
        p_color = "#38bdf8" if is_act else "#94a3b8"

        lbl_name = Gtk.Label()
        lbl_name.set_markup(f"<span foreground='{p_color}'><b>{prefix}</b></span> <b>{name}</b>")
        lbl_name.set_xalign(0.0)
        row.pack_start(lbl_name, True, True, 0)

        if provider == "codex":
            c_pct = acc.get("available_pct")
            w_pct = acc.get("weekly_pct")
            res = acc.get("reset_str")

            if c_pct is not None:
                c_color = "#34d399" if c_pct > 40 else ("#fbbf24" if c_pct > 15 else "#f87171")
                lbl_pct = Gtk.Label()
                lbl_pct.set_markup(f"<span foreground='{c_color}'><b>{c_pct}%</b> disp</span>")
                lbl_pct.set_xalign(1.0)
                row.pack_end(lbl_pct, False, False, 0)
            card.pack_start(row, False, False, 0)

            if err:
                lbl_err = Gtk.Label()
                lbl_err.set_markup(f"<span size='smaller' foreground='#ef4444'>⚠️ {err}</span>")
                lbl_err.set_xalign(0.0)
                card.pack_start(lbl_err, False, False, 0)
            elif c_pct is not None:
                pb = Gtk.ProgressBar()
                pb.set_fraction(max(0.0, min(1.0, c_pct / 100.0)))
                if c_pct <= 15:
                    pb.get_style_context().add_class("red")
                elif c_pct <= 40:
                    pb.get_style_context().add_class("amber")
                card.pack_start(pb, False, False, 1)

                sub_parts = []
                if res:
                    sub_parts.append(f"⏳ Resetea en: {res}")
                if w_pct is not None:
                    sub_parts.append(f"📅 Semanal: {w_pct}%")

                if sub_parts:
                    lbl_sub = Gtk.Label()
                    sub_text = "   ·   ".join(sub_parts)
                    lbl_sub.set_markup(f"<span size='smaller' foreground='#8b949e'>{sub_text}</span>")
                    lbl_sub.set_xalign(0.0)
                    card.pack_start(lbl_sub, False, False, 0)
        else:  # agy
            g_pct = acc.get("gemini_pct")
            c_pct = acc.get("claude_pct")
            res = acc.get("reset_str")

            if g_pct is not None:
                g_color = "#34d399" if g_pct > 40 else ("#fbbf24" if g_pct > 15 else "#f87171")
                lbl_pct = Gtk.Label()
                lbl_pct.set_markup(f"<span foreground='{g_color}'><b>Gemini {g_pct}%</b></span>")
                lbl_pct.set_xalign(1.0)
                row.pack_end(lbl_pct, False, False, 0)
            card.pack_start(row, False, False, 0)

            if err:
                lbl_err = Gtk.Label()
                lbl_err.set_markup(f"<span size='smaller' foreground='#ef4444'>⚠️ {err}</span>")
                lbl_err.set_xalign(0.0)
                card.pack_start(lbl_err, False, False, 0)
            elif g_pct is not None:
                pb = Gtk.ProgressBar()
                pb.set_fraction(max(0.0, min(1.0, g_pct / 100.0)))
                if g_pct <= 15:
                    pb.get_style_context().add_class("red")
                elif g_pct <= 40:
                    pb.get_style_context().add_class("amber")
                card.pack_start(pb, False, False, 1)

                sub_parts = []
                if res:
                    sub_parts.append(f"⏳ Resetea en: {res}")
                if c_pct is not None:
                    sub_parts.append(f"Claude 3P: {c_pct}%")

                if sub_parts:
                    lbl_sub = Gtk.Label()
                    sub_text = "   ·   ".join(sub_parts)
                    lbl_sub.set_markup(f"<span size='smaller' foreground='#8b949e'>{sub_text}</span>")
                    lbl_sub.set_xalign(0.0)
                    card.pack_start(lbl_sub, False, False, 0)

        ev.add(card)

        if not is_act and not name.startswith("(") and self.on_switch:
            cb = self.on_switch(provider, name)
            def on_press(w, e):
                cb(None)
                return True
            ev.connect("button-press-event", on_press)

        return ev


class LinuxAppIndicatorTray:
    def __init__(self, interval: int = 300):
        self.interval = max(30, interval)
        self.icons = ensure_tray_icons()
        self.current_status: dict = {}
        self.indicator = None
        self.popover = None
        self.Gtk = None
        self.GLib = None

    def start(self):
        import gi
        gi.require_version("Gtk", "3.0")
        has_ayatana = False
        try:
            gi.require_version("AyatanaAppIndicator3", "0.1")
            from gi.repository import AyatanaAppIndicator3 as AppIndicator
            has_ayatana = True
        except (ValueError, ImportError):
            try:
                gi.require_version("AppIndicator3", "0.1")
                from gi.repository import AppIndicator3 as AppIndicator
            except (ValueError, ImportError):
                print("❌ No se encontró AyatanaAppIndicator3 ni AppIndicator3.", file=sys.stderr)
                print("   Instala: sudo apt install gir12.1-ayatanaappindicator3-0.1", file=sys.stderr)
                sys.exit(1)

        from gi.repository import Gtk, GLib, Gdk

        self.Gtk = Gtk
        self.GLib = GLib

        # Verificar si hay una pantalla gráfica accesible
        success, _ = Gtk.init_check(None)
        if not success:
            print("⚠️ No se detectó un servidor gráfico (DISPLAY no configurado).", file=sys.stderr)
            print("   Si estás en SSH, ejecuta switch-tray en tu sesión de escritorio gráfica.", file=sys.stderr)
            print("   O habilita el auto-arranque con: switch-tray --autostart enable", file=sys.stderr)
            sys.exit(1)

        # Cargar estilos CSS modernos para barras de progreso y botones
        try:
            style_provider = Gtk.CssProvider()
            style_provider.load_from_data(GTK_CUSTOM_CSS)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(),
                style_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )
        except Exception:
            pass

        # Inicializar ventana flotante / popover estético
        self.popover = FloatingTrayWindow(
            on_switch=self._make_switch_cb,
            on_open_monitor=self._open_full_widget,
            on_refresh=self.trigger_refresh,
        )

        # Manejador de señal para alternar ventana flotante desde CLI (SIGUSR1)
        if hasattr(signal, "SIGUSR1"):
            try:
                signal.signal(signal.SIGUSR1, lambda s, f: self.GLib.idle_add(self.popover.toggle))
            except Exception:
                pass

        initial_icon = self.icons.get("green", "utilities-system-monitor")
        self.indicator = AppIndicator.Indicator.new(
            "cli-account-switch-tray",
            initial_icon,
            AppIndicator.IndicatorCategory.APPLICATION_STATUS,
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("Switch")

        # Construir menú inicial
        self.menu = Gtk.Menu()
        self.indicator.set_menu(self.menu)

        # Iniciar hilo de recolección en segundo plano
        t = threading.Thread(target=self._worker_loop, daemon=True)
        t.start()

        # Iniciar loop principal de GTK
        Gtk.main()

    def _worker_loop(self):
        while True:
            data = fetch_tray_status()
            self.GLib.idle_add(self._apply_data, data)
            time.sleep(self.interval)

    def trigger_refresh(self):
        def worker():
            data = fetch_tray_status()
            self.GLib.idle_add(self._apply_data, data)
        threading.Thread(target=worker, daemon=True).start()

    def _apply_data(self, data: dict):
        self.current_status = data
        codex = data.get("codex", {})
        agy = data.get("agy", {})

        c_pct = codex.get("available_pct")
        g_pct = agy.get("gemini_pct")

        # Texto del panel en la barra de tareas
        labels = []
        if c_pct is not None:
            labels.append(f"Codex: {c_pct}%")
        elif codex.get("error"):
            labels.append("Codex: ⚠️")

        if g_pct is not None:
            labels.append(f"AGY: {g_pct}%")
        elif agy.get("error"):
            labels.append("AGY: ⚠️")

        panel_text = " | ".join(labels) if labels else "AI Tokens"
        self.indicator.set_label(panel_text, "Codex: 100% | AGY: 100%")

        # Determinar icono según el peor porcentaje
        all_pcts = [p for p in (c_pct, g_pct) if p is not None]
        if codex.get("error") or agy.get("error"):
            icon_key = "error"
        elif not all_pcts:
            icon_key = "yellow"
        elif min(all_pcts) <= 15:
            icon_key = "red"
        elif min(all_pcts) <= 40:
            icon_key = "yellow"
        else:
            icon_key = "green"

        icon_path = self.icons.get(icon_key, "utilities-system-monitor")
        self.indicator.set_icon_full(icon_path, panel_text)

        # Actualizar datos en la ventana flotante
        if self.popover:
            try:
                self.popover.update_data(data)
            except Exception:
                pass

        # Reconstruir menú desplegable
        self._rebuild_menu()

    def _create_account_item(self, provider: str, acc: dict):
        if not self.Gtk:
            import gi
            gi.require_version("Gtk", "3.0")
            from gi.repository import Gtk
            self.Gtk = Gtk
        Gtk = self.Gtk
        name = acc.get("name", "")
        is_act = acc.get("is_active", False)
        err = acc.get("error")

        item = Gtk.MenuItem()
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        vbox.set_margin_top(3)
        vbox.set_margin_bottom(3)
        vbox.set_margin_start(8)
        vbox.set_margin_end(8)

        prefix = "★ [ACTIVA]" if is_act else "⚡ Usar"
        p_color = "#38bdf8" if is_act else "#94a3b8"

        if provider == "codex":
            c_pct = acc.get("available_pct")
            w_pct = acc.get("weekly_pct")
            res = acc.get("reset_str")

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            lbl_name = Gtk.Label()
            lbl_name.set_markup(f"<span foreground='{p_color}'><b>{prefix}</b></span> <b>{name}</b>")
            lbl_name.set_xalign(0.0)
            row.pack_start(lbl_name, True, True, 0)

            if c_pct is not None:
                c_color = "#34d399" if c_pct > 40 else ("#fbbf24" if c_pct > 15 else "#f87171")
                lbl_pct = Gtk.Label()
                lbl_pct.set_markup(f"<span foreground='{c_color}'><b>{c_pct}%</b> disp</span>")
                lbl_pct.set_xalign(1.0)
                row.pack_end(lbl_pct, False, False, 0)
            vbox.pack_start(row, False, False, 0)

            if err:
                lbl_err = Gtk.Label()
                lbl_err.set_markup(f"<span size='smaller' foreground='#ef4444'>⚠️ {err}</span>")
                lbl_err.set_xalign(0.0)
                vbox.pack_start(lbl_err, False, False, 0)
            elif c_pct is not None:
                pbar = Gtk.ProgressBar()
                pbar.set_fraction(max(0.0, min(1.0, c_pct / 100.0)))
                if c_pct <= 15:
                    pbar.get_style_context().add_class("red")
                elif c_pct <= 40:
                    pbar.get_style_context().add_class("amber")
                vbox.pack_start(pbar, False, False, 1)

                sub_parts = []
                if res:
                    sub_parts.append(f"⏳ Resetea en: {res}")
                if w_pct is not None:
                    sub_parts.append(f"📅 Semanal: {w_pct}%")

                if sub_parts:
                    lbl_sub = Gtk.Label()
                    sub_text = "   ·   ".join(sub_parts)
                    lbl_sub.set_markup(f"<span size='smaller' foreground='#8b949e'>{sub_text}</span>")
                    lbl_sub.set_xalign(0.0)
                    vbox.pack_start(lbl_sub, False, False, 0)

        else:  # agy
            g_pct = acc.get("gemini_pct")
            c_pct = acc.get("claude_pct")
            res = acc.get("reset_str")

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            lbl_name = Gtk.Label()
            lbl_name.set_markup(f"<span foreground='{p_color}'><b>{prefix}</b></span> <b>{name}</b>")
            lbl_name.set_xalign(0.0)
            row.pack_start(lbl_name, True, True, 0)

            if g_pct is not None:
                g_color = "#34d399" if g_pct > 40 else ("#fbbf24" if g_pct > 15 else "#f87171")
                lbl_pct = Gtk.Label()
                lbl_pct.set_markup(f"<span foreground='{g_color}'><b>Gemini {g_pct}%</b></span>")
                lbl_pct.set_xalign(1.0)
                row.pack_end(lbl_pct, False, False, 0)
            vbox.pack_start(row, False, False, 0)

            if err:
                lbl_err = Gtk.Label()
                lbl_err.set_markup(f"<span size='smaller' foreground='#ef4444'>⚠️ {err}</span>")
                lbl_err.set_xalign(0.0)
                vbox.pack_start(lbl_err, False, False, 0)
            elif g_pct is not None:
                pbar = Gtk.ProgressBar()
                pbar.set_fraction(max(0.0, min(1.0, g_pct / 100.0)))
                if g_pct <= 15:
                    pbar.get_style_context().add_class("red")
                elif g_pct <= 40:
                    pbar.get_style_context().add_class("amber")
                vbox.pack_start(pbar, False, False, 1)

                sub_parts = []
                if res:
                    sub_parts.append(f"⏳ Resetea en: {res}")
                if c_pct is not None:
                    sub_parts.append(f"Claude 3P: {c_pct}%")

                if sub_parts:
                    lbl_sub = Gtk.Label()
                    sub_text = "   ·   ".join(sub_parts)
                    lbl_sub.set_markup(f"<span size='smaller' foreground='#8b949e'>{sub_text}</span>")
                    lbl_sub.set_xalign(0.0)
                    vbox.pack_start(lbl_sub, False, False, 0)

        item.add(vbox)

        if not is_act and not name.startswith("("):
            item.connect("activate", self._make_switch_cb(provider, name))
        else:
            item.set_sensitive(False)

        return item

    def _rebuild_menu(self):
        if not self.Gtk:
            import gi
            gi.require_version("Gtk", "3.0")
            from gi.repository import Gtk
            self.Gtk = Gtk
        Gtk = self.Gtk
        menu = Gtk.Menu()
        codex = self.current_status.get("codex", {})
        agy = self.current_status.get("agy", {})

        # Acceso directo para desplegar ventana flotante estética
        item_popover = Gtk.MenuItem(label="✨ Abrir Panel Rápido Flotante")
        item_popover.connect("activate", lambda _: self.popover.toggle() if self.popover else None)
        menu.append(item_popover)
        menu.append(Gtk.SeparatorMenuItem())

        # ==========================================
        # SECCIÓN OPENAI CODEX (TOP 3)
        # ==========================================
        c_head = Gtk.MenuItem(label="── 🟢 OPENAI CODEX (Top 3 Cuentas) ──")
        c_head.set_sensitive(False)
        menu.append(c_head)

        c_accounts = (codex.get("accounts") or [])[:3]
        if not c_accounts:
            empty_c = Gtk.MenuItem(label="  (Sin cuentas guardadas de Codex)")
            empty_c.set_sensitive(False)
            menu.append(empty_c)
        else:
            for acc in c_accounts:
                menu.append(self._create_account_item("codex", acc))

        menu.append(Gtk.SeparatorMenuItem())

        # ==========================================
        # SECCIÓN GOOGLE ANTIGRAVITY (TOP 3)
        # ==========================================
        a_head = Gtk.MenuItem(label="── 🟣 GOOGLE AGY (Top 3 Cuentas) ──")
        a_head.set_sensitive(False)
        menu.append(a_head)

        a_accounts = (agy.get("accounts") or [])[:3]
        if not a_accounts:
            empty_a = Gtk.MenuItem(label="  (Sin cuentas guardadas de AGY)")
            empty_a.set_sensitive(False)
            menu.append(empty_a)
        else:
            for acc in a_accounts:
                menu.append(self._create_account_item("agy", acc))

        menu.append(Gtk.SeparatorMenuItem())

        # Submenú: Todas las cuentas Codex (para cuando hay > 3)
        all_c = codex.get("all_accounts") or []
        if len(all_c) > 3:
            c_acc = codex.get("active_name") or "(ninguna)"
            sub_codex = Gtk.Menu()
            for acc in all_c:
                mark = "✓ " if acc == c_acc else "  "
                sub_item = Gtk.MenuItem(label=f"{mark}{acc}")
                sub_item.connect("activate", self._make_switch_cb("codex", acc))
                sub_codex.append(sub_item)
            item_switch_c = Gtk.MenuItem(label="Ver todas las cuentas Codex ▸")
            item_switch_c.set_submenu(sub_codex)
            menu.append(item_switch_c)

        # Submenú: Todas las cuentas AGY (para cuando hay > 3)
        all_a = agy.get("all_accounts") or []
        if len(all_a) > 3:
            a_acc = agy.get("active_name") or "(ninguna)"
            sub_agy = Gtk.Menu()
            for acc in all_a:
                mark = "✓ " if acc == a_acc else "  "
                sub_item = Gtk.MenuItem(label=f"{mark}{acc}")
                sub_item.connect("activate", self._make_switch_cb("agy", acc))
                sub_agy.append(sub_item)
            item_switch_a = Gtk.MenuItem(label="Ver todas las cuentas AGY ▸")
            item_switch_a.set_submenu(sub_agy)
            menu.append(item_switch_a)

        if len(all_c) > 3 or len(all_a) > 3:
            menu.append(Gtk.SeparatorMenuItem())

        # Pie con 2 botones lado a lado: Monitor y Actualizar
        footer_item = Gtk.MenuItem()
        footer_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        footer_box.set_margin_top(4)
        footer_box.set_margin_bottom(4)
        footer_box.set_margin_start(6)
        footer_box.set_margin_end(6)

        btn_monitor = Gtk.Button(label="📊 Abrir Monitor")
        btn_monitor.get_style_context().add_class("footer-btn")
        btn_monitor.get_style_context().add_class("btn-monitor")
        btn_monitor.connect("clicked", lambda _: self._open_full_widget())

        btn_refresh = Gtk.Button(label="↻ Actualizar")
        btn_refresh.get_style_context().add_class("footer-btn")
        btn_refresh.get_style_context().add_class("btn-refresh")
        btn_refresh.connect("clicked", lambda _: self.trigger_refresh())

        footer_box.pack_start(btn_monitor, True, True, 0)
        footer_box.pack_start(btn_refresh, True, True, 0)
        footer_item.add(footer_box)
        menu.append(footer_item)

        menu.show_all()
        self.menu = menu
        if self.indicator:
            self.indicator.set_menu(menu)

    def _make_switch_cb(self, provider: str, account: str):
        def cb(_):
            def worker():
                mod_name = "codex-switch" if provider == "codex" else "agy-switch"
                mod = load_cli_module(mod_name)
                if mod and hasattr(mod, "find_running_clients"):
                    try:
                        running = mod.find_running_clients(provider)
                        if running:
                            # Notificar conflicto de sesiones en la consola/registro
                            print(f"⚠️ Advertencia: Sesiones activas de {provider} en pts/. Conmutación abortada.")
                            return
                    except Exception:
                        pass

                exe = find_module_file(mod_name)
                if exe:
                    subprocess.run([sys.executable, str(exe), "usar", account], capture_output=True)
                    self.trigger_refresh()
            threading.Thread(target=worker, daemon=True).start()
        return cb

    def _open_full_widget(self):
        w_exe = find_module_file("switch-widget")
        if w_exe:
            subprocess.Popen([sys.executable, str(w_exe)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _toggle_autostart(self, _):
        if is_autostart_enabled():
            disable_autostart()
        else:
            enable_autostart()
        self._rebuild_menu()


# ==============================================================================
# FALLBACK: PYSTRAY (WINDOWS / MACOS)
# ==============================================================================

class PystrayFallbackTray:
    def __init__(self, interval: int = 300):
        self.interval = max(30, interval)

    def start(self):
        try:
            import pystray
            from PIL import Image, ImageDraw
        except ImportError:
            print("❌ Para usar el widget de bandeja en Windows/macOS, instala pystray:")
            print("   pip install pystray pillow")
            sys.exit(1)

        def create_image(color: str):
            image = Image.new("RGBA", (64, 64), (0, 0, 0, 0))
            draw = ImageDraw.Draw(image)
            draw.ellipse((8, 8, 56, 56), fill=color, outline="#ffffff")
            return image

        def on_exit(icon, _):
            icon.stop()

        def on_open_widget(icon, _):
            w_exe = find_module_file("switch-widget")
            if w_exe:
                subprocess.Popen([sys.executable, str(w_exe)])

        icon = pystray.Icon(
            "cli-account-switch",
            create_image("#10b981"),
            "CLI Account Switch",
            menu=pystray.Menu(
                pystray.MenuItem("📊 Abrir Monitor", on_open_widget),
                pystray.MenuItem("↻ Actualizar", lambda icon, item: self.trigger_refresh()),
            ),
        )

        icon.run()


# ==============================================================================
# VISTA PREVIA DEL WIDGET INCRUSTADO (--preview y --preview-image)
# ==============================================================================

def run_preview(output_image: str | None = None):
    """
    Despliega la ventana flotante nativa idéntica al widget incrustado con datos de ejemplo
    (3 cuentas Codex, 3 cuentas AGY, barras de progreso, porcentajes semanales en
    letra reducida y botones de acción en pie lado a lado).
    Si se proporciona output_image, exporta un archivo PNG del widget y finaliza.
    """
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk

    success, _ = Gtk.init_check(None)
    if not success and not output_image:
        print("⚠️ No se detectó un servidor gráfico activo (DISPLAY no configurado).", file=sys.stderr)
        sys.exit(1)

    try:
        style_provider = Gtk.CssProvider()
        style_provider.load_from_data(GTK_CUSTOM_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            style_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )
    except Exception:
        pass

    popover = FloatingTrayWindow(
        on_switch=lambda p, n: (lambda _: print(f"Conmutar a {p} -> {n}")),
        on_open_monitor=lambda: print("📊 Abrir Monitor"),
        on_refresh=lambda: print("↻ Actualizar"),
    )

    demo_data = {
        "codex": {
            "accounts": [
                {"name": "principal", "is_active": True, "available_pct": 85, "weekly_pct": 72, "reset_str": "2h 45m"},
                {"name": "secundaria", "is_active": False, "available_pct": 42, "weekly_pct": 38, "reset_str": "4h 10m"},
                {"name": "backup", "is_active": False, "available_pct": 12, "weekly_pct": 15, "reset_str": "1h 05m"},
            ]
        },
        "agy": {
            "accounts": [
                {"name": "trabajo", "is_active": True, "gemini_pct": 92, "claude_pct": 88, "reset_str": "3h 15m"},
                {"name": "personal", "is_active": False, "gemini_pct": 60, "claude_pct": 45, "reset_str": "4h 50m"},
                {"name": "dev-team", "is_active": False, "gemini_pct": 18, "claude_pct": 15, "reset_str": "0h 40m"},
            ]
        },
    }

    popover.update_data(demo_data)
    popover.win.set_position(Gtk.WindowPosition.CENTER)
    popover.win.show_all()

    if output_image:
        try:
            import cairo
            while Gtk.events_pending():
                Gtk.main_iteration()
            alloc = popover.win.get_allocation()
            surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, alloc.width, alloc.height)
            cr = cairo.Context(surface)
            popover.win.draw(cr)
            surface.write_to_png(output_image)
            print(f"✅ Vista previa PNG generada exitosamente en: {output_image}")
        except Exception as e:
            print(f"❌ Error al renderizar imagen de vista previa: {e}", file=sys.stderr)
        return

    print("Mostrando vista previa del panel flotante en pantalla. Presiona Escape o cierra la ventana para salir.")
    try:
        Gtk.main()
    except KeyboardInterrupt:
        pass


# ==============================================================================
# PUNTO DE ENTRADA PRINCIPAL
# ==============================================================================

def main():
    parser = argparse.ArgumentParser(
        description="CLI Account Switch · Taskbar Widget (Monitor de tokens en barra de tareas con bajo consumo)"
    )
    parser.add_argument(
        "action",
        nargs="?",
        choices=["start", "stop", "restart", "status", "show", "popover", "toggle"],
        default=None,
        help="Acción a realizar: start (por defecto, en 2º plano), stop, restart, status o show/popover",
    )
    parser.add_argument("-v", "--version", action="version", version=f"CLI Account Switch Taskbar Widget v{VERSION}")
    parser.add_argument("-i", "--interval", type=int, default=300, help="Intervalo de consulta en segundos (por defecto 300s = 5 min)")
    parser.add_argument("--autostart", choices=["enable", "disable", "status"], help="Gestionar auto-inicio al encender la computadora")
    parser.add_argument("--status", action="store_true", help="Consultar estado rápido en la terminal y salir")
    parser.add_argument("--stop", action="store_true", help="Detener cualquier instancia activa del widget de bandeja")
    parser.add_argument("--restart", action="store_true", help="Reiniciar el widget de bandeja en segundo plano")
    parser.add_argument("--show", "--popover", dest="show_popover", action="store_true", help="Desplegar o alternar la ventana flotante estética")
    parser.add_argument("-f", "--foreground", action="store_true", help="Ejecutar en primer plano vinculado a la terminal (depuración)")
    parser.add_argument("--internal-run", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--daemon", action="store_true", help="Modo servicio de fondo continuo")
    parser.add_argument("--preview", action="store_true", help="Mostrar ventana de vista previa del widget incrustado con datos de ejemplo")
    parser.add_argument("--preview-image", type=str, metavar="RUTA", help="Generar imagen PNG con la vista previa del widget incrustado y salir")

    args = parser.parse_args()

    # 1. Vista previa interactiva o exportación de imagen
    if args.preview or args.preview_image:
        run_preview(output_image=args.preview_image)
        return

    # 2. Desplegar / Alternar ventana flotante estética (show / popover / toggle)
    if args.action in ("show", "popover", "toggle") or getattr(args, "show_popover", False):
        running_pid = get_running_pid()
        if running_pid:
            if hasattr(signal, "SIGUSR1"):
                try:
                    os.kill(running_pid, signal.SIGUSR1)
                    print(f"✨ Señal enviada para desplegar panel flotante estético (PID: \033[1;32m{running_pid}\033[0m).")
                except Exception as e:
                    print(f"❌ Error al comunicar con el widget (PID {running_pid}): {e}", file=sys.stderr)
            else:
                print("ℹ️ En esta plataforma utiliza el icono de la bandeja del sistema.")
            return
        else:
            print("ℹ️ El widget de barra de tareas no estaba en ejecución.")
            print("   Iniciando en segundo plano...")
            # Flujo continuará hacia inicio como daemon más abajo

    # 3. Detener proceso en segundo plano (stop)
    if args.action == "stop" or args.stop:
        stopped = stop_running_instance()
        if stopped:
            print("✅ Widget de barra de tareas detenido correctamente.")
        else:
            print("ℹ️ El widget de barra de tareas no estaba en ejecución.")
        return

    # 3. Reiniciar (restart)
    if args.action == "restart" or args.restart:
        stopped = stop_running_instance()
        if stopped:
            print("🔄 Instancia previa detenida.")

    # 4. Gestión de Autostart
    if args.autostart:
        if args.autostart == "enable":
            ok = enable_autostart()
            if ok:
                print(f"✅ Auto-inicio habilitado: {get_autostart_path()}")
            else:
                sys.exit(1)
        elif args.autostart == "disable":
            ok = disable_autostart()
            if ok:
                print("✅ Auto-inicio deshabilitado.")
            else:
                sys.exit(1)
        elif args.autostart == "status":
            enabled = is_autostart_enabled()
            st_text = "\033[1;32mHABILITADO\033[0m" if enabled else "\033[1;33mDESHABILITADO\033[0m"
            print(f"Auto-inicio con la computadora: {st_text}")
            print(f"Archivo de configuración: {get_autostart_path()}")
        return

    # 5. Consulta rápida en terminal (status)
    if args.action == "status" or args.status:
        data = fetch_tray_status()
        codex = data.get("codex", {})
        agy = data.get("agy", {})

        print("\n╭─────────────────────────────────────────────────────────────╮")
        print("│  ✦ Estado de Tokens por Proveedor (Top 3 Cuentas)           │")
        print("╰─────────────────────────────────────────────────────────────╯")

        print("\n  \033[1;32m🟢 OPENAI CODEX (Máximo 3 cuentas)\033[0m")
        c_accs = codex.get("accounts") or []
        if not c_accs:
            print("    (No hay cuentas guardadas. Usa: codex-switch guardar <nombre>)")
        for acc in c_accs:
            name = acc.get("name")
            is_act = acc.get("is_active")
            email = acc.get("email") or "Sin email"
            plan = acc.get("plan") or "ESTÁNDAR"
            star = "\033[1;33m★ [ACTIVA]\033[0m" if is_act else " " * 10
            print(f"  {star} \033[1m{name:16}\033[0m \033[2m{email}\033[0m [{plan}]")
            if acc.get("error"):
                print(f"              ⚠️  \033[1;31m{acc.get('error')}\033[0m")
            else:
                c_pct = acc.get("available_pct", 0) if acc.get("available_pct") is not None else "N/A"
                c_used = acc.get("used_pct", 0) if acc.get("used_pct") is not None else "N/A"
                c_res = acc.get("reset_str") or "reseteado"
                w_pct = acc.get("weekly_pct", 0) if acc.get("weekly_pct") is not None else "N/A"
                w_used = acc.get("weekly_used_pct", 0) if acc.get("weekly_used_pct") is not None else "N/A"
                w_res = acc.get("weekly_reset_str") or "reseteado"
                print(f"              • Estado Actual  (5h) : \033[1m{c_pct}%\033[0m disp · {c_used}% usado (resetea en: {c_res})")
                print(f"              • Estado Semanal (7d) : \033[1m{w_pct}%\033[0m disp · {w_used}% usado (resetea en: {w_res})")

        print("\n  \033[1;35m🟣 GOOGLE ANTIGRAVITY (Máximo 3 cuentas)\033[0m")
        a_accs = agy.get("accounts") or []
        if not a_accs:
            print("    (No hay cuentas guardadas. Usa: agy-switch guardar <nombre>)")
        for acc in a_accs:
            name = acc.get("name")
            is_act = acc.get("is_active")
            email = acc.get("email") or "Sin email"
            plan = acc.get("plan") or "ANTIGRAVITY"
            star = "\033[1;33m★ [ACTIVA]\033[0m" if is_act else " " * 10
            print(f"  {star} \033[1m{name:16}\033[0m \033[2m{email}\033[0m [{plan}]")
            if acc.get("error"):
                print(f"              ⚠️  \033[1;31m{acc.get('error')}\033[0m")
            else:
                g_pct = acc.get("gemini_pct", 0) if acc.get("gemini_pct") is not None else "N/A"
                g_used = acc.get("gemini_used_pct", 0) if acc.get("gemini_used_pct") is not None else "N/A"
                g_res = acc.get("reset_str") or "reseteado"
                c_pct = acc.get("claude_pct", 0) if acc.get("claude_pct") is not None else "N/A"
                c_used = acc.get("claude_used_pct", 0) if acc.get("claude_used_pct") is not None else "N/A"
                c_res = acc.get("claude_reset_str") or "reseteado"
                print(f"              • Gemini Models (5h)  : \033[1m{g_pct}%\033[0m disp · {g_used}% usado (resetea en: {g_res})")
                print(f"              • Claude 3P / Semanal : \033[1m{c_pct}%\033[0m disp · {c_used}% usado (resetea en: {c_res})")

        running_pid = get_running_pid()
        st_proc = f"\033[1;32mACTIVO\033[0m (PID: {running_pid})" if running_pid else "\033[1;33mDETENIDO\033[0m"
        print(f"\n  • Estado del widget de bandeja: {st_proc}")
        print(f"  • Auto-inicio al encender PC  : {'\033[1;32mHABILITADO\033[0m' if is_autostart_enabled() else '\033[1;33mDESHABILITADO\033[0m'}\n")
        return

    # 6. Modo interno (Worker desvinculado en segundo plano)
    if args.internal_run:
        pid_file = get_pid_file()
        pid_file.parent.mkdir(parents=True, exist_ok=True)
        pid_file.write_text(str(os.getpid()))
        atexit.register(lambda: pid_file.unlink(missing_ok=True) if pid_file.is_file() else None)

        if hasattr(signal, "SIGHUP"):
            signal.signal(signal.SIGHUP, signal.SIG_IGN)

        if not sys.platform.startswith("win") and sys.platform != "darwin":
            tray = LinuxAppIndicatorTray(interval=args.interval)
            tray.start()
        else:
            tray = PystrayFallbackTray(interval=args.interval)
            tray.start()
        return

    # 7. Modo en primer plano (adjunto a la terminal si se especifica -f/--foreground)
    if args.foreground:
        pid_file = get_pid_file()
        pid_file.parent.mkdir(parents=True, exist_ok=True)
        pid_file.write_text(str(os.getpid()))
        atexit.register(lambda: pid_file.unlink(missing_ok=True) if pid_file.is_file() else None)

        print("Iniciando widget en la barra de tareas en PRIMER PLANO...")
        print(f"  • Intervalo de chequeo: {args.interval}s")
        print(f"  • Auto-inicio con el sistema: {'Activado' if is_autostart_enabled() else 'Desactivado'}")
        print("  💡 (Para ejecutar en segundo plano y poder cerrar la terminal, usa: switch tray)")

        if not sys.platform.startswith("win") and sys.platform != "darwin":
            tray = LinuxAppIndicatorTray(interval=args.interval)
            try:
                tray.start()
            except KeyboardInterrupt:
                print("\nCerrando widget de bandeja...")
        else:
            tray = PystrayFallbackTray(interval=args.interval)
            try:
                tray.start()
            except KeyboardInterrupt:
                print("\nCerrando widget de bandeja...")
        return

    # 8. MODO PREDETERMINADO: Inicio en segundo plano desvinculado (Daemon)
    running_pid = get_running_pid()
    if running_pid:
        print(f"ℹ️ El widget de barra de tareas ya está activo en segundo plano (PID: \033[1;32m{running_pid}\033[0m).")
        print("   • Para reiniciarlo: \033[1;33mswitch tray restart\033[0m")
        print("   • Para detenerlo  : \033[1;31mswitch tray stop\033[0m")
        return

    script_path = Path(__file__).resolve()
    cmd = [sys.executable, str(script_path), "--internal-run", "-i", str(args.interval)]

    if sys.platform.startswith("win"):
        creationflags = getattr(subprocess, "DETACHED_PROCESS", 0) | getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            creationflags=creationflags,
        )
    else:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

    get_pid_file().write_text(str(proc.pid))
    print("╭─────────────────────────────────────────────────────────────╮")
    print("│  ✦ CLI Account Switch · Widget de Barra de Tareas           │")
    print("╰─────────────────────────────────────────────────────────────╯")
    print(f"  ✅ Widget incrustado iniciado en segundo plano (PID: \033[1;32m{proc.pid}\033[0m).")
    print("  🔒 \033[1mPermanecerá activo en tu panel aunque cierres esta terminal.\033[0m\n")
    print("  • Para consultar estado : \033[1;36mswitch tray status\033[0m")
    print("  • Para reiniciar        : \033[1;33mswitch tray restart\033[0m")
    print("  • Para detener          : \033[1;31mswitch tray stop\033[0m")
    print(f"  • Inicio con el sistema : {'\033[1;32mActivado\033[0m' if is_autostart_enabled() else '\033[1;33mDesactivado\033[0m (usa: switch tray --autostart enable)'}\n")


if __name__ == "__main__":
    main()
