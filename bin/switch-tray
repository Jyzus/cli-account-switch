#!/usr/bin/env python3
"""
CLI Account Switch · Taskbar / System Tray Widget
Monitor ultraligero de cuotas y tokens en la barra de tareas / bandeja del sistema.
Compatible con Linux (AppIndicator/Ayatana), Windows y macOS.
Bajo consumo de recursos (0% CPU en reposo, ~15MB RAM).
"""

from __future__ import annotations

import argparse
import atexit
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from importlib.machinery import SourceFileLoader
from pathlib import Path

VERSION = "1.2.6"

# ==============================================================================
# CARGA DE MÓDULOS DE CODEX Y AGY
# ==============================================================================

def find_module_file(name: str) -> Path | None:
    here = Path(__file__).resolve().parent
    candidates = [
        here / name,
        Path.home() / ".local" / "bin" / name,
        Path("/usr/local/bin") / name,
    ]
    which = shutil.which(name)
    if which:
        candidates.insert(0, Path(which))
    for c in candidates:
        if c.is_file():
            return c
    return None


def load_cli_module(name: str):
    f = find_module_file(name)
    if not f:
        return None
    try:
        # Si es un binario ELF compilado (ej. PyInstaller), no se puede importar directamente
        header = f.read_bytes()[:4]
        if header == b"\x7fELF" or header[:2] == b"MZ":
            return None
        mod_name = name.replace("-", "_")
        return SourceFileLoader(mod_name, str(f)).load_module()
    except Exception:
        return None


# ==============================================================================
# GESTIÓN DE AUTO-INICIO CON LA COMPUTADORA (AUTOSTART)
# ==============================================================================

def get_autostart_path() -> Path:
    if sys.platform.startswith("win"):
        appdata = os.environ.get("APPDATA", str(Path.home() / "AppData" / "Roaming"))
        return Path(appdata) / "Microsoft" / "Windows" / "Start Menu" / "Programs" / "Startup" / "switch-tray.bat"
    elif sys.platform == "darwin":
        return Path.home() / "Library" / "LaunchAgents" / "com.user.switch-tray.plist"
    else:  # Linux / Unix
        xdg_config = os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))
        return Path(xdg_config) / "autostart" / "switch-tray.desktop"


def is_autostart_enabled() -> bool:
    return get_autostart_path().is_file()


def enable_autostart() -> bool:
    p = get_autostart_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    try:
        if sys.platform.startswith("win"):
            p.write_text(
                '@echo off\nstart "" pythonw "%USERPROFILE%\\.local\\bin\\switch-tray"\n',
                encoding="utf-8",
            )
        elif sys.platform == "darwin":
            content = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.switch-tray</string>
    <key>ProgramArguments</key>
    <array>
        <string>{sys.executable}</string>
        <string>{Path.home()}/.local/bin/switch-tray</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>"""
            p.write_text(content, encoding="utf-8")
        else:  # Linux
            content = (
                "[Desktop Entry]\n"
                "Type=Application\n"
                "Version=1.0\n"
                "Name=CLI Account Switch Tray\n"
                "GenericName=AI Agent Token Monitor\n"
                "Comment=Monitor de tokens y cuotas en la barra de tareas\n"
                "Exec=sh -c 'PATH=\"$HOME/.local/bin:$PATH\" switch-tray'\n"
                "Icon=utilities-system-monitor\n"
                "Terminal=false\n"
                "Categories=Utility;Development;\n"
                "X-GNOME-Autostart-enabled=true\n"
                "StartupNotify=false\n"
            )
            p.write_text(content, encoding="utf-8")
            p.chmod(0o644)
        return True
    except Exception as e:
        print(f"Error al habilitar autostart: {e}", file=sys.stderr)
        return False


def disable_autostart() -> bool:
    p = get_autostart_path()
    try:
        if p.is_file():
            p.unlink()
        return True
    except Exception as e:
        print(f"Error al deshabilitar autostart: {e}", file=sys.stderr)
        return False


# ==============================================================================
# GESTIÓN DE PROCESO EN SEGUNDO PLANO Y PID
# ==============================================================================

def get_pid_file() -> Path:
    run_dir = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    uid_str = str(os.getuid()) if hasattr(os, "getuid") else "user"
    return run_dir / f"switch-tray-{uid_str}.pid"


def is_pid_alive(pid: int) -> bool:
    try:
        stat_file = f"/proc/{pid}/status"
        if os.path.isfile(stat_file):
            with open(stat_file) as f:
                content = f.read()
            if "State:\tZ" in content:
                return False
            return True
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, FileNotFoundError):
        return False
    except PermissionError:
        return True


def get_running_pid() -> int | None:
    pf = get_pid_file()
    if not pf.is_file():
        return None
    try:
        pid = int(pf.read_text().strip())
        if is_pid_alive(pid):
            return pid
        try:
            pf.unlink()
        except Exception:
            pass
        return None
    except Exception:
        return None


def stop_running_instance() -> bool:
    pid = get_running_pid()
    if not pid:
        return False
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(25):
            if not is_pid_alive(pid):
                break
            time.sleep(0.04)
        if is_pid_alive(pid):
            os.kill(pid, signal.SIGKILL)
    except Exception:
        pass
    pf = get_pid_file()
    if pf.is_file():
        try:
            pf.unlink()
        except Exception:
            pass
    return True


# ==============================================================================
# GENERACIÓN DE ICONOS DE ESTADO (SVG)
# ==============================================================================

def ensure_tray_icons() -> dict[str, str]:
    icon_dir = Path.home() / ".local" / "share" / "icons" / "cli-account-switch"
    icon_dir.mkdir(parents=True, exist_ok=True)

    icons = {
        "green": icon_dir / "tray-green.svg",
        "yellow": icon_dir / "tray-yellow.svg",
        "red": icon_dir / "tray-red.svg",
        "error": icon_dir / "tray-error.svg",
    }

    svgs = {
        "green": (
            '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">'
            '<circle cx="12" cy="12" r="10" fill="#10b981" stroke="#059669" stroke-width="2"/>'
            '<circle cx="12" cy="12" r="4.5" fill="#ffffff" opacity="0.95"/>'
            '</svg>'
        ),
        "yellow": (
            '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">'
            '<circle cx="12" cy="12" r="10" fill="#f59e0b" stroke="#d97706" stroke-width="2"/>'
            '<circle cx="12" cy="12" r="4.5" fill="#ffffff" opacity="0.95"/>'
            '</svg>'
        ),
        "red": (
            '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">'
            '<circle cx="12" cy="12" r="10" fill="#ef4444" stroke="#dc2626" stroke-width="2"/>'
            '<circle cx="12" cy="12" r="4.5" fill="#ffffff" opacity="0.95"/>'
            '</svg>'
        ),
        "error": (
            '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">'
            '<circle cx="12" cy="12" r="10" fill="#e11d48" stroke="#9f1239" stroke-width="2"/>'
            '<path d="M12 7v6M12 16v1" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>'
            '</svg>'
        ),
    }

    for k, p in icons.items():
        if not p.is_file():
            try:
                p.write_text(svgs[k], encoding="utf-8")
            except Exception:
                pass

    return {k: str(p) for k, p in icons.items()}


# ==============================================================================
# RECOLECCIÓN DE DATOS DE TOKENS Y CUOTAS (LIGERA Y ASÍNCRONA)
# ==============================================================================

def format_duration(sec: int) -> str:
    if sec <= 0:
        return "reseteado"
    d, sec = divmod(sec, 86400)
    h, sec = divmod(sec, 3600)
    m, _ = divmod(sec, 60)
    if d > 0:
        return f"{d}d {h}h"
    if h > 0:
        return f"{h}h {m}m"
    return f"{m}m"


def fetch_tray_status() -> dict:
    codex_mod = load_cli_module("codex-switch")
    agy_mod = load_cli_module("agy-switch")

    status = {
        "timestamp": int(time.time()),
        "codex": {
            "active_name": "",
            "active_email": "",
            "available_pct": None,
            "weekly_pct": None,
            "reset_str": "",
            "error": None,
            "all_accounts": [],
            "accounts": [],
        },
        "agy": {
            "active_name": "",
            "active_email": "",
            "gemini_pct": None,
            "claude_pct": None,
            "reset_str": "",
            "error": None,
            "all_accounts": [],
            "accounts": [],
        },
    }

    # 1. Codex Quotas (Top 3 cuentas, activa primero)
    if codex_mod:
        try:
            auth_path = codex_mod.get_auth_path()
            cuentas_dir = codex_mod.get_cuentas_dir()
            active_name = codex_mod.find_active_profile_name(cuentas_dir, auth_path)
            status["codex"]["active_name"] = active_name or "sin guardar"
            status["codex"]["active_email"] = codex_mod.decode_account_from_auth(auth_path)

            all_files = sorted(
                cuentas_dir.glob("*.json"),
                key=lambda f: (0 if f.stem == active_name else 1, f.stem.lower()),
            )
            status["codex"]["all_accounts"] = [f.stem for f in all_files]

            files_to_check = all_files[:3]
            is_unsaved_only = False
            if not files_to_check and auth_path.is_file():
                files_to_check = [auth_path]
                is_unsaved_only = True

            def fetch_one_codex(f: Path) -> dict:
                acc_name = "(sin guardar)" if is_unsaved_only else f.stem
                is_act = (acc_name == active_name) or is_unsaved_only
                q = codex_mod.fetch_codex_quota(f, active_profile=active_name)
                acc_info = {
                    "name": acc_name,
                    "is_active": is_act,
                    "email": q.get("email") or codex_mod.decode_account_from_auth(f),
                    "plan": (q.get("plan_type") or "desconocido").upper(),
                    "available_pct": None,
                    "used_pct": None,
                    "weekly_pct": None,
                    "weekly_used_pct": None,
                    "reset_str": "",
                    "weekly_reset_str": "",
                    "error": q.get("err_msg"),
                }
                rate = q.get("rate_limit") or {}
                pw = rate.get("primary_window")
                sw = rate.get("secondary_window")
                if pw:
                    used = int(pw.get("used_percent", 0))
                    acc_info["used_pct"] = used
                    acc_info["available_pct"] = max(0, 100 - used)
                    acc_info["reset_str"] = format_duration(int(pw.get("reset_after_seconds", 0)))
                if sw:
                    s_used = int(sw.get("used_percent", 0))
                    acc_info["weekly_used_pct"] = s_used
                    acc_info["weekly_pct"] = max(0, 100 - s_used)
                    acc_info["weekly_reset_str"] = format_duration(int(sw.get("reset_after_seconds", 0)))
                elif pw and pw.get("limit_window_seconds", 0) >= 86400 * 5:
                    acc_info["weekly_pct"] = acc_info["available_pct"]
                    acc_info["weekly_used_pct"] = acc_info["used_pct"]
                    acc_info["weekly_reset_str"] = acc_info["reset_str"]
                return acc_info

            with ThreadPoolExecutor(max_workers=min(len(files_to_check), 4) or 1) as pool:
                codex_accs = list(pool.map(fetch_one_codex, files_to_check))

            status["codex"]["accounts"] = codex_accs

            active_acc = next((a for a in codex_accs if a["is_active"]), None) or (codex_accs[0] if codex_accs else None)
            if active_acc:
                status["codex"]["available_pct"] = active_acc.get("available_pct")
                status["codex"]["weekly_pct"] = active_acc.get("weekly_pct")
                status["codex"]["reset_str"] = active_acc.get("reset_str", "")
                status["codex"]["error"] = active_acc.get("error")
        except Exception as e:
            status["codex"]["error"] = str(e)

    # 2. AGY Quotas (Top 3 cuentas, activa primero)
    if agy_mod:
        try:
            token_path = agy_mod.get_token_path()
            cuentas_dir = agy_mod.get_cuentas_dir()
            active_name = agy_mod.find_active_profile_name(cuentas_dir, token_path)
            status["agy"]["active_name"] = active_name or "sin guardar"
            status["agy"]["active_email"] = agy_mod.decode_email_from_token(token_path)

            all_files = sorted(
                cuentas_dir.glob("*.token"),
                key=lambda f: (0 if f.stem == active_name else 1, f.stem.lower()),
            )
            status["agy"]["all_accounts"] = [f.stem for f in all_files]

            files_to_check = all_files[:3]
            is_unsaved_only = False
            if not files_to_check and token_path.is_file():
                files_to_check = [token_path]
                is_unsaved_only = True

            now_dt = datetime.now(timezone.utc)

            def fetch_one_agy(f: Path) -> dict:
                acc_name = "(sin guardar)" if is_unsaved_only else f.stem
                is_act = (acc_name == active_name) or is_unsaved_only
                q = agy_mod.fetch_agy_quota(f, active_profile=active_name)
                acc_info = {
                    "name": acc_name,
                    "is_active": is_act,
                    "email": q.get("email") or agy_mod.decode_email_from_token(f),
                    "plan": (q.get("plan") or "Antigravity").upper(),
                    "gemini_pct": None,
                    "gemini_used_pct": None,
                    "claude_pct": None,
                    "claude_used_pct": None,
                    "reset_str": "",
                    "claude_reset_str": "",
                    "error": q.get("err_msg"),
                }
                models = q.get("models") or {}
                gm = (
                    models.get("gemini-2.5-flash")
                    or models.get("gemini-2.5-pro")
                    or models.get("gemini-3-flash")
                    or models.get("gemini-3.5-flash-lite")
                    or {}
                )
                g_q = gm.get("quotaInfo", {})
                if "remainingFraction" in g_q:
                    g_frac = float(g_q.get("remainingFraction", 1.0))
                    g_rem = int(round(g_frac * 100))
                    acc_info["gemini_pct"] = g_rem
                    acc_info["gemini_used_pct"] = max(0, 100 - g_rem)
                    g_res = g_q.get("resetTime", "")
                    if g_res:
                        try:
                            dt = datetime.fromisoformat(g_res.replace("Z", "+00:00"))
                            sec = max(0, int((dt - now_dt).total_seconds()))
                            acc_info["reset_str"] = format_duration(sec)
                        except Exception:
                            pass

                cl = (
                    models.get("claude-sonnet-5-5-high")
                    or models.get("claude-sonnet-5-5-medium")
                    or models.get("claude-opus-5-5-medium")
                    or models.get("claude-opus-5-5-high")
                    or models.get("claude-opus-4-6-thinking")
                    or {}
                )
                c_q = cl.get("quotaInfo", {})
                if "remainingFraction" in c_q:
                    c_frac = float(c_q.get("remainingFraction", 1.0))
                    c_rem = int(round(c_frac * 100))
                    acc_info["claude_pct"] = c_rem
                    acc_info["claude_used_pct"] = max(0, 100 - c_rem)
                    c_res = c_q.get("resetTime", "")
                    if c_res:
                        try:
                            dt = datetime.fromisoformat(c_res.replace("Z", "+00:00"))
                            sec = max(0, int((dt - now_dt).total_seconds()))
                            acc_info["claude_reset_str"] = format_duration(sec)
                        except Exception:
                            pass

                return acc_info

            with ThreadPoolExecutor(max_workers=min(len(files_to_check), 4) or 1) as pool:
                agy_accs = list(pool.map(fetch_one_agy, files_to_check))

            status["agy"]["accounts"] = agy_accs

            active_acc = next((a for a in agy_accs if a["is_active"]), None) or (agy_accs[0] if agy_accs else None)
            if active_acc:
                status["agy"]["gemini_pct"] = active_acc.get("gemini_pct")
                status["agy"]["claude_pct"] = active_acc.get("claude_pct")
                status["agy"]["reset_str"] = active_acc.get("reset_str", "")
                status["agy"]["error"] = active_acc.get("error")
        except Exception as e:
            status["agy"]["error"] = str(e)

    return status


# ==============================================================================
# IMPLEMENTACIÓN NATIVA EN LINUX CON AYATANA / APPINDICATOR (GTK3)
# ==============================================================================

# ==============================================================================
# IMPLEMENTACIÓN NATIVA EN LINUX CON AYATANA / APPINDICATOR (GTK3)
# ==============================================================================

def format_account_label(provider: str, acc: dict) -> str:
    """
    Formato de cuenta para el menú del tray:
    - Activa: '✓ nombre · uso restante | restante semanal'
    - Inactiva: '  nombre · uso restante | restante semanal'
    """
    name = acc.get("name", "")
    is_act = acc.get("is_active", False)
    prefix = "✓ " if is_act else "  "
    err = acc.get("error")

    if err:
        return f"{prefix}{name} · ⚠️ {err}"

    if provider == "codex":
        c_pct = acc.get("available_pct")
        w_pct = acc.get("weekly_pct")

        parts = []
        if c_pct is not None:
            parts.append(f"{c_pct}%")
        if w_pct is not None:
            parts.append(f"{w_pct}% sem")

        pct_text = " | ".join(parts) if parts else "N/A"
        return f"{prefix}{name} · {pct_text}"
    else:  # agy
        g_pct = acc.get("gemini_pct")
        c_pct = acc.get("claude_pct")

        parts = []
        if g_pct is not None:
            parts.append(f"{g_pct}%")
        if c_pct is not None:
            parts.append(f"{c_pct}% sem")

        pct_text = " | ".join(parts) if parts else "N/A"
        return f"{prefix}{name} · {pct_text}"


class LinuxAppIndicatorTray:
    def __init__(self, interval: int = 300):
        self.interval = max(30, interval)
        self.icons = ensure_tray_icons()
        self.current_status: dict = {}
        self.indicator = None
        self.Gtk = None
        self.GLib = None

    def start(self):
        import gi
        gi.require_version("Gtk", "3.0")
        has_ayatana = False
        try:
            gi.require_version("AyatanaAppIndicator3", "0.1")
            from gi.repository import AyatanaAppIndicator3 as AppIndicator
            has_ayatana = True
        except (ValueError, ImportError):
            try:
                gi.require_version("AppIndicator3", "0.1")
                from gi.repository import AppIndicator3 as AppIndicator
            except (ValueError, ImportError):
                print("❌ No se encontró AyatanaAppIndicator3 ni AppIndicator3.", file=sys.stderr)
                print("   Instala: sudo apt install gir12.1-ayatanaappindicator3-0.1", file=sys.stderr)
                sys.exit(1)

        from gi.repository import Gtk, GLib

        self.Gtk = Gtk
        self.GLib = GLib

        # Verificar si hay una pantalla gráfica accesible
        success, _ = Gtk.init_check(None)
        if not success:
            print("⚠️ No se detectó un servidor gráfico (DISPLAY no configurado).", file=sys.stderr)
            print("   Si estás en SSH, ejecuta switch-tray en tu sesión de escritorio gráfica.", file=sys.stderr)
            print("   O habilita el auto-arranque con: switch-tray --autostart enable", file=sys.stderr)
            sys.exit(1)

        initial_icon = self.icons.get("green", "utilities-system-monitor")
        self.indicator = AppIndicator.Indicator.new(
            "cli-account-switch-tray",
            initial_icon,
            AppIndicator.IndicatorCategory.APPLICATION_STATUS,
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("Switch")

        # Construir menú inicial
        self.menu = Gtk.Menu()
        self.indicator.set_menu(self.menu)

        # Iniciar hilo de recolección en segundo plano
        t = threading.Thread(target=self._worker_loop, daemon=True)
        t.start()

        # Iniciar loop principal de GTK
        Gtk.main()

    def _worker_loop(self):
        while True:
            data = fetch_tray_status()
            self.GLib.idle_add(self._apply_data, data)
            time.sleep(self.interval)

    def trigger_refresh(self):
        def worker():
            data = fetch_tray_status()
            self.GLib.idle_add(self._apply_data, data)
        threading.Thread(target=worker, daemon=True).start()

    def _apply_data(self, data: dict):
        self.current_status = data
        codex = data.get("codex", {})
        agy = data.get("agy", {})

        c_pct = codex.get("available_pct")
        g_pct = agy.get("gemini_pct")

        # Texto del panel en la barra de tareas
        labels = []
        if c_pct is not None:
            labels.append(f"Codex: {c_pct}%")
        elif codex.get("error"):
            labels.append("Codex: ⚠️")

        if g_pct is not None:
            labels.append(f"AGY: {g_pct}%")
        elif agy.get("error"):
            labels.append("AGY: ⚠️")

        panel_text = " | ".join(labels) if labels else "AI Tokens"
        self.indicator.set_label(panel_text, "Codex: 100% | AGY: 100%")

        # Determinar icono según el peor porcentaje
        all_pcts = [p for p in (c_pct, g_pct) if p is not None]
        if codex.get("error") or agy.get("error"):
            icon_key = "error"
        elif not all_pcts:
            icon_key = "yellow"
        elif min(all_pcts) <= 15:
            icon_key = "red"
        elif min(all_pcts) <= 40:
            icon_key = "yellow"
        else:
            icon_key = "green"

        icon_path = self.icons.get(icon_key, "utilities-system-monitor")
        self.indicator.set_icon_full(icon_path, panel_text)

        # Reconstruir menú desplegable
        self._rebuild_menu()

    def _create_account_item(self, provider: str, acc: dict):
        if not self.Gtk:
            import gi
            gi.require_version("Gtk", "3.0")
            from gi.repository import Gtk
            self.Gtk = Gtk
        Gtk = self.Gtk

        label = format_account_label(provider, acc)
        item = Gtk.MenuItem(label=label)
        is_act = acc.get("is_active", False)
        name = acc.get("name", "")

        if not is_act and not name.startswith("("):
            item.connect("activate", self._make_switch_cb(provider, name))
        else:
            item.set_sensitive(False)

        return item

    def _rebuild_menu(self):
        if not self.Gtk:
            import gi
            gi.require_version("Gtk", "3.0")
            from gi.repository import Gtk
            self.Gtk = Gtk
        Gtk = self.Gtk
        menu = Gtk.Menu()
        codex = self.current_status.get("codex", {})
        agy = self.current_status.get("agy", {})

        # ==========================================
        # SECCIÓN 1: OPENAI CODEX
        # ==========================================
        h_codex = Gtk.MenuItem(label="--------- Codex ---------")
        h_codex.set_sensitive(False)
        menu.append(h_codex)

        c_accounts = (codex.get("accounts") or [])[:3]
        if not c_accounts:
            empty_c = Gtk.MenuItem(label="  (Sin cuentas guardadas)")
            empty_c.set_sensitive(False)
            menu.append(empty_c)
        else:
            for acc in c_accounts:
                menu.append(self._create_account_item("codex", acc))

        menu.append(Gtk.SeparatorMenuItem())

        # ==========================================
        # SECCIÓN 2: GOOGLE AGY
        # ==========================================
        h_agy = Gtk.MenuItem(label="---------- AGY ----------")
        h_agy.set_sensitive(False)
        menu.append(h_agy)

        a_accounts = (agy.get("accounts") or [])[:3]
        if not a_accounts:
            empty_a = Gtk.MenuItem(label="  (Sin cuentas guardadas)")
            empty_a.set_sensitive(False)
            menu.append(empty_a)
        else:
            for acc in a_accounts:
                menu.append(self._create_account_item("agy", acc))

        menu.append(Gtk.SeparatorMenuItem())

        # ==========================================
        # ÚNICO BOTÓN EXTRA: ABRIR MONITOR
        # ==========================================
        item_monitor = Gtk.MenuItem(label="📊 Abrir Monitor")
        item_monitor.connect("activate", lambda _: self._open_full_widget())
        menu.append(item_monitor)

        menu.show_all()
        self.menu = menu
        if self.indicator:
            self.indicator.set_menu(menu)

    def _make_switch_cb(self, provider: str, account: str):
        def cb(_):
            def worker():
                mod_name = "codex-switch" if provider == "codex" else "agy-switch"
                mod = load_cli_module(mod_name)
                if mod and hasattr(mod, "find_running_clients"):
                    try:
                        running = mod.find_running_clients(provider)
                        if running:
                            # Notificar conflicto de sesiones en la consola/registro
                            print(f"⚠️ Advertencia: Sesiones activas de {provider} en pts/. Conmutación abortada.")
                            return
                    except Exception:
                        pass

                exe = find_module_file(mod_name)
                if exe:
                    subprocess.run([sys.executable, str(exe), "usar", account], capture_output=True)
                    self.trigger_refresh()
            threading.Thread(target=worker, daemon=True).start()
        return cb

    def _open_full_widget(self):
        w_exe = find_module_file("switch-widget")
        if w_exe:
            subprocess.Popen([sys.executable, str(w_exe)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _toggle_autostart(self, _):
        if is_autostart_enabled():
            disable_autostart()
        else:
            enable_autostart()
        self._rebuild_menu()


# ==============================================================================
# FALLBACK: PYSTRAY (WINDOWS / MACOS)
# ==============================================================================

class PystrayFallbackTray:
    def __init__(self, interval: int = 300):
        self.interval = max(30, interval)

    def start(self):
        try:
            import pystray
            from PIL import Image, ImageDraw
        except ImportError:
            print("❌ Para usar el widget de bandeja en Windows/macOS, instala pystray:")
            print("   pip install pystray pillow")
            sys.exit(1)

        def create_image(color: str):
            image = Image.new("RGBA", (64, 64), (0, 0, 0, 0))
            draw = ImageDraw.Draw(image)
            draw.ellipse((8, 8, 56, 56), fill=color, outline="#ffffff")
            return image

        def on_exit(icon, _):
            icon.stop()

        def on_open_widget(icon, _):
            w_exe = find_module_file("switch-widget")
            if w_exe:
                subprocess.Popen([sys.executable, str(w_exe)])

        icon = pystray.Icon(
            "cli-account-switch",
            create_image("#10b981"),
            "CLI Account Switch",
            menu=pystray.Menu(
                pystray.MenuItem("📊 Abrir Monitor", on_open_widget),
                pystray.MenuItem("↻ Actualizar", lambda icon, item: self.trigger_refresh()),
            ),
        )

        icon.run()


# ==============================================================================
# VISTA PREVIA DEL WIDGET INCRUSTADO (--preview y --preview-image)
# ==============================================================================

def run_preview(output_image: str | None = None):
    """
    Despliega la vista previa exacta del menú del tray con datos de ejemplo:
    - Encabezados centrados '--------- Codex ---------' y '---------- AGY ----------'
    - Cuentas con '✓ ' para activa, '  ' para inactiva, uso restante | restante semanal
    - Único botón extra debajo: '📊 Abrir Monitor'
    """
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk

    success, _ = Gtk.init_check(None)
    if not success and not output_image:
        print("⚠️ No se detectó un servidor gráfico activo (DISPLAY no configurado).", file=sys.stderr)
        sys.exit(1)

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_title("CLI Account Switch · Tray Menu Preview")
    win.set_default_size(280, 290)
    win.set_position(Gtk.WindowPosition.CENTER)

    vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
    vbox.set_margin_top(10)
    vbox.set_margin_bottom(10)
    vbox.set_margin_start(14)
    vbox.set_margin_end(14)

    # 1. Codex
    l_c = Gtk.Label(label="--------- Codex ---------")
    l_c.set_xalign(0.5)
    vbox.pack_start(l_c, False, False, 2)

    vbox.pack_start(Gtk.Label(label="✓ principal · 85% | 72% sem", xalign=0.0), False, False, 2)
    vbox.pack_start(Gtk.Label(label="  secundaria · 42% | 38% sem", xalign=0.0), False, False, 2)
    vbox.pack_start(Gtk.Label(label="  backup · 12% | 15% sem", xalign=0.0), False, False, 2)

    vbox.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 6)

    # 2. AGY
    l_a = Gtk.Label(label="---------- AGY ----------")
    l_a.set_xalign(0.5)
    vbox.pack_start(l_a, False, False, 2)

    vbox.pack_start(Gtk.Label(label="✓ trabajo · 92% | 88% sem", xalign=0.0), False, False, 2)
    vbox.pack_start(Gtk.Label(label="  personal · 60% | 45% sem", xalign=0.0), False, False, 2)
    vbox.pack_start(Gtk.Label(label="  dev-team · 18% | 15% sem", xalign=0.0), False, False, 2)

    vbox.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 6)

    # 3. Único botón extra debajo: Abrir Monitor
    btn = Gtk.Button(label="📊 Abrir Monitor")
    btn.connect("clicked", lambda _: print("📊 Abrir Monitor..."))
    vbox.pack_start(btn, False, False, 4)

    win.add(vbox)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()

    if output_image:
        try:
            import cairo
            while Gtk.events_pending():
                Gtk.main_iteration()
            alloc = win.get_allocation()
            surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, alloc.width, alloc.height)
            cr = cairo.Context(surface)
            win.draw(cr)
            surface.write_to_png(output_image)
            print(f"✅ Vista previa PNG generada exitosamente en: {output_image}")
        except Exception as e:
            print(f"❌ Error al renderizar imagen de vista previa: {e}", file=sys.stderr)
        return

    print("Mostrando vista previa del menú del tray en pantalla. Presiona Ctrl+C o cierra la ventana para salir.")
    try:
        Gtk.main()
    except KeyboardInterrupt:
        pass


# ==============================================================================
# PUNTO DE ENTRADA PRINCIPAL
# ==============================================================================

def main():
    parser = argparse.ArgumentParser(
        description="CLI Account Switch · Taskbar Widget (Monitor de tokens en barra de tareas con bajo consumo)"
    )
    parser.add_argument(
        "action",
        nargs="?",
        choices=["start", "stop", "restart", "status"],
        default=None,
        help="Acción a realizar: start (por defecto, en 2º plano), stop, restart o status",
    )
    parser.add_argument("-v", "--version", action="version", version=f"CLI Account Switch Taskbar Widget v{VERSION}")
    parser.add_argument("-i", "--interval", type=int, default=300, help="Intervalo de consulta en segundos (por defecto 300s = 5 min)")
    parser.add_argument("--autostart", choices=["enable", "disable", "status"], help="Gestionar auto-inicio al encender la computadora")
    parser.add_argument("--status", action="store_true", help="Consultar estado rápido en la terminal y salir")
    parser.add_argument("--stop", action="store_true", help="Detener cualquier instancia activa del widget de bandeja")
    parser.add_argument("--restart", action="store_true", help="Reiniciar el widget de bandeja en segundo plano")
    parser.add_argument("-f", "--foreground", action="store_true", help="Ejecutar en primer plano vinculado a la terminal (depuración)")
    parser.add_argument("--internal-run", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--daemon", action="store_true", help="Modo servicio de fondo continuo")
    parser.add_argument("--preview", action="store_true", help="Mostrar ventana de vista previa del widget incrustado con datos de ejemplo")
    parser.add_argument("--preview-image", type=str, metavar="RUTA", help="Generar imagen PNG con la vista previa del widget incrustado y salir")

    args = parser.parse_args()

    # 1. Vista previa interactiva o exportación de imagen
    if args.preview or args.preview_image:
        run_preview(output_image=args.preview_image)
        return

    # 2. Detener proceso en segundo plano (stop)
    if args.action == "stop" or args.stop:
        stopped = stop_running_instance()
        if stopped:
            print("✅ Widget de barra de tareas detenido correctamente.")
        else:
            print("ℹ️ El widget de barra de tareas no estaba en ejecución.")
        return

    # 3. Reiniciar (restart)
    if args.action == "restart" or args.restart:
        stopped = stop_running_instance()
        if stopped:
            print("🔄 Instancia previa detenida.")

    # 4. Gestión de Autostart
    if args.autostart:
        if args.autostart == "enable":
            ok = enable_autostart()
            if ok:
                print(f"✅ Auto-inicio habilitado: {get_autostart_path()}")
            else:
                sys.exit(1)
        elif args.autostart == "disable":
            ok = disable_autostart()
            if ok:
                print("✅ Auto-inicio deshabilitado.")
            else:
                sys.exit(1)
        elif args.autostart == "status":
            enabled = is_autostart_enabled()
            st_text = "\033[1;32mHABILITADO\033[0m" if enabled else "\033[1;33mDESHABILITADO\033[0m"
            print(f"Auto-inicio con la computadora: {st_text}")
            print(f"Archivo de configuración: {get_autostart_path()}")
        return

    # 5. Consulta rápida en terminal (status)
    if args.action == "status" or args.status:
        data = fetch_tray_status()
        codex = data.get("codex", {})
        agy = data.get("agy", {})

        print("\n╭─────────────────────────────────────────────────────────────╮")
        print("│  ✦ Estado de Tokens por Proveedor (Top 3 Cuentas)           │")
        print("╰─────────────────────────────────────────────────────────────╯")

        print("\n  \033[1;32m🟢 OPENAI CODEX (Máximo 3 cuentas)\033[0m")
        c_accs = codex.get("accounts") or []
        if not c_accs:
            print("    (No hay cuentas guardadas. Usa: codex-switch guardar <nombre>)")
        for acc in c_accs:
            name = acc.get("name")
            is_act = acc.get("is_active")
            email = acc.get("email") or "Sin email"
            plan = acc.get("plan") or "ESTÁNDAR"
            star = "\033[1;33m★ [ACTIVA]\033[0m" if is_act else " " * 10
            print(f"  {star} \033[1m{name:16}\033[0m \033[2m{email}\033[0m [{plan}]")
            if acc.get("error"):
                print(f"              ⚠️  \033[1;31m{acc.get('error')}\033[0m")
            else:
                c_pct = acc.get("available_pct", 0) if acc.get("available_pct") is not None else "N/A"
                c_used = acc.get("used_pct", 0) if acc.get("used_pct") is not None else "N/A"
                c_res = acc.get("reset_str") or "reseteado"
                w_pct = acc.get("weekly_pct", 0) if acc.get("weekly_pct") is not None else "N/A"
                w_used = acc.get("weekly_used_pct", 0) if acc.get("weekly_used_pct") is not None else "N/A"
                w_res = acc.get("weekly_reset_str") or "reseteado"
                print(f"              • Estado Actual  (5h) : \033[1m{c_pct}%\033[0m disp · {c_used}% usado (resetea en: {c_res})")
                print(f"              • Estado Semanal (7d) : \033[1m{w_pct}%\033[0m disp · {w_used}% usado (resetea en: {w_res})")

        print("\n  \033[1;35m🟣 GOOGLE ANTIGRAVITY (Máximo 3 cuentas)\033[0m")
        a_accs = agy.get("accounts") or []
        if not a_accs:
            print("    (No hay cuentas guardadas. Usa: agy-switch guardar <nombre>)")
        for acc in a_accs:
            name = acc.get("name")
            is_act = acc.get("is_active")
            email = acc.get("email") or "Sin email"
            plan = acc.get("plan") or "ANTIGRAVITY"
            star = "\033[1;33m★ [ACTIVA]\033[0m" if is_act else " " * 10
            print(f"  {star} \033[1m{name:16}\033[0m \033[2m{email}\033[0m [{plan}]")
            if acc.get("error"):
                print(f"              ⚠️  \033[1;31m{acc.get('error')}\033[0m")
            else:
                g_pct = acc.get("gemini_pct", 0) if acc.get("gemini_pct") is not None else "N/A"
                g_used = acc.get("gemini_used_pct", 0) if acc.get("gemini_used_pct") is not None else "N/A"
                g_res = acc.get("reset_str") or "reseteado"
                c_pct = acc.get("claude_pct", 0) if acc.get("claude_pct") is not None else "N/A"
                c_used = acc.get("claude_used_pct", 0) if acc.get("claude_used_pct") is not None else "N/A"
                c_res = acc.get("claude_reset_str") or "reseteado"
                print(f"              • Gemini Models (5h)  : \033[1m{g_pct}%\033[0m disp · {g_used}% usado (resetea en: {g_res})")
                print(f"              • Claude 3P / Semanal : \033[1m{c_pct}%\033[0m disp · {c_used}% usado (resetea en: {c_res})")

        running_pid = get_running_pid()
        st_proc = f"\033[1;32mACTIVO\033[0m (PID: {running_pid})" if running_pid else "\033[1;33mDETENIDO\033[0m"
        print(f"\n  • Estado del widget de bandeja: {st_proc}")
        print(f"  • Auto-inicio al encender PC  : {'\033[1;32mHABILITADO\033[0m' if is_autostart_enabled() else '\033[1;33mDESHABILITADO\033[0m'}\n")
        return

    # 6. Modo interno (Worker desvinculado en segundo plano)
    if args.internal_run:
        pid_file = get_pid_file()
        pid_file.parent.mkdir(parents=True, exist_ok=True)
        pid_file.write_text(str(os.getpid()))
        atexit.register(lambda: pid_file.unlink(missing_ok=True) if pid_file.is_file() else None)

        if hasattr(signal, "SIGHUP"):
            signal.signal(signal.SIGHUP, signal.SIG_IGN)

        if not sys.platform.startswith("win") and sys.platform != "darwin":
            tray = LinuxAppIndicatorTray(interval=args.interval)
            tray.start()
        else:
            tray = PystrayFallbackTray(interval=args.interval)
            tray.start()
        return

    # 7. Modo en primer plano (adjunto a la terminal si se especifica -f/--foreground)
    if args.foreground:
        pid_file = get_pid_file()
        pid_file.parent.mkdir(parents=True, exist_ok=True)
        pid_file.write_text(str(os.getpid()))
        atexit.register(lambda: pid_file.unlink(missing_ok=True) if pid_file.is_file() else None)

        print("Iniciando widget en la barra de tareas en PRIMER PLANO...")
        print(f"  • Intervalo de chequeo: {args.interval}s")
        print(f"  • Auto-inicio con el sistema: {'Activado' if is_autostart_enabled() else 'Desactivado'}")
        print("  💡 (Para ejecutar en segundo plano y poder cerrar la terminal, usa: switch tray)")

        if not sys.platform.startswith("win") and sys.platform != "darwin":
            tray = LinuxAppIndicatorTray(interval=args.interval)
            try:
                tray.start()
            except KeyboardInterrupt:
                print("\nCerrando widget de bandeja...")
        else:
            tray = PystrayFallbackTray(interval=args.interval)
            try:
                tray.start()
            except KeyboardInterrupt:
                print("\nCerrando widget de bandeja...")
        return

    # 8. MODO PREDETERMINADO: Inicio en segundo plano desvinculado (Daemon)
    running_pid = get_running_pid()
    if running_pid:
        print(f"ℹ️ El widget de barra de tareas ya está activo en segundo plano (PID: \033[1;32m{running_pid}\033[0m).")
        print("   • Para reiniciarlo: \033[1;33mswitch tray restart\033[0m")
        print("   • Para detenerlo  : \033[1;31mswitch tray stop\033[0m")
        return

    script_path = Path(__file__).resolve()
    cmd = [sys.executable, str(script_path), "--internal-run", "-i", str(args.interval)]

    if sys.platform.startswith("win"):
        creationflags = getattr(subprocess, "DETACHED_PROCESS", 0) | getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            creationflags=creationflags,
        )
    else:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

    get_pid_file().write_text(str(proc.pid))
    print("╭─────────────────────────────────────────────────────────────╮")
    print("│  ✦ CLI Account Switch · Widget de Barra de Tareas           │")
    print("╰─────────────────────────────────────────────────────────────╯")
    print(f"  ✅ Widget incrustado iniciado en segundo plano (PID: \033[1;32m{proc.pid}\033[0m).")
    print("  🔒 \033[1mPermanecerá activo en tu panel aunque cierres esta terminal.\033[0m\n")
    print("  • Para consultar estado : \033[1;36mswitch tray status\033[0m")
    print("  • Para reiniciar        : \033[1;33mswitch tray restart\033[0m")
    print("  • Para detener          : \033[1;31mswitch tray stop\033[0m")
    print(f"  • Inicio con el sistema : {'\033[1;32mActivado\033[0m' if is_autostart_enabled() else '\033[1;33mDesactivado\033[0m (usa: switch tray --autostart enable)'}\n")


if __name__ == "__main__":
    main()
