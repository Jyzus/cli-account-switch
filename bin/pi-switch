#!/usr/bin/env python3
"""
pi-switch: Gestor de multi-cuenta y telemetría para Pi Coding Agent (harness `pi`).

Modelo de integración
=====================
Pi guarda todas sus credenciales (API keys y tokens OAuth por proveedor) en un
único archivo `auth.json` dentro del directorio de agente, que por defecto es
`~/.pi/agent` y puede reubicarse con la variable de entorno `PI_CODING_AGENT_DIR`.

Switch aplica por tanto el modelo de intercambio de archivo (igual que Codex/AGY):

  - `guardar <alias>`  → snapshot de auth.json en `~/.pi/agent/cuentas/<alias>.json`.
  - `usar <alias>`     → conmutación atómica del perfil activo (sync bidireccional
                          del perfil saliente antes de conmutar + `.active_profile`).
  - `login <alias> [proveedor]` → invoca `pi auth login <proveedor>` nativo y guarda
                          la sesión resultante en el perfil indicado.
  - `paralelo <alias>` → ejecución concurrente aislada mediante `PI_CODING_AGENT_DIR`
                          en un runtime temporal (lease lock por alias e identidad).

Telemetría:
  Pi no expone un endpoint HTTP de saldo o cuota, por lo que `saldo` y `rate_limit`
  se reportan siempre como None (unsupported_capability; nunca se inventa cuota).
  El campo `tokens` sí lleva el consumo REAL agregado (coste y tokens) leído de los
  archivos de sesión JSONL en `~/.pi/agent/sessions/`.

Compatible con el contrato headless JSON de la suite Switch (protocol_version 1).
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

VERSION = "1.3.0"
GITHUB_REPO = "Jyzus/cli-account-switch"

PROVIDER_ID = "pi"
PROVIDER_NAME = "Pi Coding Agent"

try:
    import fcntl  # type: ignore
except ImportError:  # pragma: no cover (Windows)
    fcntl = None


def validate_alias(nombre: str):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", nombre):
        print("❌ Alias inválido: usa de 1 a 64 letras, números, puntos, guiones o guiones bajos; empieza con letra o número.")
        sys.exit(2)


# ==============================================================================
# 1. UBICACIÓN DE PI (DIRECTORIO DE AGENTE Y ARCHIVO DE CREDENCIALES)
# ==============================================================================

def get_agent_dir() -> Path:
    """Directorio de agente de Pi: PI_CODING_AGENT_DIR o ~/.pi/agent."""
    env_override = os.environ.get("PI_CODING_AGENT_DIR")
    if env_override:
        return Path(env_override).expanduser()
    return Path.home() / ".pi" / "agent"


def get_auth_path() -> Path:
    """Archivo de credenciales activo que lee Pi (auth.json)."""
    return get_agent_dir() / "auth.json"


def get_base_dir() -> Path:
    return get_agent_dir()


def get_cuentas_dir() -> Path:
    """Directorio donde Switch persiste los snapshots de auth.json por alias."""
    d = get_agent_dir() / "cuentas"
    d.mkdir(parents=True, exist_ok=True)
    try:
        d.chmod(0o700)
    except Exception:
        pass
    return d


def get_active_profile_marker() -> Path:
    return get_agent_dir() / ".active_profile"


def get_locks_dir() -> Path:
    d = get_agent_dir() / ".locks"
    d.mkdir(parents=True, exist_ok=True)
    try:
        d.chmod(0o700)
    except Exception:
        pass
    return d


def get_sessions_dir() -> Path:
    return get_agent_dir() / "sessions"


def find_pi_bin() -> str | None:
    """Localiza el ejecutable de Pi."""
    for name in ("pi", "pi-coding-agent"):
        which = shutil.which(name)
        if which:
            return which
    for p in (
        Path.home() / ".pi" / "agent" / "bin" / "pi",
        Path.home() / ".local" / "bin" / "pi",
        Path("/usr/local/bin") / "pi",
        Path("/usr/bin") / "pi",
    ):
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
    return None


# ==============================================================================
# 2. PERFIL ACTIVO, SINCRONIZACIÓN BIDIRECCIONAL Y COPIA SEGURA
# ==============================================================================

def get_recorded_active_profile() -> str:
    marker = get_active_profile_marker()
    if marker.is_file():
        try:
            val = marker.read_text(encoding="utf-8").strip()
            if val and (get_cuentas_dir() / f"{val}.json").is_file():
                return val
        except Exception:
            pass
    return ""


def set_recorded_active_profile(nombre: str):
    marker = get_active_profile_marker()
    try:
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.write_text(nombre.strip() + "\n", encoding="utf-8")
        os.chmod(marker, 0o600)
    except Exception:
        pass


def clear_recorded_active_profile():
    marker = get_active_profile_marker()
    if marker.is_file():
        try:
            marker.unlink()
        except Exception:
            pass


def private_copy(src: Path, dst: Path):
    """Copia atómica preservando permisos restrictivos 0600."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    temp_dst = dst.with_name(f"{dst.name}.tmp.{os.getpid()}")
    shutil.copyfile(src, temp_dst)
    try:
        os.chmod(temp_dst, 0o600)
    except Exception:
        pass
    os.replace(temp_dst, dst)


def sync_active_profile():
    """
    Si el auth.json activo difiere del perfil guardado (token refrescado en vuelo,
    nuevo `pi auth login`…), vuelca los bytes nuevos en `cuentas/<alias>.json`.
    """
    nombre = get_recorded_active_profile()
    if not nombre:
        return
    target_profile = get_cuentas_dir() / f"{nombre}.json"
    auth_file = get_auth_path()
    if auth_file.is_file() and target_profile.is_file():
        try:
            auth_bytes = auth_file.read_bytes()
            profile_bytes = target_profile.read_bytes()
            if auth_bytes != profile_bytes and len(auth_bytes) > 2:
                private_copy(auth_file, target_profile)
        except Exception:
            pass


def find_active_profile_name(cuentas_dir: Path, auth_path: Path) -> str:
    rec = get_recorded_active_profile()
    if rec:
        return rec
    if not auth_path.is_file():
        return ""
    try:
        auth_bytes = auth_path.read_bytes()
        for f in cuentas_dir.glob("*.json"):
            try:
                if f.read_bytes() == auth_bytes:
                    set_recorded_active_profile(f.stem)
                    return f.stem
            except Exception:
                continue
    except Exception:
        pass
    return ""


# ==============================================================================
# 3. IDENTIDAD (auth.json de Pi es un diccionario proveedor -> credencial)
# ==============================================================================

def load_auth_data(auth_file: Path) -> dict:
    if not auth_file.is_file():
        return {}
    try:
        data = json.loads(auth_file.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            return data
    except Exception:
        pass
    return {}


def list_configured_providers(auth_file: Path) -> list[str]:
    """Proveedores con credencial almacenada en un auth.json."""
    data = load_auth_data(auth_file)
    return sorted(
        k for k, v in data.items()
        if isinstance(v, dict) and (v.get("key") or v.get("access") or v.get("refresh") or v.get("tokens"))
    )


def decode_account_from_auth(auth_file: Path) -> str:
    """Etiqueta amigable: proveedores configurados (Pi no guarda email)."""
    providers = list_configured_providers(auth_file)
    if not providers:
        return "Sin credenciales"
    return ", ".join(providers)


def mask_identifier(ident: str) -> str:
    if not ident:
        return "desconocido"
    if "@" in ident:
        user, domain = ident.split("@", 1)
        visible = user[:3] if len(user) >= 3 else user[:1]
        return f"{visible}***@{domain}"
    if len(ident) > 10:
        return f"{ident[:5]}...{ident[-4:]}"
    return ident


def compute_opaque_identity(auth_file: Path) -> str:
    """
    Hash SHA-256 no reversible sobre las credenciales reales (clave o tokens),
    estable entre snapshots del mismo auth.json.
    """
    data = load_auth_data(auth_file)
    parts = []
    for prov in sorted(data.keys()):
        cred = data.get(prov)
        if not isinstance(cred, dict):
            continue
        material = str(cred.get("key") or cred.get("access") or cred.get("refresh") or "")
        if not material and isinstance(cred.get("tokens"), dict):
            tk = cred["tokens"]
            material = str(tk.get("access_token") or tk.get("refresh_token") or "")
        if material:
            parts.append(f"{prov}:{hashlib.sha256(material.encode('utf-8')).hexdigest()[:16]}")
    if not parts:
        return ""
    return hashlib.sha256((f"{PROVIDER_ID}:" + "|".join(parts)).encode("utf-8")).hexdigest()[:16]


# ==============================================================================
# 4. TELEMETRÍA LOCAL DE CONSUMO (SESIONES JSONL DE PI) — SIN CUOTA EXTERNA
# ==============================================================================

MAX_SESSION_FILES = 300


def _acc_usage(totals: dict, provider: str, model: str, usage: dict, counted_files: dict) -> None:
    provider = (provider or "unknown").strip() or "unknown"
    model = (model or "unknown").strip() or "unknown"
    cost = usage.get("cost") or {}
    try:
        c_total = float(cost.get("total", 0) or 0)
        c_input = int(usage.get("input", 0) or 0)
        c_output = int(usage.get("output", 0) or 0)
        c_reason = int(usage.get("reasoning", 0) or 0)
        c_cache_r = int(usage.get("cacheRead", 0) or 0)
        c_cache_w = int(usage.get("cacheWrite", 0) or 0)
    except (TypeError, ValueError):
        return

    prov = totals.setdefault(provider, {
        "cost": 0.0, "input": 0, "output": 0, "reasoning": 0,
        "cache_read": 0, "cache_write": 0, "sessions": 0, "models": {},
    })
    prov["cost"] += c_total
    prov["input"] += c_input
    prov["output"] += c_output
    prov["reasoning"] += c_reason
    prov["cache_read"] += c_cache_r
    prov["cache_write"] += c_cache_w
    if provider not in counted_files:
        counted_files[provider] = set()

    m = prov["models"].setdefault(model, {
        "cost": 0.0, "input": 0, "output": 0, "reasoning": 0,
        "cache_read": 0, "cache_write": 0, "turns": 0,
    })
    m["cost"] += c_total
    m["input"] += c_input
    m["output"] += c_output
    m["reasoning"] += c_reason
    m["cache_read"] += c_cache_r
    m["cache_write"] += c_cache_w
    m["turns"] += 1


def read_usage_totals() -> dict:
    """
    Agrega el consumo real (tokens y coste) desde los archivos de sesión JSONL de Pi.
    Formato documentado: entradas {"type":"message", message:{role:"assistant",
    provider, model, usage{...}}} y {"type":"usage", provider, model, usage{...}}.
    """
    sessions_dir = get_sessions_dir()
    if not sessions_dir.is_dir():
        return {}

    totals: dict = {}
    counted_files: dict = {}
    try:
        files = sorted(sessions_dir.rglob("*.jsonl"), key=lambda p: p.stat().st_mtime)
    except Exception:
        return {}
    files = files[-MAX_SESSION_FILES:]

    for fp in files:
        file_providers_seen = False
        try:
            with open(fp, encoding="utf-8", errors="ignore") as fh:
                for line in fh:
                    line = line.strip()
                    if not line or '"usage"' not in line:
                        continue
                    try:
                        entry = json.loads(line)
                    except Exception:
                        continue
                    etype = entry.get("type")
                    if etype == "message":
                        msg = entry.get("message") or {}
                        if msg.get("role") != "assistant":
                            continue
                        usage = msg.get("usage")
                        if isinstance(usage, dict):
                            _acc_usage(totals, msg.get("provider", ""), msg.get("model", ""), usage, counted_files)
                            file_providers_seen = True
                    elif etype == "usage":
                        usage = entry.get("usage")
                        if isinstance(usage, dict):
                            _acc_usage(totals, entry.get("provider", ""), entry.get("model", ""), usage, counted_files)
                            file_providers_seen = True
        except Exception:
            continue
        if file_providers_seen:
            for prov in totals:
                counted_files.setdefault(prov, set()).add(str(fp))

    for prov, t in totals.items():
        t["sessions"] = len(counted_files.get(prov, set()))
    return totals


def sessions_freshness_iso() -> str:
    d = get_sessions_dir()
    newest = 0.0
    if d.is_dir():
        try:
            for fp in d.rglob("*.jsonl"):
                try:
                    newest = max(newest, fp.stat().st_mtime)
                except Exception:
                    continue
        except Exception:
            pass
    if newest:
        return datetime.fromtimestamp(newest, tz=timezone.utc).isoformat()
    return datetime.now(timezone.utc).isoformat()


def fetch_provider_quota(auth_file: Path, active_profile: str = "", usage: dict | None = None) -> dict:
    """
    Cuota de Pi: no existe endpoint HTTP de saldo/límites → saldo=None,
    rate_limit=None (unsupported_capability, nunca se inventa). `tokens` lleva
    el consumo local real agregado de las sesiones.
    """
    providers = list_configured_providers(auth_file)
    if not providers and not auth_file.is_file():
        return {
            "email": "", "plan_type": "PI",
            "rate_limit": None, "saldo": None, "tokens": None,
            "err_msg": "Sin credenciales de Pi",
        }
    if usage is None:
        usage = read_usage_totals()
    return {
        "email": decode_account_from_auth(auth_file),
        "plan_type": ("PI:" + providers[0].upper()) if providers else "PI",
        "rate_limit": None,
        "saldo": None,
        "tokens": usage,
        "err_msg": None,
    }


# ==============================================================================
# 5. DETECCIÓN DE PROCESOS Y BLOQUEO DE CONCURRENCIA
# ==============================================================================

def get_client_process_names() -> list[str]:
    return ["pi", "pi-coding-agent"]


def find_running_clients(tool: str = "pi") -> list[dict]:
    """Detecta sesiones interactivas de Pi escaneando /proc (argv0 exacto 'pi')."""
    clients: list[dict] = []
    current_pid = os.getpid()

    btime = 0
    try:
        with open("/proc/stat", encoding="utf-8") as f:
            for line in f:
                if line.startswith("btime "):
                    btime = int(line.split()[1])
                    break
    except Exception:
        pass
    clock_ticks = 100
    try:
        clock_ticks = os.sysconf("SC_CLK_TCK") or 100
    except Exception:
        pass
    now = time.time()

    proc_dir = Path("/proc")
    if not proc_dir.is_dir():
        return clients

    for proc in proc_dir.glob("[0-9]*"):
        try:
            pid = int(proc.name)
            if pid == current_pid:
                continue
            cmd_file = proc / "cmdline"
            if not cmd_file.exists():
                continue
            raw = cmd_file.read_bytes()
            if not raw:
                continue
            args = [a.decode("utf-8", errors="ignore") for a in raw.split(b"\0") if a]
            if not args:
                continue
            exe = os.path.basename(args[0]).lower()
            cmd_str = " ".join(args)

            # Nunca contarnos a nosotros mismos ni a la suite Switch.
            if "switch" in exe or "switch" in cmd_str.lower()[:80]:
                continue

            is_client = exe in get_client_process_names()
            if not is_client and exe.startswith("node"):
                #-node ejecando el CLI de pi directamente (argv incluye la ruta del cli).
                is_client = any(
                    "pi-coding-agent/dist" in a or a.endswith("/.pi/agent/bin/pi")
                    for a in args[1:3]
                )
            if not is_client:
                continue

            tty = "segundo plano"
            try:
                fd0 = os.readlink(proc / "fd" / "0")
                if fd0.startswith("/dev/pts/") or fd0.startswith("/dev/tty"):
                    tty = fd0.replace("/dev/", "")
            except Exception:
                pass

            elapsed_str = ""
            try:
                stat_parts = (proc / "stat").read_text().rsplit(")", 1)[1].split()
                start_ticks = int(stat_parts[19])
                start_sec = btime + (start_ticks / clock_ticks)
                elapsed = max(0, int(now - start_sec))
                m, s = divmod(elapsed, 60)
                h, m = divmod(m, 60)
                elapsed_str = f"hace {h}h {m}m" if h > 0 else (f"hace {m}m" if m > 0 else f"hace {s}s")
            except Exception:
                pass

            clients.append({
                "pid": pid,
                "exe": exe,
                "tty": tty,
                "cmd": cmd_str[:120],
                "elapsed": elapsed_str,
            })
        except (OSError, ValueError, IndexError):
            continue
    return clients


def find_active_parallel_leases() -> list[str]:
    locks_dir = get_locks_dir()
    if not locks_dir.is_dir():
        return []
    busy = []
    for lk in locks_dir.glob("*.lease"):
        try:
            fd = os.open(str(lk), os.O_RDWR)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                fcntl.flock(fd, fcntl.LOCK_UN)
            except (BlockingIOError, OSError):
                busy.append(lk.stem)
            finally:
                os.close(fd)
        except Exception:
            pass
    return busy


# ==============================================================================
# 6. CONTRATO CLI HEADLESS JSON (--json)
# ==============================================================================

def has_any_configured_account() -> bool:
    """True si existe al menos una cuenta guardada o credenciales activas."""
    if any(get_cuentas_dir().glob("*.json")):
        return True
    return bool(list_configured_providers(get_auth_path()))


def cmd_cuentas_json() -> dict:
    sync_active_profile()
    auth_path = get_auth_path()
    cuentas_dir = get_cuentas_dir()
    active_profile = find_active_profile_name(cuentas_dir, auth_path) if auth_path.is_file() else ""
    guardadas = sorted(cuentas_dir.glob("*.json"))

    accounts = []
    for f in guardadas:
        p_name = f.stem
        providers = list_configured_providers(f)
        ident = ", ".join(providers) or decode_account_from_auth(f)
        accounts.append({
            "alias": p_name,
            "es_activa": p_name == active_profile,
            "identificador_enmascarado": ident,
            "identidad_opaca": compute_opaque_identity(f),
            "plan": (f"PI:{providers[0].upper()}" if providers else "PI"),
            "estado": "disponible",
        })

    # Sesión activa aún sin guardar (credenciales en vivo, perfil temporal).
    if auth_path.is_file() and list_configured_providers(auth_path) and not active_profile:
        accounts.append({
            "alias": "(sin guardar)",
            "es_activa": True,
            "identificador_enmascarado": decode_account_from_auth(auth_path),
            "identidad_opaca": compute_opaque_identity(auth_path),
            "plan": "PI",
            "estado": "sin_guardar",
        })

    return {
        "disponible": len(accounts) > 0,
        "perfil_activo": active_profile,
        "cuentas": accounts,
    }


def cmd_cuota_json(target: str = "") -> dict:
    sync_active_profile()
    auth_path = get_auth_path()
    cuentas_dir = get_cuentas_dir()
    active_profile = find_active_profile_name(cuentas_dir, auth_path) if auth_path.is_file() else ""
    guardadas = sorted(cuentas_dir.glob("*.json"))
    if target:
        guardadas = [f for f in guardadas if f.stem.lower() == target.strip().lower()]

    now_iso = sessions_freshness_iso()
    usage = read_usage_totals()
    cuotas = []

    for f in guardadas:
        p_name = f.stem
        is_active = p_name == active_profile
        q = fetch_provider_quota(f, active_profile=p_name, usage=usage)
        cuotas.append({
            "alias": p_name,
            "es_activa": is_active,
            "identificador_enmascarado": q.get("email") or "",
            "identidad_opaca": compute_opaque_identity(f),
            "plan": q.get("plan_type") or "PI",
            "frescura": now_iso,
            "error": q.get("err_msg"),
            "rate_limit": None,
            "saldo": None,
            "tokens": q.get("tokens"),
        })

    if not cuotas and auth_path.is_file() and list_configured_providers(auth_path):
        q = fetch_provider_quota(auth_path, active_profile="(sin guardar)", usage=usage)
        cuotas.append({
            "alias": "(sin guardar)",
            "es_activa": True,
            "identificador_enmascarado": decode_account_from_auth(auth_path),
            "identidad_opaca": compute_opaque_identity(auth_path),
            "plan": q.get("plan_type") or "PI",
            "frescura": now_iso,
            "error": None,
            "rate_limit": None,
            "saldo": None,
            "tokens": usage,
        })

    return {
        "proveedor": PROVIDER_ID,
        "disponible": len(cuotas) > 0,
        "frescura": now_iso,
        "perfil_activo": active_profile,
        "cuotas": cuotas,
    }


def cmd_ocupacion_json() -> dict:
    sync_active_profile()
    running = find_running_clients("pi")
    parallel_busy = find_active_parallel_leases()
    active_profile = get_recorded_active_profile()
    is_busy = len(running) > 0 or len(parallel_busy) > 0

    desc = []
    if running:
        desc.append(f"{len(running)} sesión(es) interactiva(s) de Pi")
    if parallel_busy:
        desc.append(f"{len(parallel_busy)} worker(s) paralelo(s) activo(s)")
    if not desc:
        desc.append("Sin sesiones activas")

    return {
        "ocupado": is_busy,
        "puede_conmutar": not is_busy,
        "motivo": "active_session" if is_busy else None,
        "descripcion": " · ".join(desc),
        "perfil_activo": active_profile,
        "procesos": running,
        "procesos_paralelos": parallel_busy,
    }


def cmd_seleccionar_json(nombre: str, dry_run: bool = False, force: bool = False) -> dict:
    """Contrato: pi-switch seleccionar <alias> --json [--dry-run]"""
    cuentas_dir = get_cuentas_dir()
    src = cuentas_dir / f"{nombre}.json"
    if not src.is_file():
        return {
            "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": dry_run},
            "permitido": False,
            "codigo": "invalid_auth",
            "mensaje": f"La cuenta '{nombre}' no existe en {cuentas_dir}. Guarda una con: pi-switch guardar <alias>",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
        }

    running = find_running_clients("pi")
    if running and not force:
        return {
            "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": dry_run},
            "permitido": False,
            "codigo": "active_session",
            "mensaje": f"No se puede conmutar: hay {len(running)} sesión(es) de Pi activa(s). Ciérralas o usa --force.",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
            "procesos": running,
        }

    if dry_run:
        return {
            "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": True},
            "permitido": True,
            "codigo": "ok",
            "mensaje": "Conmutación viable y segura (dry-run verificado)",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
        }

    # Respaldo del perfil saliente antes de conmutar (cero pérdida de credenciales).
    sync_active_profile()
    auth_path = get_auth_path()
    private_copy(src, auth_path)
    set_recorded_active_profile(nombre)

    return {
        "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": False},
        "permitido": True,
        "codigo": "ok",
        "mensaje": f"Cuenta conmutada con éxito a '{nombre}'",
        "bloqueo_adquirido": True,
        "cambio_realizado": True,
    }


def cmd_preflight_json() -> dict:
    return {
        "protocol_version": 1,
        "version": VERSION,
        "proveedor": PROVIDER_ID,
        "capabilities": {
            "parallel": True,
            "identity_reservation": True,
            "active_session_detection": True,
            "refresh_persistence_errors": True,
            "local_token_telemetry": True,
            "external_quota_api": False,
        },
    }


# ==============================================================================
# 7. EJECUCIÓN CONCURRENTE AISLADA (PARALELO) — vía PI_CODING_AGENT_DIR
# ==============================================================================

def cmd_paralelo(nombre: str, extra_cmd: list[str], json_mode: bool = False):
    """
    Contrato: pi-switch paralelo <alias> [-- <comando>...]
    Ejecuta un worker con un directorio de agente temporal privado; no toca el
    auth.json global ni pisa el perfil activo.
    """
    cuentas_dir = get_cuentas_dir()
    src = cuentas_dir / f"{nombre}.json"
    if not src.is_file():
        print(f"❌ Error: La cuenta '{nombre}' no existe en {cuentas_dir}.", file=sys.stderr)
        sys.exit(1)

    if fcntl is None:
        print("❌ Error: La ejecución paralela requiere fcntl (Linux/macOS).", file=sys.stderr)
        sys.exit(1)

    opaque_id = compute_opaque_identity(src)
    alias_lease = get_locks_dir() / f"alias_{nombre}.lease"
    ident_lease = get_locks_dir() / f"ident_{opaque_id}.lease" if opaque_id else None

    fd_alias = os.open(str(alias_lease), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd_alias, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        print(f"❌ Error: Ya existe una ejecución concurrente activa para el alias '{nombre}'.", file=sys.stderr)
        sys.exit(3)

    fd_ident = None
    try:
        if ident_lease:
            fd_ident = os.open(str(ident_lease), os.O_CREAT | os.O_RDWR, 0o600)
            try:
                fcntl.flock(fd_ident, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except (BlockingIOError, OSError):
                print(f"❌ Error: Ya existe una ejecución concurrente activa con la misma identidad de '{nombre}'.", file=sys.stderr)
                sys.exit(3)

        # Runtime temporal privado: copia del auth.json + configuración ligera.
        temp_dir = Path(f"/tmp/pi-switch-{nombre}-{os.getpid()}")
        temp_dir.mkdir(parents=True, exist_ok=True)
        try:
            temp_dir.chmod(0o700)
        except Exception:
            pass

        isolated_auth = temp_dir / "auth.json"
        private_copy(src, isolated_auth)
        agent_dir = get_agent_dir()
        for extra in ("settings.json", "models.json", "keybindings.json", "trust.json"):
            f_src = agent_dir / extra
            if f_src.is_file():
                try:
                    shutil.copyfile(f_src, temp_dir / extra)
                except Exception:
                    pass

        env = os.environ.copy()
        env["PI_CODING_AGENT_DIR"] = str(temp_dir)
        env["SWITCH_PARALLEL_ALIAS"] = nombre
        env.pop("PI_SESSION_ID", None)
        env.pop("PI_SESSION_FILE", None)

        cmd = extra_cmd if extra_cmd else [find_pi_bin() or "pi"]
        try:
            res = subprocess.run(cmd, env=env)
            rc = res.returncode
        except FileNotFoundError:
            print("❌ Error: No se encontró el ejecutable 'pi' en el PATH.", file=sys.stderr)
            rc = 127

        # Refrescos de token en vuelo: sincronizar de vuelta al perfil guardado.
        if isolated_auth.is_file():
            try:
                if isolated_auth.read_bytes() != src.read_bytes():
                    private_copy(isolated_auth, src)
            except Exception:
                pass

        shutil.rmtree(temp_dir, ignore_errors=True)

        if json_mode:
            print(json.dumps({
                "proveedor": PROVIDER_ID,
                "alias": nombre,
                "runtime_aislado": True,
                "codigo": "ok" if rc == 0 else "error",
                "exit_code": rc,
            }, indent=2))
        sys.exit(rc)
    finally:
        if fd_ident is not None:
            try:
                fcntl.flock(fd_ident, fcntl.LOCK_UN)
                os.close(fd_ident)
            except Exception:
                pass
        try:
            fcntl.flock(fd_alias, fcntl.LOCK_UN)
            os.close(fd_alias)
        except Exception:
            pass


# ==============================================================================
# 8. COMANDOS CLI HUMANOS
# ==============================================================================

def cmd_listar():
    data = cmd_cuentas_json()
    print("\n╭─────────────────────────────────────────────────────────────╮")
    print(f"│  ✦ Cuentas de {PROVIDER_NAME:<44}│")
    print("╰─────────────────────────────────────────────────────────────╯")
    cuentas = data.get("cuentas") or []
    if not cuentas:
        print("  (No hay cuentas configuradas. Usa: pi-switch guardar <alias> tras autenticarte con pi)")
        print("  (O conecta un proveedor con: pi auth login <proveedor>)\n")
        return
    for acc in cuentas:
        prefix = "\033[1;33m★ [ACTIVA]\033[0m" if acc["es_activa"] else "          "
        estado = f" \033[2m[{acc['estado']}]\033[0m" if acc["estado"] != "disponible" else ""
        print(f"  {prefix} \033[1m{acc['alias']:<20}\033[0m \033[2m{acc['identificador_enmascarado']}\033[0m{estado}")
    print()


def cmd_status(target: str = ""):
    data = cmd_cuota_json(target)
    print("\n╭─────────────────────────────────────────────────────────────╮")
    print("│  ✦ PI CODING AGENT · Consumo Local de Tokens y Coste        │")
    print("╰─────────────────────────────────────────────────────────────╯")
    if data.get("perfil_activo"):
        print(f"  • Perfil activo : \033[1;32m{data['perfil_activo']}\033[0m")

    cuotas = data.get("cuotas") or []
    if not cuotas:
        print("\n  (Sin credenciales configuradas. Autentícate con: pi auth login <proveedor>)\n")
        return

    usage_total = {}
    for q in cuotas:
        ident = q.get("identificador_enmascarado") or ""
        suffix = " ★" if q.get("es_activa") else ""
        print(f"\n  \033[1m{q['alias']}\033[0m{suffix} \033[2m[{q.get('plan')}] · {ident}\033[0m")
        tokens = q.get("tokens") or {}
        if not tokens:
            print("      (Sin consumo registrado en las sesiones locales.)")
            continue
        for prov, t in sorted(tokens.items(), key=lambda kv: -kv[1]["cost"]):
            if prov not in usage_total:
                usage_total[prov] = t
            total_tokens = t["input"] + t["output"] + t["reasoning"]
            print(f"      \033[1;36m{prov}\033[0m — ${t['cost']:.4f} · {total_tokens:,} tokens · {t['sessions']} sesión(es)")
            for mid, m in sorted(t["models"].items(), key=lambda kv: -kv[1]["cost"])[:5]:
                mt = m["input"] + m["output"] + m["reasoning"]
                print(f"        - {mid:<28} ${m['cost']:.4f} · {mt:,} tokens")

    print("\n  💡 Pi no expone saldo ni límites de cuota por API; el consumo mostrado")
    print("     es el registro real local de sesiones (~/.pi/agent/sessions).\n")


def cmd_guardar(nombre: str):
    validate_alias(nombre)
    auth_path = get_auth_path()
    if not auth_path.is_file():
        print(f"❌ No hay credenciales activas en {auth_path}.")
        print("   Autentícate primero con: pi auth login <proveedor>")
        sys.exit(1)
    if not list_configured_providers(auth_path):
        print(f"❌ El archivo {auth_path} no contiene credenciales de ningún proveedor.")
        sys.exit(1)
    target = get_cuentas_dir() / f"{nombre}.json"
    private_copy(auth_path, target)
    set_recorded_active_profile(nombre)
    provs = ", ".join(list_configured_providers(target))
    print(f"✅ Cuenta activa guardada como '\033[1;36m{nombre}\033[0m' (proveedores: {provs}).")


def cmd_nueva(nombre: str, provider: str = "", force: bool = False):
    """Login nativo de Pi + guardado del perfil resultante bajo alias."""
    validate_alias(nombre)
    bin_path = find_pi_bin()
    if not bin_path:
        print("❌ No se encontró el ejecutable 'pi' en el PATH.")
        sys.exit(127)

    cuentas_dir = get_cuentas_dir()
    target = cuentas_dir / f"{nombre}.json"
    if target.is_file() and not force:
        print(f"⚠️ La cuenta '{nombre}' ya existe. Se reautenticará (usa otra alias o espera).")

    running = find_running_clients("pi")
    if running and not force:
        print(f"⚠️  Hay {len(running)} sesión(es) de Pi activa(s).")
        print("   Autenticarte con otra cuenta puede interferir. Usa --force para continuar.")
        sys.exit(2)

    # Respaldo del estado actual antes de tocar credenciales globales.
    sync_active_profile()

    cmd = [bin_path, "auth", "login"] + ([provider] if provider else [])
    print(f"\n🚀 Ejecutando login nativo de Pi: {' '.join(cmd)}")
    try:
        res = subprocess.run(cmd, check=False)
        rc = res.returncode
    except KeyboardInterrupt:
        print("\n⛔ Operación cancelada por el usuario.")
        sys.exit(130)

    auth_path = get_auth_path()
    if rc == 0 and auth_path.is_file():
        if provider:
            # Reautenticación enfocada: copiar solo la credencial del proveedor.
            old = load_auth_data(target) if target.is_file() else {}
            new = load_auth_data(auth_path)
            merged = dict(new)
            for k, v in old.items():
                merged.setdefault(k, v)
            try:
                tmp = auth_path.with_name(f"auth.json.tmp.{os.getpid()}")
                tmp.write_text(json.dumps(merged, indent=2), encoding="utf-8")
                os.chmod(tmp, 0o600)
                os.replace(tmp, auth_path)
            except Exception:
                pass
        private_copy(auth_path, target)
        set_recorded_active_profile(nombre)
        print(f"✅ Cuenta '\033[1;36m{nombre}\033[0m' guardada en {target}")
    elif rc != 0:
        print(f"❌ El login de Pi finalizó con código {rc}. La cuenta no se guardó.")
    sys.exit(rc)


def cmd_reautenticar(nombre: str = "", force: bool = False):
    cuentas_dir = get_cuentas_dir()
    if nombre:
        src = cuentas_dir / f"{nombre}.json"
        if not src.is_file():
            print(f"❌ La cuenta '{nombre}' no existe en {cuentas_dir}.")
            sys.exit(1)
        # Activar el perfil y reautenticar sobre él.
        res = cmd_seleccionar_json(nombre, force=force)
        if not res.get("permitido"):
            print(f"❌ {res.get('mensaje')}")
            sys.exit(1)
        providers = list_configured_providers(src)
        provider = providers[0] if providers else ""
        cmd_nueva(nombre, provider=provider, force=force)
        return

    # Sin alias: reautenticar el perfil activo.
    active = get_recorded_active_profile()
    auth_path = get_auth_path()
    if active:
        cmd_reautenticar(active, force=force)
        return
    providers = list_configured_providers(auth_path)
    if not providers:
        print("❌ No hay credenciales activas ni perfiles guardados que reautenticar.")
        print("   Usa: pi-switch login <alias> <proveedor>")
        sys.exit(1)
    print(f"ℹ️ Reautenticando el primer proveedor configurado: {providers[0]}")
    print("   (Guarda primero la sesión con 'pi-switch guardar <alias>' si quieres persistirla)")
    bin_path = find_pi_bin()
    if not bin_path:
        print("❌ No se encontró el ejecutable 'pi'.")
        sys.exit(127)
    res = subprocess.run([bin_path, "auth", "login", providers[0]], check=False)
    sys.exit(res.returncode)


def cmd_usar(nombre: str, force: bool = False):
    if not nombre:
        print("Uso: pi-switch usar <alias> [--force]")
        sys.exit(1)
    if nombre == get_recorded_active_profile():
        print(f"ℹ️ La cuenta '\033[1;36m{nombre}\033[0m' ya está activa.")
        return
    res = cmd_seleccionar_json(nombre, force=force)
    if res.get("permitido"):
        print(f"✅ {res.get('mensaje')}")
        providers = list_configured_providers(get_cuentas_dir() / f"{nombre}.json")
        if providers:
            print(f"   Proveedores disponibles: {', '.join(providers)}")
        sys.exit(0)
    print(f"❌ {res.get('mensaje')}")
    sys.exit(1)


def cmd_eliminar(nombre: str):
    cuentas_dir = get_cuentas_dir()
    target = cuentas_dir / f"{nombre}.json"
    if not target.is_file():
        print(f"❌ La cuenta '{nombre}' no existe en {cuentas_dir}.")
        sys.exit(1)
    was_active = get_recorded_active_profile() == nombre
    target.unlink()
    if was_active:
        clear_recorded_active_profile()
        print(f"🗑️ Cuenta '{nombre}' eliminada (era la activa; las credenciales en vivo se conservan en {get_auth_path()}).")
    else:
        print(f"🗑️ Cuenta '{nombre}' eliminada.")


def cmd_version():
    print("\n╭─────────────────────────────────────────────────────────────╮")
    print(f"│  ✦ CLI Account Switch v{VERSION:<36}│")
    print("╰─────────────────────────────────────────────────────────────╯")
    print("  • Herramienta : \033[1;36mpi-switch\033[0m")
    print("  • Suite       : CLI Account Switch (Codex, AGY, OpenCode & Pi)")
    bin_path = find_pi_bin()
    pi_ver = "No instalado"
    if bin_path:
        try:
            r = subprocess.run([bin_path, "--version"], capture_output=True, text=True, timeout=5)
            pi_ver = r.stdout.strip().splitlines()[0].strip() if r.returncode == 0 and r.stdout.strip() else "Instalado"
        except Exception:
            pi_ver = "Instalado"
    print(f"  • Pi CLI      : \033[1;35m{pi_ver}\033[0m")
    print(f"  • Agente dir  : {get_agent_dir()}")
    print(f"  • Repositorio : https://github.com/{GITHUB_REPO}\n")


# ==============================================================================
# 9. ENRUTADOR PRINCIPAL (MAIN)
# ==============================================================================

def main():
    args = sys.argv[1:]
    json_mode = "--json" in args

    if json_mode:
        subcmd = args[0] if args else "status"
        if subcmd in ("cuentas", "accounts", "listar", "list", "ls"):
            print(json.dumps(cmd_cuentas_json(), indent=2))
            sys.exit(0)
        elif subcmd in ("cuota", "quota", "status"):
            target = [a for a in args[1:] if not a.startswith("-")]
            print(json.dumps(cmd_cuota_json(target[0] if target else ""), indent=2))
            sys.exit(0)
        elif subcmd in ("ocupacion", "ocupado", "sesiones"):
            res = cmd_ocupacion_json()
            print(json.dumps(res, indent=2))
            sys.exit(0 if not res.get("ocupado") else 1)
        elif subcmd in ("seleccionar", "select", "usar", "use"):
            target = [a for a in args[1:] if not a.startswith("-")]
            if not target:
                sys.exit(1)
            dry_run = "--dry-run" in args
            force = any(a in ("--force", "-f") for a in args[1:])
            res = cmd_seleccionar_json(target[0], dry_run=dry_run, force=force)
            print(json.dumps(res, indent=2))
            sys.exit(0 if res.get("permitido") else 1)
        elif subcmd in ("preflight", "capabilities", "capacidades"):
            print(json.dumps(cmd_preflight_json(), indent=2))
            sys.exit(0)
        else:
            print(json.dumps(cmd_cuota_json(), indent=2))
            sys.exit(0)

    if not args or args[0] in ("status", "cuota", "quota", "tokens"):
        target = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        cmd_status(target)
    elif args[0] in ("listar", "list", "ls", "cuentas", "accounts"):
        cmd_listar()
    elif args[0] in ("usar", "use", "switch"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        force = any(a in ("--force", "-f", "-y", "--yes") for a in args[1:])
        cmd_usar(positionals[0] if positionals else "", force=force)
    elif args[0] in ("guardar", "save"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        if not positionals:
            print("Uso: pi-switch guardar <alias>")
            sys.exit(1)
        cmd_guardar(positionals[0])
    elif args[0] in ("login", "nueva", "new", "conectar", "connect"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        force = any(a in ("--force", "-f", "-y", "--yes") for a in args[1:])
        if positionals:
            alias = positionals[0]
            provider = positionals[1] if len(positionals) > 1 else os.environ.get("PI_LOGIN_PROVIDER", "")
            if alias == get_recorded_active_profile() or (get_cuentas_dir() / f"{alias}.json").is_file():
                cmd_reautenticar(alias, force=force)
            else:
                cmd_nueva(alias, provider=provider, force=force)
        else:
            print("Uso: pi-switch login <alias> [proveedor]   (ej: pi-switch login trabajo anthropic)")
            sys.exit(1)
    elif args[0] in ("reautenticar", "reauth"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        force = any(a in ("--force", "-f", "-y", "--yes") for a in args[1:])
        cmd_reautenticar(positionals[0] if positionals else "", force=force)
    elif args[0] in ("eliminar", "borrar", "rm", "logout"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        if not positionals:
            print("Uso: pi-switch eliminar <alias>")
            sys.exit(1)
        cmd_eliminar(positionals[0])
    elif args[0] in ("paralelo", "parallel", "spawn"):
        if len(args) < 2:
            print("Uso: pi-switch paralelo <alias> [-- <comando>...]")
            sys.exit(1)
        nombre = args[1]
        extra_cmd = []
        if "--" in args:
            extra_cmd = args[args.index("--") + 1:]
        elif len(args) > 2:
            extra_cmd = args[2:]
        cmd_paralelo(nombre, extra_cmd)
    elif args[0] in ("ocupacion", "ocupado", "sesiones"):
        res = cmd_ocupacion_json()
        print(json.dumps(res, indent=2))
        sys.exit(0 if not res.get("ocupado") else 1)
    elif args[0] in ("preflight", "capabilities", "capacidades"):
        print(json.dumps(cmd_preflight_json(), indent=2))
        sys.exit(0)
    elif args[0] in ("version", "--version", "-v", "-V"):
        cmd_version()
    elif args[0] in ("ayuda", "help", "--help", "-h"):
        print("Uso: pi-switch [comando] [argumentos]")
        print("\nComandos disponibles:")
        print("  status [alias]        Consumo local de tokens y coste por proveedor/modelo")
        print("  listar                Lista las cuentas guardadas de Pi (alias: cuentas)")
        print("  usar <alias>          Conmuta el perfil activo de credenciales (--force)")
        print("  guardar <alias>       Guarda la sesión activa actual como perfil")
        print("  login <alias> [prov]  'pi auth login [prov]' nativo y guarda el perfil")
        print("  reautenticar [alias]  Reautentica un perfil existente y sincroniza")
        print("  eliminar <alias>      Borra un perfil guardado (no toca las credenciales en vivo)")
        print("  paralelo <alias> [-- cmd]  Ejecución concurrente aislada (PI_CODING_AGENT_DIR)")
        print("  ocupacion             Detecta sesiones activas de Pi (bloqueo de conmutación)")
        print("  preflight             Capacidades del adaptador (JSON)")
        print("  version               Muestra la versión instalada")
    else:
        print(f"Comando desconocido: {args[0]}")
        print("Uso: pi-switch [status | listar | usar <alias> | guardar <alias> | login <alias> [prov] | paralelo <alias> | version]")
        sys.exit(1)


if __name__ == "__main__":
    main()
