#!/usr/bin/env python3
"""
opencode-switch: Gestor de multi-cuenta y telemetría de consumo para OpenCode CLI.

A diferencia de Codex/AGY (que intercambian un archivo de credenciales), OpenCode V2
gestiona sus cuentas de forma nativa dentro de su base de datos SQLite
('opencode.db', tablas 'credential'/'account'). Por tanto este adaptador:

  - Lista/usa/elimina cuentas mediante el CLI nativo ('opencode auth ...').
  - Lee la base de datos local para obtener el perfil activo y las cuentas guardadas.
  - Reporta el consumo real de tokens y coste (por proveedor y modelo) leyendo las
    tablas 'session_v2'/'session' de la base de datos. OpenCode no expone un endpoint
    HTTP de saldo/cuota, por lo que 'saldo' y 'rate_limit' se reportan como
    'unsupported_capability' (nunca se inventa cuota).

Compatible con el contrato headless JSON de la suite Switch.
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from pathlib import Path

VERSION = "1.2.6"
GITHUB_REPO = "Jyzus/cli-account-switch"
INSTALL_URL = f"https://raw.githubusercontent.com/{GITHUB_REPO}/main/install.sh"

PROVIDER_ID = "opencode"
PROVIDER_NAME = "OpenCode"


def validate_alias(nombre: str):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", nombre):
        print("❌ Alias inválido: usa de 1 a 64 letras, números, puntos, guiones o guiones bajos; empieza con letra o número.")
        sys.exit(2)


# ==============================================================================
# 1. UBICACIÓN DE OPENCODE (BINARIO, DATA DIR Y BASE DE DATOS)
# ==============================================================================

def find_opencode_bin() -> str | None:
    """Localiza el ejecutable de OpenCode en el PATH o en ubicaciones habituales."""
    for name in ("opencode", "opencode2"):
        which = shutil.which(name)
        if which:
            return which
    for p in (
        Path.home() / ".opencode" / "bin" / "opencode",
        Path.home() / ".local" / "bin" / "opencode",
        Path("/usr/local/bin/opencode"),
        Path("/usr/bin/opencode"),
    ):
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
    return None


def get_data_dir() -> Path:
    """Directorio de datos de OpenCode (donde vive opencode.db y auth.json)."""
    env_override = os.environ.get("OPENCODE_DATA_DIR")
    if env_override:
        return Path(env_override).expanduser()
    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        return Path(xdg).expanduser() / "opencode"
    return Path.home() / ".local" / "share" / "opencode"


def get_db_path() -> Path:
    """Ruta a la base de datos SQLite de OpenCode."""
    env_db = os.environ.get("OPENCODE_DB")
    if env_db:
        p = Path(env_db).expanduser()
        if p.is_absolute():
            return p
        return get_data_dir() / p
    return get_data_dir() / "opencode.db"


def get_config_dir() -> Path:
    """Directorio de configuración global de OpenCode (opencode.jsonc, cli.json)."""
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        return Path(xdg).expanduser() / "opencode"
    return Path.home() / ".config" / "opencode"


def get_cuentas_dir() -> Path:
    """Directorio donde Switch persiste el alias -> credential_id de OpenCode."""
    d = get_data_dir() / "cuentas"
    d.mkdir(parents=True, exist_ok=True)
    try:
        d.chmod(0o700)
    except Exception:
        pass
    return d


# ==============================================================================
# 2. ACCESO A LA BASE DE DATOS (SOLO LECTURA)
# ==============================================================================

def _open_db(readonly: bool = True) -> sqlite3.Connection | None:
    db = get_db_path()
    if not db.is_file():
        return None
    try:
        if readonly:
            uri = f"file:{db}?mode=ro"
            con = sqlite3.connect(uri, uri=True, timeout=3)
        else:
            con = sqlite3.connect(str(db), timeout=3)
        con.row_factory = sqlite3.Row
        return con
    except Exception:
        return None


def list_credentials() -> list[dict]:
    """Lee las cuentas guardadas desde la tabla 'credential' de opencode.db."""
    con = _open_db()
    if con is None:
        return []
    try:
        rows = con.execute(
            "SELECT id, integration_id, label, active, method_id, time_created "
            "FROM credential ORDER BY active DESC, label COLLATE NOCASE"
        ).fetchall()
        out = []
        for r in rows:
            out.append({
                "id": r["id"],
                "integration_id": r["integration_id"] or "",
                "label": r["label"] or r["id"] or "(sin etiqueta)",
                "active": bool(r["active"]),
                "method_id": r["method_id"] or "",
                "time_created": r["time_created"] or 0,
            })
        return out
    except Exception:
        return []
    finally:
        con.close()


def get_active_credential() -> dict | None:
    for c in list_credentials():
        if c.get("active"):
            return c
    creds = list_credentials()
    return creds[0] if creds else None


def find_credential(alias_or_id: str) -> dict | None:
    """Resuelve una cuenta por alias (etiqueta) o por credential id."""
    alias_l = alias_or_id.strip().lower()
    for c in list_credentials():
        if c["id"].lower() == alias_l or c["label"].strip().lower() == alias_l:
            return c
    return None


def mask_identifier(ident: str) -> str:
    if not ident:
        return "desconocido"
    if "@" in ident:
        user, domain = ident.split("@", 1)
        if len(user) <= 1:
            masked_user = user + "***"
        elif len(user) == 2:
            masked_user = user[0] + "***"
        else:
            masked_user = user[0] + "***" + user[-1]
        return f"{masked_user}@{domain}"
    if len(ident) > 8:
        return f"{ident[:4]}...{ident[-4:]}"
    return "***"


def compute_opaque_identity(cred: dict | None) -> str:
    if not cred:
        return ""
    key = cred.get("id") or ""
    if key:
        return hashlib.sha256(f"{PROVIDER_ID}:{key}".encode("utf-8")).hexdigest()[:16]
    return ""


# ==============================================================================
# 3. TELEMETRÍA DE CONSUMO (TOKENS Y COSTE) DESDE LA BASE DE DATOS
# ==============================================================================

def _parse_model(model_json: str | None) -> dict:
    if not model_json:
        return {}
    try:
        m = json.loads(model_json)
        if isinstance(m, dict):
            return m
    except Exception:
        pass
    return {}


def read_usage_totals() -> dict:
    """
    Agrega el consumo de tokens y coste desde las tablas session_v2 (preferente)
    y session (legacy). Devuelve un diccionario por proveedor:
        { providerID: { cost, input, output, reasoning, cache_read, cache_write,
                        sessions, models: { model_id: {...} } } }
    """
    con = _open_db()
    if con is None:
        return {}

    totals: dict = {}

    def acc_row(row) -> None:
        model = _parse_model(row["model"])
        provider = (model.get("providerID") or "opencode").strip() or "opencode"
        model_id = model.get("id") or "unknown"

        prov = totals.setdefault(provider, {
            "cost": 0.0,
            "input": 0,
            "output": 0,
            "reasoning": 0,
            "cache_read": 0,
            "cache_write": 0,
            "sessions": 0,
            "models": {},
        })
        prov["cost"] += float(row["cost"] or 0)
        prov["input"] += int(row["tokens_input"] or 0)
        prov["output"] += int(row["tokens_output"] or 0)
        prov["reasoning"] += int(row["tokens_reasoning"] or 0)
        prov["cache_read"] += int(row["tokens_cache_read"] or 0)
        prov["cache_write"] += int(row["tokens_cache_write"] or 0)
        prov["sessions"] += 1

        m = prov["models"].setdefault(model_id, {
            "cost": 0.0,
            "input": 0,
            "output": 0,
            "reasoning": 0,
            "cache_read": 0,
            "cache_write": 0,
            "sessions": 0,
        })
        m["cost"] += float(row["cost"] or 0)
        m["input"] += int(row["tokens_input"] or 0)
        m["output"] += int(row["tokens_output"] or 0)
        m["reasoning"] += int(row["tokens_reasoning"] or 0)
        m["cache_read"] += int(row["tokens_cache_read"] or 0)
        m["cache_write"] += int(row["tokens_cache_write"] or 0)
        m["sessions"] += 1

    try:
        cols_v2 = [c[1] for c in con.execute("PRAGMA table_info(session_v2)").fetchall()]
        if "model" in cols_v2:
            for row in con.execute(
                "SELECT model, cost, tokens_input, tokens_output, tokens_reasoning, "
                "tokens_cache_read, tokens_cache_write FROM session_v2"
            ).fetchall():
                acc_row(row)
        else:
            cols = [c[1] for c in con.execute("PRAGMA table_info(session)").fetchall()]
            if "model" in cols:
                for row in con.execute(
                    "SELECT model, cost, tokens_input, tokens_output, tokens_reasoning, "
                    "tokens_cache_read, tokens_cache_write FROM session"
                ).fetchall():
                    acc_row(row)
    except Exception:
        pass
    finally:
        con.close()

    return totals


def db_freshness_iso() -> str:
    db = get_db_path()
    if db.is_file():
        try:
            return datetime.fromtimestamp(db.stat().st_mtime, tz=timezone.utc).isoformat()
        except Exception:
            pass
    return datetime.now(timezone.utc).isoformat()


def fetch_provider_quota(cred: dict | None, active_profile: str = "") -> dict:
    """
    Devuelve la telemetría real de consumo de OpenCode.

    OpenCode no expone saldo ni límites de cuota vía API, por lo que 'saldo' y
    'rate_limit' se reportan como None (unsupported_capability). El campo 'tokens'
    lleva el consumo agregado real leído de la base de datos local.
    """
    if cred is None:
        return {
            "email": "",
            "plan_type": "OPENCODE",
            "rate_limit": None,
            "saldo": None,
            "tokens": None,
            "err_msg": "Sin credenciales de OpenCode",
        }

    usage = read_usage_totals()
    return {
        "email": cred.get("label", ""),
        "plan_type": (cred.get("integration_id") or "OPENCODE").upper(),
        "rate_limit": None,
        "saldo": None,
        "tokens": usage,
        "err_msg": None,
    }


# ==============================================================================
# 4. DETECCIÓN DE PROCESOS Y BLOQUEO
# ==============================================================================

def get_client_process_names() -> list[str]:
    return ["opencode", "opencode-server", "opencode2", "opencode-pty"]


def find_running_clients(tool: str = "opencode") -> list[dict]:
    """Detecta procesos cliente/servidor de OpenCode en ejecución."""
    current_pid = os.getpid()
    clients: list[dict] = []

    btime = 0
    try:
        with open("/proc/stat", encoding="utf-8") as f:
            for line in f:
                if line.startswith("btime "):
                    btime = int(line.split()[1])
                    break
    except Exception:
        pass
    clock_ticks = getattr(os, "sysconf_names", {}).get("SC_CLK_TCK", 100) or 100
    try:
        clock_ticks = os.sysconf(clock_ticks)
    except Exception:
        clock_ticks = 100
    now = time.time()

    proc_dir = Path("/proc")
    if not proc_dir.is_dir():
        return clients

    for proc in proc_dir.glob("[0-9]*"):
        try:
            pid = int(proc.name)
            if pid == current_pid:
                continue
            cmd_file = proc / "cmdline"
            if not cmd_file.exists():
                continue
            raw = cmd_file.read_bytes()
            if not raw:
                continue
            args = [a.decode("utf-8", errors="ignore") for a in raw.split(b"\0") if a]
            if not args:
                continue
            exe = os.path.basename(args[0]).lower()
            cmd_str = " ".join(args)

            if "switch" in exe:
                continue

            is_client = False
            if exe in ("opencode", "opencode2") or "opencode" in exe or "opencode" in args[0].lower():
                is_client = True
            elif exe in ("opencode-server", "opencode-pty"):
                is_client = True

            if not is_client:
                continue

            tty = "segundo plano"
            try:
                fd0 = os.readlink(proc / "fd" / "0")
                if fd0.startswith("/dev/pts/") or fd0.startswith("/dev/tty"):
                    tty = fd0.replace("/dev/", "")
            except Exception:
                pass

            elapsed_str = ""
            try:
                stat_parts = (proc / "stat").read_text().rsplit(")", 1)[1].split()
                start_ticks = int(stat_parts[19])
                start_sec = btime + (start_ticks / clock_ticks)
                elapsed = max(0, int(now - start_sec))
                m, s = divmod(elapsed, 60)
                h, m = divmod(m, 60)
                elapsed_str = f"hace {h}h {m}m" if h > 0 else (f"hace {m}m" if m > 0 else f"hace {s}s")
            except Exception:
                pass

            clients.append({
                "pid": pid,
                "exe": exe,
                "tty": tty,
                "cmd": cmd_str[:120],
                "elapsed": elapsed_str,
            })
        except (OSError, ValueError, IndexError):
            continue
    return clients


def find_active_parallel_leases() -> list[str]:
    locks_dir = get_data_dir() / ".locks"
    if not locks_dir.is_dir():
        return []
    busy = []
    for lk in locks_dir.glob("*.lease"):
        try:
            fd = os.open(str(lk), os.O_RDWR)
            try:
                import fcntl
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                fcntl.flock(fd, fcntl.LOCK_UN)
            except (BlockingIOError, OSError):
                busy.append(lk.stem)
            finally:
                os.close(fd)
        except Exception:
            pass
    return busy


# ==============================================================================
# 5. CONTRATO CLI HEADLESS JSON (--json)
# ==============================================================================

def cmd_cuentas_json() -> dict:
    creds = list_credentials()
    active = get_active_credential()
    active_id = active["id"] if active else ""

    accounts = []
    for c in creds:
        accounts.append({
            "alias": c["label"],
            "es_activa": c["active"],
            "identificador_enmascarado": mask_identifier(c["label"]),
            "identidad_opaca": compute_opaque_identity(c),
            "plan": (c["integration_id"] or "OPENCODE").upper(),
            "estado": "disponible",
        })

    return {
        "disponible": True,
        "perfil_activo": active["label"] if active else "",
        "cuentas": accounts,
    }


def cmd_cuota_json(target: str = "") -> dict:
    creds = list_credentials()
    active = get_active_credential()

    if target:
        creds = [c for c in creds if c["label"].strip().lower() == target.strip().lower()
                 or c["id"].lower() == target.strip().lower()]

    now_iso = db_freshness_iso()
    usage = read_usage_totals()

    cuotas = []
    for c in creds:
        q = fetch_provider_quota(c, active_profile=(active["label"] if active else ""))
        cuotas.append({
            "alias": c["label"],
            "es_activa": c["active"],
            "identificador_enmascarado": mask_identifier(q.get("email") or ""),
            "identidad_opaca": compute_opaque_identity(c),
            "plan": (q.get("plan_type") or "OPENCODE").upper(),
            "frescura": now_iso,
            "error": q.get("err_msg"),
            "rate_limit": q.get("rate_limit"),
            "saldo": q.get("saldo"),
            "tokens": q.get("tokens"),
        })

    # Si no hay cuentas guardadas, reportar el consumo global igualmente.
    if not cuotas and usage:
        cuotas.append({
            "alias": "(consumo global)",
            "es_activa": True,
            "identificador_enmascarado": "global",
            "identidad_opaca": "",
            "plan": "OPENCODE",
            "frescura": now_iso,
            "error": None,
            "rate_limit": None,
            "saldo": None,
            "tokens": usage,
        })

    return {
        "proveedor": PROVIDER_ID,
        "frescura": now_iso,
        "perfil_activo": active["label"] if active else "",
        "cuotas": cuotas,
    }


def cmd_ocupacion_json() -> dict:
    running = find_running_clients("opencode")
    parallel_busy = find_active_parallel_leases()
    active = get_active_credential()
    is_busy = len(running) > 0 or len(parallel_busy) > 0

    desc = []
    if running:
        desc.append(f"{len(running)} proceso(s) de OpenCode activo(s)")
    if parallel_busy:
        desc.append(f"{len(parallel_busy)} worker(s) paralelo(s) activo(s)")
    if not desc:
        desc.append("Sin sesiones activas")

    return {
        "ocupado": is_busy,
        "puede_conmutar": not is_busy,
        "motivo": "active_session" if is_busy else None,
        "descripcion": " · ".join(desc),
        "perfil_activo": active["label"] if active else "",
        "procesos": running,
        "procesos_paralelos": parallel_busy,
    }


def cmd_seleccionar_json(nombre: str, dry_run: bool = False) -> dict:
    cred = find_credential(nombre)
    if cred is None:
        return {
            "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": dry_run},
            "permitido": False,
            "codigo": "invalid_auth",
            "mensaje": f"La cuenta '{nombre}' no existe en OpenCode.",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
        }

    running = find_running_clients("opencode")
    if running:
        return {
            "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": dry_run},
            "permitido": False,
            "codigo": "active_session",
            "mensaje": f"No se puede conmutar: hay {len(running)} proceso(s) de OpenCode activo(s).",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
            "procesos": running,
        }

    if dry_run:
        return {
            "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": True},
            "permitido": True,
            "codigo": "ok",
            "mensaje": "Conmutación viable y segura (dry-run verificado)",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
        }

    # Conmutación real vía el CLI nativo.
    bin_path = find_opencode_bin()
    if not bin_path:
        return {
            "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": False},
            "permitido": False,
            "codigo": "unsupported_capability",
            "mensaje": "No se encontró el ejecutable 'opencode'.",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
        }

    # Preferir credential id (estable) frente a la etiqueta.
    target = cred["id"]
    try:
        res = subprocess.run(
            [bin_path, "auth", "switch", cred["integration_id"], target],
            capture_output=True, text=True, timeout=60,
        )
        if res.returncode == 0:
            return {
                "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": False},
                "permitido": True,
                "codigo": "ok",
                "mensaje": f"Cuenta conmutada con éxito a '{cred['label']}'.",
                "bloqueo_adquirido": True,
                "cambio_realizado": True,
                "cuenta_activa": cred["label"],
            }
        err = (res.stderr or res.stdout or "").strip()[:300]
        return {
            "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": False},
            "permitido": False,
            "codigo": "unsupported_capability",
            "mensaje": f"No se pudo conmutar la cuenta: {err or 'error desconocido'}",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
        }
    except FileNotFoundError:
        return {
            "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": False},
            "permitido": False,
            "codigo": "unsupported_capability",
            "mensaje": "No se encontró el ejecutable 'opencode'.",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
        }
    except subprocess.TimeoutExpired:
        return {
            "solicitud": {"proveedor": PROVIDER_ID, "cuenta_destino": nombre, "dry_run": False},
            "permitido": False,
            "codigo": "unsupported_capability",
            "mensaje": "La conmutación excedió el tiempo de espera.",
            "bloqueo_adquirido": False,
            "cambio_realizado": False,
        }


# ==============================================================================
# 6. COMANDOS CLI HUMANOS
# ==============================================================================

def cmd_listar():
    creds = list_credentials()
    active = get_active_credential()

    print("\n╭─────────────────────────────────────────────────────────────╮")
    print(f"│  ✦ Cuentas de {PROVIDER_NAME:<44}│")
    print("╰─────────────────────────────────────────────────────────────╯")
    if not creds:
        print("  (No hay cuentas guardadas. Usa: opencode-switch login <alias>)")
        print("  (O conéctate con: opencode auth login)\n")
        return

    for c in creds:
        prefix = "\033[1;33m★ [ACTIVA]\033[0m" if c["active"] else "          "
        print(f"  {prefix} \033[1m{c['label']:<20}\033[0m \033[2m[{c['integration_id']}]\033[0m")
    print()


def cmd_status(target: str = ""):
    creds = list_credentials()
    active = get_active_credential()

    print("\n╭─────────────────────────────────────────────────────────────╮")
    print("│  ✦ OPENCODE · Consumo de Tokens y Coste (Local)             │")
    print("╰─────────────────────────────────────────────────────────────╯")
    if active:
        print(f"  • Cuenta activa : \033[1;32m{active['label']}\033[0m  \033[2m[{active['integration_id']}]\033[0m")

    if target:
        creds = [c for c in creds if c["label"].strip().lower() == target.strip().lower()
                 or c["id"].lower() == target.strip().lower()]
        if not creds:
            print(f"\n❌ La cuenta '{target}' no existe en OpenCode.")
            sys.exit(1)

    usage = read_usage_totals()
    if not usage:
        print("\n  (No hay consumo registrado en la base de datos local todavía.)")
    else:
        print("\n  Consumo por proveedor (acumulado):")
        for prov, t in sorted(usage.items(), key=lambda kv: -kv[1]["cost"]):
            total_tokens = t["input"] + t["output"] + t["reasoning"]
            print(f"\n  \033[1m{prov}\033[0m — \033[1;36m${t['cost']:.4f}\033[0m · {total_tokens:,} tokens · {t['sessions']} sesión(es)")
            print(f"      entrada={t['input']:,} · salida={t['output']:,} · razonamiento={t['reasoning']:,}")
            print(f"      cache(read)={t['cache_read']:,} · cache(write)={t['cache_write']:,}")
            for mid, m in sorted(t["models"].items(), key=lambda kv: -kv[1]["cost"]):
                mt = m["input"] + m["output"] + m["reasoning"]
                print(f"        - {mid:<28} ${m['cost']:.4f} · {mt:,} tokens")

    print("\n  💡 OpenCode no expone saldo ni límites de cuota por API; el consumo")
    print("     mostrado es el registro real local de sesiones (opencode.db).\n")


def cmd_login(nombre: str = "", force: bool = False):
    bin_path = find_opencode_bin()
    if not bin_path:
        print("❌ No se encontró el ejecutable 'opencode'.")
        sys.exit(127)

    running = find_running_clients("opencode")
    if running and not force:
        print(f"⚠️  Hay {len(running)} proceso(s) de OpenCode activo(s).")
        print("   Iniciar sesión con otra cuenta puede interferir con esas sesiones.")
        print("   Usa --force para continuar, o cierra las sesiones antes.")
        sys.exit(2)

    print("\n🚀 Iniciando flujo de login de OpenCode (opencode auth login)...")
    if nombre:
        print(f"   Alias sugerido tras el login: \033[1;36m{nombre}\033[0m")
    try:
        res = subprocess.run([bin_path, "auth", "login"], check=False)
        sys.exit(res.returncode)
    except KeyboardInterrupt:
        print("\n⛔ Operación cancelada por el usuario.")
        sys.exit(130)


def cmd_reautenticar(nombre: str = ""):
    bin_path = find_opencode_bin()
    if not bin_path:
        print("❌ No se encontró el ejecutable 'opencode'.")
        sys.exit(127)

    cred = find_credential(nombre) if nombre else get_active_credential()
    if not cred:
        print(f"❌ La cuenta '{nombre or '(activa)'}' no existe en OpenCode.")
        sys.exit(1)

    print(f"\n🔄 Reautenticando '\033[1;36m{cred['label']}\033[0m'...")
    print("   (OpenCode no distingue re-login de login nuevo; se volverá a pedir credenciales)")
    try:
        res = subprocess.run([bin_path, "auth", "login", cred["integration_id"]], check=False)
        sys.exit(res.returncode)
    except KeyboardInterrupt:
        print("\n⛔ Operación cancelada por el usuario.")
        sys.exit(130)


def cmd_usar(nombre: str, force: bool = False):
    if not nombre:
        print("Uso: opencode-switch usar <alias> [--force]")
        sys.exit(1)
    cred = find_credential(nombre)
    if cred is None:
        print(f"❌ La cuenta '{nombre}' no existe en OpenCode. Usa: opencode-switch listar")
        sys.exit(1)

    if cred.get("active"):
        print(f"ℹ️ La cuenta '\033[1;36m{cred['label']}\033[0m' ya está activa.")
        return

    running = find_running_clients("opencode")
    if running and not force:
        print(f"⚠️  Hay {len(running)} proceso(s) de OpenCode activo(s).")
        print("   Usa --force para conmutar de todas formas.")
        sys.exit(2)

    res = cmd_seleccionar_json(nombre)
    print(json.dumps(res, indent=2))
    sys.exit(0 if res.get("permitido") else 1)


def cmd_eliminar(nombre: str):
    bin_path = find_opencode_bin()
    if not bin_path:
        print("❌ No se encontró el ejecutable 'opencode'.")
        sys.exit(127)
    cred = find_credential(nombre)
    if cred is None:
        print(f"❌ La cuenta '{nombre}' no existe en OpenCode.")
        sys.exit(1)
    try:
        res = subprocess.run([bin_path, "auth", "logout", cred["integration_id"], cred["id"]], check=False)
        sys.exit(res.returncode)
    except KeyboardInterrupt:
        print("\n⛔ Operación cancelada por el usuario.")
        sys.exit(130)


def cmd_version():
    print(f"\n╭─────────────────────────────────────────────────────────────╮")
    print(f"│  ✦ CLI Account Switch v{VERSION:<36}│")
    print(f"╰─────────────────────────────────────────────────────────────╯")
    print(f"  • Herramienta : \033[1;36mopencode-switch\033[0m")
    print(f"  • Suite       : CLI Account Switch (Codex, AGY & OpenCode)")
    print(f"  • Repositorio : https://github.com/{GITHUB_REPO}\n")


# ==============================================================================
# 7. ENRUTADOR PRINCIPAL (MAIN)
# ==============================================================================

def main():
    args = sys.argv[1:]

    if "--json" in args:
        subcmd = args[0] if args else "status"
        if subcmd in ("cuentas", "accounts", "listar", "list", "ls"):
            print(json.dumps(cmd_cuentas_json(), indent=2))
            sys.exit(0)
        elif subcmd in ("cuota", "quota", "status"):
            target = [a for a in args[1:] if not a.startswith("-")]
            t = target[0] if target else ""
            print(json.dumps(cmd_cuota_json(t), indent=2))
            sys.exit(0)
        elif subcmd in ("ocupacion", "ocupado", "sesiones"):
            res = cmd_ocupacion_json()
            print(json.dumps(res, indent=2))
            sys.exit(0 if not res.get("ocupado") else 1)
        elif subcmd in ("seleccionar", "select", "usar", "use"):
            target = [a for a in args[1:] if not a.startswith("-")]
            if not target:
                sys.exit(1)
            dry_run = "--dry-run" in args
            res = cmd_seleccionar_json(target[0], dry_run=dry_run)
            print(json.dumps(res, indent=2))
            sys.exit(0 if res.get("permitido") else 1)
        elif subcmd in ("preflight", "capabilities", "capacidades"):
            print(json.dumps({
                "protocol_version": 1,
                "version": VERSION,
                "proveedor": PROVIDER_ID,
                "capabilities": {
                    "parallel": False,
                    "identity_reservation": False,
                    "active_session_detection": True,
                    "refresh_persistence_errors": False,
                    "local_token_telemetry": True,
                },
            }, indent=2))
            sys.exit(0)
        else:
            print(json.dumps(cmd_cuota_json(), indent=2))
            sys.exit(0)

    # Modo terminal humano
    if not args or args[0] in ("status", "cuota", "quota", "tokens"):
        target = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        cmd_status(target)
    elif args[0] in ("listar", "list", "ls", "cuentas", "accounts"):
        cmd_listar()
    elif args[0] in ("usar", "use", "switch"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        nombre = positionals[0] if positionals else ""
        force = any(a in ("--force", "-f", "-y", "--yes") for a in args[1:])
        cmd_usar(nombre, force=force)
    elif args[0] in ("login", "nueva", "new", "conectar", "connect"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        nombre = positionals[0] if positionals else ""
        force = any(a in ("--force", "-f", "-y", "--yes") for a in args[1:])
        cmd_login(nombre, force=force)
    elif args[0] in ("reautenticar", "reauth"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        nombre = positionals[0] if positionals else ""
        cmd_reautenticar(nombre)
    elif args[0] in ("eliminar", "borrar", "rm", "logout"):
        positionals = [a for a in args[1:] if not a.startswith("-")]
        nombre = positionals[0] if positionals else ""
        cmd_eliminar(nombre)
    elif args[0] in ("version", "--version", "-v", "-V"):
        cmd_version()
    elif args[0] in ("ocupacion", "ocupado", "sesiones"):
        res = cmd_ocupacion_json()
        print(json.dumps(res, indent=2))
        sys.exit(0 if not res.get("ocupado") else 1)
    elif args[0] in ("preflight", "capabilities", "capacidades"):
        print(json.dumps({
            "protocol_version": 1,
            "version": VERSION,
            "proveedor": PROVIDER_ID,
            "capabilities": {
                "parallel": False,
                "identity_reservation": False,
                "active_session_detection": True,
                "refresh_persistence_errors": False,
                "local_token_telemetry": True,
            },
        }, indent=2))
        sys.exit(0)
    elif args[0] in ("ayuda", "help", "--help", "-h"):
        print("Uso: opencode-switch [comando] [argumentos]")
        print("\nComandos disponibles:")
        print("  status [alias]     Consulta el consumo de tokens y coste local (alias: cuota, tokens)")
        print("  listar             Lista las cuentas guardadas de OpenCode (alias: cuentas)")
        print("  usar <alias>       Activa una cuenta con 'opencode auth switch' (--force)")
        print("  login <alias>      Conecta una cuenta nueva con 'opencode auth login'")
        print("  reautenticar [alias] Reautentica una cuenta existente")
        print("  eliminar <alias>   Cierra sesión/elimina una cuenta (alias: logout, rm)")
        print("  version            Muestra la versión instalada")
    else:
        print(f"Comando desconocido: {args[0]}")
        print("Uso: opencode-switch [status | listar | usar <alias> | login <alias> | reautenticar | eliminar | version]")
        sys.exit(1)


if __name__ == "__main__":
    main()
