# ==============================================================================
# CARGA DE MÓDULOS DE CODEX Y AGY
# ==============================================================================

def find_module_file(name: str) -> Path | None:
    here = Path(__file__).resolve().parent
    candidates = [
        here / name,
        Path.home() / ".local" / "bin" / name,
        Path("/usr/local/bin") / name,
    ]
    which = shutil.which(name)
    if which:
        candidates.insert(0, Path(which))
    for c in candidates:
        if c.is_file():
            return c
    return None

def load_cli_module(name: str):
    f = find_module_file(name)
    if not f:
        return None
    try:
        mod_name = name.replace("-", "_")
        return SourceFileLoader(mod_name, str(f)).load_module()
    except Exception as e:
        print(f"Advertencia: no se pudo cargar {name} ({f}): {e}", file=sys.stderr)
        return None

CODEX_MOD = load_cli_module("codex-switch")
AGY_MOD = load_cli_module("agy-switch")

# ==============================================================================
# PROVEEDORES DE CUENTAS (EXTENSIBLES)
# ==============================================================================

class BaseProvider:
    id: str = ""
    name: str = ""
    badge: str = ""
    cli_cmd: str = ""
    color: str = "#6366f1"

    def is_available(self) -> bool:
        raise NotImplementedError

    def get_status(self) -> dict:
        raise NotImplementedError

    def switch_account(self, name: str, force: bool = False) -> tuple[bool, str, list]:
        raise NotImplementedError

    def get_running_clients(self) -> list:
        return []


class CodexProvider(BaseProvider):
    id = "codex"
    name = "OpenAI Codex"
    badge = "CODEX"
    cli_cmd = "codex-switch"
    color = "#10b981"

    def is_available(self) -> bool:
        return CODEX_MOD is not None

    def get_running_clients(self) -> list:
        if CODEX_MOD and hasattr(CODEX_MOD, "find_running_clients"):
            try:
                return CODEX_MOD.find_running_clients("codex")
            except Exception:
                pass
        return []

    def get_status(self) -> dict:
        if not CODEX_MOD:
            return {
                "id": self.id,
                "name": self.name,
                "badge": self.badge,
                "color": self.color,
                "error": "Módulo codex-switch no encontrado",
                "accounts": [],
            }

        auth_path = CODEX_MOD.get_auth_path()
        cuentas_dir = CODEX_MOD.get_cuentas_dir()
        active_profile = CODEX_MOD.find_active_profile_name(cuentas_dir, auth_path)
        active_email = CODEX_MOD.decode_account_from_auth(auth_path)

        guardadas = sorted(
            cuentas_dir.glob("*.json"),
            key=lambda p: (0 if p.stem == active_profile else 1, p.stem.lower()),
        )
        now_ts = int(time.time())

        def check_profile(p: Path) -> dict:
            p_name = p.stem
            is_active = (p_name == active_profile)
            q = CODEX_MOD.fetch_codex_quota(p, active_profile=active_profile)
            err = q.get("err_msg")

            acc = {
                "name": p_name,
                "provider": self.id,
                "provider_name": self.name,
                "email": q.get("email") or CODEX_MOD.decode_account_from_auth(p),
                "plan": (q.get("plan_type") or "desconocido").upper(),
                "is_active": is_active,
                "error": err,
                "status": "error" if err else "available",
                "status_text": "Disponible" if not err else err,
                "primary_window": None,
                "weekly_window": None,
                "reset_credits": q.get("rate_limit_reset_credits", {}).get("available_count", 0),
            }

            if not err and q.get("rate_limit"):
                rate = q["rate_limit"]
                allowed = rate.get("allowed", True)
                if not allowed:
                    acc["status"] = "exhausted"
                    acc["status_text"] = "Agotado"

                pw = rate.get("primary_window")
                if pw:
                    used = int(pw.get("used_percent", 0))
                    rem = max(0, 100 - used)
                    res_sec = int(pw.get("reset_after_seconds", 0))
                    win_sec = int(pw.get("limit_window_seconds", 18000))
                    label = "5 Horas" if win_sec <= 21600 else f"{win_sec // 86400} Días"
                    acc["primary_window"] = {
                        "label": label,
                        "used_percent": used,
                        "remaining_percent": rem,
                        "reset_after_seconds": res_sec,
                        "reset_at_timestamp": now_ts + res_sec if res_sec > 0 else now_ts,
                        "window_seconds": win_sec,
                    }

                sw = rate.get("secondary_window")
                if sw:
                    s_used = int(sw.get("used_percent", 0))
                    s_rem = max(0, 100 - s_used)
                    s_res = int(sw.get("reset_after_seconds", 0))
                    s_win = int(sw.get("limit_window_seconds", 604800))
                    acc["weekly_window"] = {
                        "label": "Consumo Semanal (7d)",
                        "used_percent": s_used,
                        "remaining_percent": s_rem,
                        "reset_after_seconds": s_res,
                        "reset_at_timestamp": now_ts + s_res if s_res > 0 else now_ts,
                        "window_seconds": s_win,
                    }
                elif pw and pw.get("limit_window_seconds", 0) >= 86400 * 5:
                    acc["weekly_window"] = acc["primary_window"]

            return acc

        with ThreadPoolExecutor(max_workers=min(len(guardadas), 8) or 1) as pool:
            accounts = list(pool.map(check_profile, guardadas))

        if not accounts and auth_path.is_file():
            acc = check_profile(auth_path)
            acc["name"] = "(activa sin guardar)"
            acc["is_active"] = True
            accounts = [acc]

        return {
            "id": self.id,
            "name": self.name,
            "badge": self.badge,
            "cli_cmd": self.cli_cmd,
            "color": self.color,
            "active_profile": active_profile,
            "active_email": active_email,
            "accounts": accounts,
        }

    def switch_account(self, name: str, force: bool = False) -> tuple[bool, str, list]:
        mod_file = find_module_file("codex-switch")
        if not mod_file:
            return False, "Ejecutable codex-switch no encontrado", []
        cmd = [sys.executable, str(mod_file), "usar", name]
        if force:
            cmd.append("--force")

        running = self.get_running_clients()
        if running and not force:
            return False, f"Se detectaron {len(running)} sesiones activas de Codex", running

        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode == 0:
            return True, f"Cuenta cambiada con éxito a '{name}'", []
        return False, res.stderr.strip() or res.stdout.strip() or "Error al cambiar cuenta", running

    def delete_account(self, name: str) -> tuple[bool, str]:
        mod_file = find_module_file("codex-switch")
        if not mod_file:
            return False, "Ejecutable codex-switch no encontrado"
        cmd = [sys.executable, str(mod_file), "eliminar", name]
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode == 0:
            return True, f"Perfil '{name}' eliminado con éxito"
        return False, res.stderr.strip() or res.stdout.strip() or "Error al eliminar perfil"


class AgyProvider(BaseProvider):
    id = "agy"
    name = "Google Antigravity"
    badge = "AGY"
    cli_cmd = "agy-switch"
    color = "#6366f1"

    def is_available(self) -> bool:
        return AGY_MOD is not None

    def get_running_clients(self) -> list:
        if AGY_MOD and hasattr(AGY_MOD, "find_running_clients"):
            try:
                return AGY_MOD.find_running_clients("agy")
            except Exception:
                pass
        return []

    def get_status(self) -> dict:
        if not AGY_MOD:
            return {
                "id": self.id,
                "name": self.name,
                "badge": self.badge,
                "color": self.color,
                "error": "Módulo agy-switch no encontrado",
                "accounts": [],
            }

        token_path = AGY_MOD.get_token_path()
        cuentas_dir = AGY_MOD.get_cuentas_dir()
        active_profile = AGY_MOD.find_active_profile_name(cuentas_dir, token_path)
        active_email = AGY_MOD.decode_email_from_token(token_path)

        guardadas = sorted(cuentas_dir.glob("*.token"))
        now_dt = datetime.now(timezone.utc)
        now_ts = int(now_dt.timestamp())

        def check_profile(p: Path) -> dict:
            p_name = p.stem
            is_active = (p_name == active_profile)
            q = AGY_MOD.fetch_agy_quota(p, active_profile=active_profile)
            err = q.get("err_msg")

            acc = {
                "name": p_name,
                "provider": self.id,
                "provider_name": self.name,
                "email": q.get("email") or AGY_MOD.decode_email_from_token(p),
                "plan": (q.get("plan") or "Antigravity").upper(),
                "is_active": is_active,
                "error": err,
                "status": "error" if err else "available",
                "status_text": "Disponible" if not err else err,
                "gemini": None,
                "claude": None,
                "weekly_window": None,
            }

            if not err:
                models = q.get("models", {})

                # Gemini
                g_model = (
                    models.get("gemini-2.5-flash")
                    or models.get("gemini-2.5-pro")
                    or models.get("gemini-3.5-flash-lite")
                    or {}
                )
                g_q = g_model.get("quotaInfo", {})
                g_frac = float(g_q.get("remainingFraction", 1.0))
                g_res_str = g_q.get("resetTime", "")
                g_sec = 0
                g_res_ts = now_ts
                if g_res_str:
                    try:
                        dt = datetime.fromisoformat(g_res_str.replace("Z", "+00:00"))
                        g_sec = max(0, int((dt - now_dt).total_seconds()))
                        g_res_ts = int(dt.timestamp())
                    except Exception:
                        pass

                g_rem = int(round(g_frac * 100))
                acc["gemini"] = {
                    "label": "Gemini (5h)",
                    "remaining_percent": g_rem,
                    "used_percent": max(0, 100 - g_rem),
                    "reset_after_seconds": g_sec,
                    "reset_at_timestamp": g_res_ts,
                }

                # Claude
                c_model = (
                    models.get("claude-sonnet-5-5-high")
                    or models.get("claude-opus-5-5-medium")
                    or models.get("claude-opus-4-6-thinking")
                    or {}
                )
                c_q = c_model.get("quotaInfo", {})
                c_frac = float(c_q.get("remainingFraction", 1.0))
                c_res_str = c_q.get("resetTime", "")
                c_sec = 0
                c_res_ts = now_ts
                if c_res_str:
                    try:
                        dt = datetime.fromisoformat(c_res_str.replace("Z", "+00:00"))
                        c_sec = max(0, int((dt - now_dt).total_seconds()))
                        c_res_ts = int(dt.timestamp())
                    except Exception:
                        pass

                c_rem = int(round(c_frac * 100))
                acc["claude"] = {
                    "label": "Claude 3P (5h)",
                    "remaining_percent": c_rem,
                    "used_percent": max(0, 100 - c_rem),
                    "reset_after_seconds": c_sec,
                    "reset_at_timestamp": c_res_ts,
                }

                if g_frac <= 0.05 and c_frac <= 0.05:
                    acc["status"] = "exhausted"
                    acc["status_text"] = "Agotado"

            return acc

        with ThreadPoolExecutor(max_workers=min(len(guardadas), 8) or 1) as pool:
            accounts = list(pool.map(check_profile, guardadas))

        return {
            "id": self.id,
            "name": self.name,
            "badge": self.badge,
            "cli_cmd": self.cli_cmd,
            "color": self.color,
            "active_profile": active_profile,
            "active_email": active_email,
            "accounts": accounts,
        }

    def switch_account(self, name: str, force: bool = False) -> tuple[bool, str, list]:
        mod_file = find_module_file("agy-switch")
        if not mod_file:
            return False, "Ejecutable agy-switch no encontrado", []
        cmd = [sys.executable, str(mod_file), "usar", name]
        if force:
            cmd.append("--force")

        running = self.get_running_clients()
        if running and not force:
            return False, f"Se detectaron {len(running)} sesiones activas de AGY", running

        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode == 0:
            return True, f"Cuenta cambiada con éxito a '{name}'", []
        return False, res.stderr.strip() or res.stdout.strip() or "Error al cambiar cuenta", running

    def delete_account(self, name: str) -> tuple[bool, str]:
        mod_file = find_module_file("agy-switch")
        if not mod_file:
            return False, "Ejecutable agy-switch no encontrado"
        cmd = [sys.executable, str(mod_file), "eliminar", name]
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode == 0:
            return True, f"Perfil '{name}' eliminado con éxito"
        return False, res.stderr.strip() or res.stdout.strip() or "Error al eliminar perfil"


# Registro de proveedores (fácilmente extensible para futuros modelos)
PROVIDERS: dict[str, BaseProvider] = {
    "codex": CodexProvider(),
    "agy": AgyProvider(),
}

