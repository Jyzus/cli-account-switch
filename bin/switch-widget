#!/usr/bin/env python3
"""
CLI Account Switch · Desktop Widget
Monitor multiplataforma de cuotas, tokens en vivo, tiempo de reinicio y consumo semanal.
Compatible con Linux, macOS y Windows.
"""

from __future__ import annotations

