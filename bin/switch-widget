  <script>
    // Estado de la Aplicación
    let appData = { providers: [], timestamp: Date.now() / 1000 };
    let currentFilter = "all";
    let searchQuery = "";
    let autoRefreshInterval = 300; // 5 minutos por defecto
    let secondsUntilRefresh = 300;
    let pendingSwitch = null;

    // Elementos DOM
    const accountsContainer = document.getElementById("accounts-container");
    const countdownDisplay = document.getElementById("countdown-display");
    const intervalSelect = document.getElementById("interval-select");
    const btnManualRefresh = document.getElementById("btn-manual-refresh");
    const refreshIcon = document.getElementById("refresh-icon");
    const searchInput = document.getElementById("search-input");
    const filterTabs = document.querySelectorAll(".tab-btn");
    const safetyModal = document.getElementById("safety-modal");
    const modalClientsList = document.getElementById("modal-clients-list");
    const btnModalCancel = document.getElementById("btn-modal-cancel");
    const btnModalForce = document.getElementById("btn-modal-force");
    const toastContainer = document.getElementById("toast-container");

    // Formatear duración en segundos a texto legible
    function formatDuration(sec) {
      if (sec <= 0) return "¡Listo!";
      const d = Math.floor(sec / 86400);
      const h = Math.floor((sec % 86400) / 3600);
      const m = Math.floor((sec % 3600) / 60);
      const s = Math.floor(sec % 60);
      if (d > 0) return `${d}d ${h}h ${m}m ${s}s`;
      if (h > 0) return `${h}h ${m}m ${s}s`;
      if (m > 0) return `${m}m ${s}s`;
      return `${s}s`;
    }

    // Toast emergente
    function showToast(message, type = "info") {
      const toast = document.createElement("div");
      toast.className = `toast ${type}`;
      toast.innerHTML = `<span>${message}</span>`;
      toastContainer.appendChild(toast);
      setTimeout(() => toast.classList.add("show"), 10);
      setTimeout(() => {
        toast.classList.remove("show");
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Copiar al portapapeles
    function copyToClipboard(text, msg = "Copiado al portapapeles") {
      navigator.clipboard.writeText(text).then(() => {
        showToast(msg, "success");
      }).catch(() => {
        showToast("Error al copiar", "error");
      });
    }

    // Consultar estado de la API
    async function fetchStatus(isManual = false) {
      if (isManual) {
        refreshIcon.classList.add("spinning");
        btnManualRefresh.disabled = true;
      }
      try {
        const resp = await fetch("/api/status");
        if (!resp.ok) throw new Error("HTTP " + resp.status);
        appData = await resp.json();
        renderAccounts();
        updateMetrics();
        if (isManual) showToast("Datos actualizados correctamente", "success");
      } catch (err) {
        console.error("Error al obtener estado:", err);
        showToast("Error al conectar con el servidor local", "error");
      } finally {
        if (isManual) {
          setTimeout(() => {
            refreshIcon.classList.remove("spinning");
            btnManualRefresh.disabled = false;
          }, 400);
        }
        secondsUntilRefresh = autoRefreshInterval;
      }
    }

    // Realizar cambio de cuenta
    async function requestSwitch(provider, account, force = false) {
      try {
        const resp = await fetch("/api/switch", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ provider, account, force }),
        });
        const data = await resp.json();

        if (data.status === "warning" && !force) {
          pendingSwitch = { provider, account };
          modalClientsList.innerHTML = (data.clients || []).map(c => `
            <div>• PID ${c.pid} en ${c.tty || "?"}: ${c.cmd} ${c.elapsed ? `(${c.elapsed})` : ""}</div>
          `).join("");
          safetyModal.classList.add("open");
          return;
        }

        if (data.status === "ok") {
          showToast(`✓ ${data.message}`, "success");
          safetyModal.classList.remove("open");
          pendingSwitch = null;
          await fetchStatus(false);
        } else {
          showToast(data.message || "Error al cambiar de cuenta", "error");
        }
      } catch (err) {
        showToast("Error de conexión al cambiar de cuenta", "error");
      }
    }

    // Eliminar perfil guardado
    async function requestDelete(provider, account) {
      if (!confirm(`¿Estás seguro de que deseas eliminar el perfil guardado "${account}"?`)) return;
      try {
        const resp = await fetch("/api/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ provider, account }),
        });
        const data = await resp.json();
        if (data.status === "ok") {
          showToast(`🗑️ ${data.message}`, "success");
          await fetchStatus(false);
        } else {
          showToast(data.message || "Error al eliminar perfil", "error");
        }
      } catch (err) {
        showToast("Error de conexión al eliminar perfil", "error");
      }
    }

    // Renderizar métricas globales
    function updateMetrics() {
      let total = 0;
      let ready = 0;
      let active = 0;
      let codexCount = 0;
      let agyCount = 0;

      (appData.providers || []).forEach(p => {
        (p.accounts || []).forEach(acc => {
          total++;
          if (acc.provider === "codex") codexCount++;
          if (acc.provider === "agy") agyCount++;
          if (acc.is_active) active++;
          if (acc.status === "available") ready++;
        });
      });

      document.getElementById("metric-total").textContent = total;
      document.getElementById("metric-ready").textContent = ready;
      document.getElementById("metric-active").textContent = active;
      document.getElementById("count-all").textContent = total;
      document.getElementById("count-codex").textContent = codexCount;
      document.getElementById("count-agy").textContent = agyCount;
    }

    // Renderizar tarjetas de cuentas
    function renderAccounts() {
      const query = searchQuery.trim().toLowerCase();
      let allAccounts = [];

      (appData.providers || []).forEach(p => {
        (p.accounts || []).forEach(acc => {
          acc.provider_badge = p.badge;
          acc.cli_cmd = p.cli_cmd;
          allAccounts.push(acc);
        });
      });

      // Filtrado por tab y búsqueda
      const filtered = allAccounts.filter(acc => {
        if (currentFilter !== "all" && acc.provider !== currentFilter) return false;
        if (query) {
          const matchName = (acc.name || "").toLowerCase().includes(query);
          const matchEmail = (acc.email || "").toLowerCase().includes(query);
          if (!matchName && !matchEmail) return false;
        }
        return true;
      });

      if (!filtered.length) {
        accountsContainer.innerHTML = `
          <div class="empty-state">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-subtle);">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
            <h3>No se encontraron cuentas</h3>
            <p>No hay cuentas que coincidan con el filtro actual o aún no has guardado perfiles.</p>
            <p style="font-size: 12px;">Para registrar una: <span class="code-pill">codex-switch guardar &lt;alias&gt;</span> o <span class="code-pill">agy-switch guardar &lt;alias&gt;</span></p>
          </div>
        `;
        return;
      }

      accountsContainer.innerHTML = filtered.map(acc => {
        const isCodex = acc.provider === "codex";
        const providerClass = isCodex ? "provider-codex" : "provider-agy";
        const statusClass = acc.status || "available";

        // Barras y cuotas
        let quotasHtml = "";

        if (acc.error) {
          quotasHtml = `
            <div class="card-error">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
              <span>${acc.error}</span>
            </div>
          `;
        } else if (isCodex) {
          // Codex Quotas
          const pw = acc.primary_window;
          const ww = acc.weekly_window;

          if (pw) {
            const barClass = pw.remaining_percent > 40 ? "bar-high" : (pw.remaining_percent > 15 ? "bar-medium" : "bar-low");
            quotasHtml += `
              <div class="quota-item">
                <div class="quota-header">
                  <span class="quota-title">⚡ Límite Corto (${pw.label})</span>
                  <span class="quota-fraction" style="color: ${pw.remaining_percent > 40 ? '#34d399' : (pw.remaining_percent > 15 ? '#fbbf24' : '#f87171')}">
                    ${pw.remaining_percent}% disponible
                  </span>
                </div>
                <div class="progress-bar-bg">
                  <div class="progress-bar-fill ${barClass}" style="width: ${pw.remaining_percent}%"></div>
                </div>
                <div class="quota-footer">
                  <span>${pw.used_percent}% usado</span>
                  <span class="reset-clock" data-reset-ts="${pw.reset_at_timestamp}">
                    ⏳ Resetea en: <b>calculando...</b>
                  </span>
                </div>
              </div>
            `;
          }

          if (ww && ww !== pw) {
            const barClass = ww.remaining_percent > 40 ? "bar-high" : (ww.remaining_percent > 15 ? "bar-medium" : "bar-low");
            quotasHtml += `
              <div class="quota-item">
                <div class="quota-header">
                  <span class="quota-title">📅 Consumo Semanal (7d)</span>
                  <span class="quota-fraction" style="color: ${ww.remaining_percent > 40 ? '#34d399' : (ww.remaining_percent > 15 ? '#fbbf24' : '#f87171')}">
                    ${ww.remaining_percent}% disponible
                  </span>
                </div>
                <div class="progress-bar-bg">
                  <div class="progress-bar-fill ${barClass}" style="width: ${ww.remaining_percent}%"></div>
                </div>
                <div class="quota-footer">
                  <span>${ww.used_percent}% usado</span>
                  <span class="reset-clock" data-reset-ts="${ww.reset_at_timestamp}">
                    ⏳ Resetea en: <b>calculando...</b>
                  </span>
                </div>
              </div>
            `;
          }

          if (acc.reset_credits > 0) {
            quotasHtml += `
              <div class="reset-credits-badge">
                ★ ${acc.reset_credits} crédito(s) de reinicio disponible(s)
              </div>
            `;
          }
        } else {
          // AGY Quotas
          const gm = acc.gemini;
          const cl = acc.claude;

          if (gm) {
            const barClass = gm.remaining_percent > 40 ? "bar-high" : (gm.remaining_percent > 15 ? "bar-medium" : "bar-low");
            quotasHtml += `
              <div class="quota-item">
                <div class="quota-header">
                  <span class="quota-title">✦ Gemini Models (5h)</span>
                  <span class="quota-fraction" style="color: ${gm.remaining_percent > 40 ? '#34d399' : (gm.remaining_percent > 15 ? '#fbbf24' : '#f87171')}">
                    ${gm.remaining_percent}% disponible
                  </span>
                </div>
                <div class="progress-bar-bg">
                  <div class="progress-bar-fill ${barClass}" style="width: ${gm.remaining_percent}%"></div>
                </div>
                <div class="quota-footer">
                  <span>${gm.used_percent}% usado</span>
                  <span class="reset-clock" data-reset-ts="${gm.reset_at_timestamp}">
                    ⏳ Resetea en: <b>calculando...</b>
                  </span>
                </div>
              </div>
            `;
          }

          if (cl) {
            const barClass = cl.remaining_percent > 40 ? "bar-high" : (cl.remaining_percent > 15 ? "bar-medium" : "bar-low");
            quotasHtml += `
              <div class="quota-item">
                <div class="quota-header">
                  <span class="quota-title">✦ Claude 3P Models (5h)</span>
                  <span class="quota-fraction" style="color: ${cl.remaining_percent > 40 ? '#34d399' : (cl.remaining_percent > 15 ? '#fbbf24' : '#f87171')}">
                    ${cl.remaining_percent}% disponible
                  </span>
                </div>
                <div class="progress-bar-bg">
                  <div class="progress-bar-fill ${barClass}" style="width: ${cl.remaining_percent}%"></div>
                </div>
                <div class="quota-footer">
                  <span>${cl.used_percent}% usado</span>
                  <span class="reset-clock" data-reset-ts="${cl.reset_at_timestamp}">
                    ⏳ Resetea en: <b>calculando...</b>
                  </span>
                </div>
              </div>
            `;
          }
        }

        const cliCmd = `${acc.cli_cmd || "switch"} usar ${acc.name}`;

        return `
          <div class="account-card ${acc.is_active ? 'is-active' : ''}">
            ${acc.is_active ? '<div class="active-indicator"></div>' : ''}
            
            <div class="card-head">
              <div class="card-title-group">
                <div class="card-tags">
                  <span class="provider-pill ${providerClass}">${acc.provider_badge}</span>
                  ${acc.is_active ? '<span class="active-badge">★ ACTIVA EN DISCO</span>' : ''}
                </div>
                <div class="account-name" title="${acc.name}">${acc.name}</div>
              </div>

              <div class="status-badge ${statusClass}">
                <span class="dot"></span>
                <span>${acc.status_text}</span>
              </div>
            </div>

            <div class="card-meta">
              <span class="email-display" title="${acc.email || ''}">${acc.email || 'Sin correo detectado'}</span>
              <span class="plan-pill">${acc.plan || 'ESTÁNDAR'}</span>
            </div>

            <div class="quotas-section">
              ${quotasHtml}
            </div>

            <div class="card-actions">
              <button class="btn-switch" ${acc.is_active ? 'disabled' : ''} 
                onclick="requestSwitch('${acc.provider}', '${acc.name}', false)">
                ${acc.is_active ? '✓ Cuenta Activa' : '⚡ Usar Esta Cuenta'}
              </button>
              <button class="btn-icon" title="Copiar comando: ${cliCmd}" onclick="copyToClipboard('${cliCmd}')">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
              </button>
              <button class="btn-icon btn-danger" title="Eliminar perfil '${acc.name}'" onclick="requestDelete('${acc.provider}', '${acc.name}')">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </div>
          </div>
        `;
      }).join("");

      updateCountdowns();
    }

    // Actualizador en vivo de relojes regresivos
    function updateCountdowns() {
      const now = Math.floor(Date.now() / 1000);
      document.querySelectorAll(".reset-clock").forEach(el => {
        const resetTs = parseInt(el.getAttribute("data-reset-ts"), 10);
        if (!resetTs || isNaN(resetTs)) return;
        const remaining = resetTs - now;
        if (remaining <= 0) {
          el.className = "reset-clock ready";
          el.innerHTML = "✓ ¡Cuota reiniciada!";
        } else {
          el.className = "reset-clock";
          el.innerHTML = `⏳ Resetea en: <b>${formatDuration(remaining)}</b>`;
        }
      });
    }

    // Timer periódico de segundo a segundo
    setInterval(() => {
      updateCountdowns();

      // Contador de auto-refresh
      if (autoRefreshInterval > 0) {
        secondsUntilRefresh--;
        if (secondsUntilRefresh <= 0) {
          fetchStatus(false);
        } else {
          const m = Math.floor(secondsUntilRefresh / 60);
          const s = secondsUntilRefresh % 60;
          countdownDisplay.textContent = `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
        }
      } else {
        countdownDisplay.textContent = "Pausa";
      }
    }, 1000);

    // Event Listeners
    btnManualRefresh.addEventListener("click", () => fetchStatus(true));

    intervalSelect.addEventListener("change", (e) => {
      autoRefreshInterval = parseInt(e.target.value, 10);
      secondsUntilRefresh = autoRefreshInterval;
      if (autoRefreshInterval === 0) {
        countdownDisplay.textContent = "Pausa";
      }
    });

    searchInput.addEventListener("input", (e) => {
      searchQuery = e.target.value;
      renderAccounts();
    });

    filterTabs.forEach(tab => {
      tab.addEventListener("click", () => {
        filterTabs.forEach(t => t.classList.remove("active"));
        tab.classList.add("active");
        currentFilter = tab.getAttribute("data-filter");
        renderAccounts();
      });
    });

    btnModalCancel.addEventListener("click", () => {
      safetyModal.classList.remove("open");
      pendingSwitch = null;
    });

    btnModalForce.addEventListener("click", () => {
      if (pendingSwitch) {
        requestSwitch(pendingSwitch.provider, pendingSwitch.account, true);
      }
    });

    // Carga inicial
    fetchStatus(false);
  </script>
</body>
</html>
"""

# ==============================================================================
# SERVIDOR HTTP REST API Y MANEJADOR
# ==============================================================================

class WidgetHTTPHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        # Silenciar logs ruidosos en terminal para mantener la salida limpia
        pass

    def send_json(self, status_code: int, data: dict):
        payload = json.dumps(data, indent=2).encode("utf-8")
        self.send_response(status_code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()
        self.wfile.write(payload)

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path

        if path == "/":
            payload = HTML_DASHBOARD.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
            return

        if path == "/api/status":
            params = parse_qs(parsed.query)
            filter_provider = params.get("filter", [""])[0]

            results = []
            providers_to_check = [
                p for p in PROVIDERS.values()
                if not filter_provider or p.id == filter_provider
            ]

            with ThreadPoolExecutor(max_workers=len(providers_to_check) or 1) as pool:
                results = list(pool.map(lambda p: p.get_status(), providers_to_check))

            self.send_json(200, {
                "timestamp": int(time.time()),
                "providers": results,
            })
            return

        if path == "/api/clients":
            running = {}
            for p_id, prov in PROVIDERS.items():
                running[p_id] = prov.get_running_clients()
            self.send_json(200, {"clients": running})
            return

        self.send_response(404)
        self.end_headers()

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path

        if path == "/api/switch":
            try:
                length = int(self.headers.get("Content-Length", 0))
                body = json.loads(self.rfile.read(length).decode("utf-8"))
            except Exception:
                self.send_json(400, {"status": "error", "message": "JSON inválido"})
                return

            prov_id = body.get("provider", "")
            account = body.get("account", "")
            force = bool(body.get("force", False))

            provider = PROVIDERS.get(prov_id)
            if not provider:
                self.send_json(404, {"status": "error", "message": f"Proveedor '{prov_id}' desconocido"})
                return

            if not account:
                self.send_json(400, {"status": "error", "message": "Nombre de cuenta requerido"})
                return

            ok, msg, clients = provider.switch_account(account, force=force)
            if not ok and clients and not force:
                self.send_json(200, {
                    "status": "warning",
                    "message": msg,
                    "clients": clients,
                })
                return

            if ok:
                self.send_json(200, {"status": "ok", "message": msg})
            else:
                self.send_json(400, {"status": "error", "message": msg})
            return

        if path == "/api/delete":
            try:
                length = int(self.headers.get("Content-Length", 0))
                body = json.loads(self.rfile.read(length).decode("utf-8"))
            except Exception:
                self.send_json(400, {"status": "error", "message": "JSON inválido"})
                return

            prov_id = body.get("provider", "")
            account = body.get("account", "")

            provider = PROVIDERS.get(prov_id)
            if not provider:
                self.send_json(404, {"status": "error", "message": f"Proveedor '{prov_id}' desconocido"})
                return

            if not account:
                self.send_json(400, {"status": "error", "message": "Nombre de cuenta requerido"})
                return

            ok, msg = provider.delete_account(account)
            if ok:
                self.send_json(200, {"status": "ok", "message": msg})
            else:
                self.send_json(400, {"status": "error", "message": msg})
            return

        self.send_response(404)
        self.end_headers()


# ==============================================================================
# LANZAMIENTO MULTIPLATAFORMA (DESKTOP / NATIVE WINDOW / BROWSER)
# ==============================================================================

def open_desktop_widget(url: str, app_mode: bool = True):
    """
    Intenta abrir el widget en una ventana de aplicación dedicada e independiente
    (sin pestañas ni barra de URL), compatible con Linux, macOS y Windows.
    """
    if not app_mode:
        import webbrowser
        webbrowser.open(url)
        return

    # Comandos de navegadores que soportan modo aplicación (--app)
    browsers = [
        # Linux / Windows / Mac
        ["google-chrome", f"--app={url}", "--window-size=480,780"],
        ["chromium-browser", f"--app={url}", "--window-size=480,780"],
        ["chromium", f"--app={url}", "--window-size=480,780"],
        ["brave-browser", f"--app={url}", "--window-size=480,780"],
        ["brave", f"--app={url}", "--window-size=480,780"],
        ["msedge", f"--app={url}", "--window-size=480,780"],
    ]

    # En Windows, msedge está siempre presente
    if sys.platform.startswith("win"):
        edge_paths = [
            r"C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe",
            r"C:\Program Files\Microsoft\Edge\Application\msedge.exe",
        ]
        for ep in edge_paths:
            if os.path.isfile(ep):
                browsers.insert(0, [ep, f"--app={url}", "--window-size=480,780"])

    # En macOS, Google Chrome o Edge via open
    if sys.platform == "darwin":
        browsers.insert(0, ["open", "-na", "Google Chrome", "--args", f"--app={url}", "--window-size=480,780"])
        browsers.insert(1, ["open", "-na", "Microsoft Edge", "--args", f"--app={url}", "--window-size=480,780"])

    for b in browsers:
        exe = b[0]
        if shutil.which(exe) or (os.path.isabs(exe) and os.path.isfile(exe)):
            try:
                subprocess.Popen(b, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
            except Exception:
                pass

    # Fallback al navegador estándar del sistema
    try:
        import webbrowser
        webbrowser.open(url)
    except Exception:
        pass


def find_free_port(start_port: int = 4920, max_attempts: int = 20) -> int:
    for port in range(start_port, start_port + max_attempts):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            try:
                s.bind(("127.0.0.1", port))
                return port
            except OSError:
                continue
    return start_port


# ==============================================================================
# PUNTO DE ENTRADA PRINCIPAL
# ==============================================================================

def main():
    parser = argparse.ArgumentParser(
        description="CLI Account Switch · Desktop Widget (Monitor de Cuotas, Tokens y Consumo Semanal)"
    )
    parser.add_argument("-v", "--version", action="version", version=f"CLI Account Switch Desktop Widget v{VERSION}")
    parser.add_argument("-p", "--port", type=int, default=4920, help="Puerto local del servidor (por defecto 4920)")
    parser.add_argument("--host", type=str, default="127.0.0.1", help="Host al que vincular el servidor (por defecto 127.0.0.1)")
    parser.add_argument("-f", "--filter", type=str, choices=["all", "codex", "agy"], default="all", help="Filtro predeterminado")
    parser.add_argument("--no-browser", action="store_true", help="No abrir la interfaz gráfica automáticamente")
    parser.add_argument("--browser-tab", action="store_true", help="Abrir como pestaña del navegador en vez de ventana de app dedicada")

    args = parser.parse_args()

    port = find_free_port(args.port)
    server_address = (args.host, port)

    try:
        httpd = ThreadingHTTPServer(server_address, WidgetHTTPHandler)
    except OSError as e:
        print(f"❌ Error al iniciar servidor en {args.host}:{port}: {e}", file=sys.stderr)
        sys.exit(1)

    url = f"http://{args.host}:{port}"

    print("\n╭─────────────────────────────────────────────────────────────╮")
    print("│  ✦ CLI Account Switch · Desktop Widget                      │")
    print("╰─────────────────────────────────────────────────────────────╯")
    print(f"  • URL Local    : \033[1;36m{url}\033[0m")
    print("  • Proveedores  : \033[1;32mOpenAI Codex\033[0m & \033[1;35mGoogle Antigravity (AGY)\033[0m")
    print("  • Actualización: Automática en vivo + botón manual")
    print("  • Métricas     : Cuotas 5h, Consumo Semanal (7d) y Tiempo de Reinicio")
    print("  • Detener      : Presiona Ctrl+C en esta terminal\n")

    # Si hay pantalla o interfaz gráfica disponible y no se especificó --no-browser
    has_display = bool(
        os.environ.get("DISPLAY")
        or os.environ.get("WAYLAND_DISPLAY")
        or sys.platform in ("win32", "darwin")
    )

    if not args.no_browser and has_display:
        t = threading.Thread(
            target=open_desktop_widget,
            args=(url, not args.browser_tab),
            daemon=True,
        )
        t.start()
    elif not has_display:
        print("  💡 Servidor iniciado en segundo plano. Abre la URL en tu navegador:")
        print(f"     \033[1m{url}\033[0m\n")

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nCerrando servidor del Widget... ¡Hasta luego!")
        httpd.server_close()


if __name__ == "__main__":
    main()
