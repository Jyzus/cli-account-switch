#!/usr/bin/env python3
"""
codex-switch: Gestor de multi-cuentas y reanudación de sesiones para OpenAI Codex CLI (codex).
Permite alternar entre perfiles de autenticación locales,
preservando el historial de la sesión intacto.
"""

import sys
import os
import time
import json
import base64
import shutil
import re
import subprocess
import tempfile
import urllib.request
import urllib.parse
import urllib.error
import fcntl
import hashlib
from datetime import datetime, timezone
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

VERSION = "1.2.2"
GITHUB_REPO = "Jyzus/cli-account-switch"
INSTALL_URL = f"https://raw.githubusercontent.com/{GITHUB_REPO}/main/install.sh"

def validate_alias(nombre: str):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", nombre):
        print("❌ Alias inválido: usa de 1 a 64 letras, números, puntos, guiones o guiones bajos; empieza con letra o número.")
        sys.exit(2)


def private_copy(source: Path, destination: Path):
    # Crear el destino con permisos privados antes de escribir credenciales.
    import tempfile
    fd, temporary = tempfile.mkstemp(prefix=".profile-", dir=destination.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(source.read_bytes())
        os.replace(temporary, destination)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def get_base_dir() -> Path:
    configured = os.environ.get("CODEX_HOME")
    if configured:
        return Path(configured).expanduser()
    home = Path(os.environ.get("HOME", Path.home()))
    return home / ".codex"

def get_cuentas_dir() -> Path:
    d = get_base_dir() / "cuentas"
    d.mkdir(parents=True, exist_ok=True, mode=0o700)
    d.chmod(0o700)
    return d

def get_auth_path() -> Path:
    return get_base_dir() / "auth.json"

def decode_account_from_auth(auth_file: Path) -> str:
    if not auth_file.is_file():
        return "No configurada (sin auth.json)"
    try:
        data = json.loads(auth_file.read_text(encoding="utf-8"))
        if data.get("email"):
            return data["email"]
        tokens = data.get("tokens", {})
        id_token = tokens.get("id_token", "")
        if id_token and "." in id_token:
            payload = id_token.split(".")[1]
            payload += "=" * (-len(payload) % 4)
            jwt = json.loads(base64.urlsafe_b64decode(payload))
            return jwt.get("email") or jwt.get("sub") or "Token sin email"
        account_id = tokens.get("account_id")
        if account_id:
            return f"Account ID: {account_id}"
        return data.get("auth_mode", "Modo auth desconocido")
    except Exception as e:
        return f"Error al decodificar: {e}"

def extract_account_key(auth_file: Path) -> str:
    """Extrae un identificador único y estable para la cuenta (email, sub, account_id o token)."""
    if not auth_file.is_file():
        return ""
    try:
        data = json.loads(auth_file.read_text(encoding="utf-8"))
        if data.get("email"):
            return f"email:{data['email'].lower().strip()}"
        tokens = data.get("tokens", {})
        id_token = tokens.get("id_token", "")
        if id_token and "." in id_token:
            payload = id_token.split(".")[1]
            payload += "=" * (-len(payload) % 4)
            jwt = json.loads(base64.urlsafe_b64decode(payload))
            email = jwt.get("email")
            if email:
                return f"email:{email.lower().strip()}"
            sub = jwt.get("sub")
            if sub:
                return f"sub:{sub}"
        account_id = tokens.get("account_id")
        if account_id:
            return f"account_id:{account_id}"
        rt = tokens.get("refresh_token")
        if rt:
            return f"rt:{rt[:32]}"
        at = tokens.get("access_token")
        if at:
            return f"at:{at[:32]}"
        return ""
    except Exception:
        return ""

def compute_opaque_identity(auth_file: Path) -> str:
    """Calcula una identidad opaca estable por sha256 a partir de la identidad real extraída."""
    key = extract_account_key(auth_file)
    if key:
        return hashlib.sha256(key.encode("utf-8")).hexdigest()[:16]
    if auth_file.is_file():
        try:
            return hashlib.sha256(auth_file.read_bytes()).hexdigest()[:16]
        except Exception:
            pass
    return ""

def get_most_recent_session_id() -> str:
    index_file = get_base_dir() / "session_index.jsonl"
    if not index_file.is_file():
        return ""
    try:
        lines = [line.strip() for line in index_file.read_text(encoding="utf-8").splitlines() if line.strip()]
        if not lines:
            return ""
        last_obj = json.loads(lines[-1])
        return last_obj.get("id", "")
    except Exception:
        return ""

def get_active_profile_marker() -> Path:
    return get_cuentas_dir() / ".active_profile"

def get_recorded_active_profile() -> str:
    marker = get_active_profile_marker()
    if marker.is_file():
        try:
            val = marker.read_text(encoding="utf-8").strip()
            if val and (get_cuentas_dir() / f"{val}.json").is_file():
                return val
        except Exception:
            pass
    return ""

def set_recorded_active_profile(nombre: str):
    if not nombre or nombre.startswith("("):
        return
    marker = get_active_profile_marker()
    try:
        marker.write_text(nombre.strip() + "\n", encoding="utf-8")
        marker.chmod(0o600)
    except Exception:
        pass

def clear_recorded_active_profile():
    marker = get_active_profile_marker()
    if marker.is_file():
        try:
            marker.unlink()
        except Exception:
            pass

def sync_active_profile() -> str:
    """Sincroniza automáticamente auth.json con el perfil guardado en cuentas/ si fue actualizado o reautenticado."""
    auth_path = get_auth_path()
    if not auth_path.is_file() or auth_path.stat().st_size <= 20:
        return ""
    try:
        auth_bytes = auth_path.read_bytes()
        auth_data = json.loads(auth_bytes)
        tokens = auth_data.get("tokens", {})
        has_creds = bool(auth_data.get("OPENAI_API_KEY") or tokens.get("access_token") or tokens.get("refresh_token"))
        if not has_creds:
            return ""
    except Exception:
        return ""

    cuentas_dir = get_cuentas_dir()
    recorded = get_recorded_active_profile()

    target = recorded
    if not target or not (cuentas_dir / f"{target}.json").is_file():
        deduced = find_active_profile_name(cuentas_dir, auth_path)
        if deduced and not deduced.startswith("("):
            target = deduced
            set_recorded_active_profile(target)

    if not target or not (cuentas_dir / f"{target}.json").is_file():
        return ""

    target_file = cuentas_dir / f"{target}.json"
    try:
        if target_file.read_bytes() != auth_bytes:
            private_copy(auth_path, target_file)
            return target
    except Exception:
        pass
    return target

def find_active_profile_name(cuentas_dir: Path, auth_path: Path) -> str:
    if not auth_path.is_file():
        return "(ninguna)"
    try:
        current_bytes = auth_path.read_bytes()
    except Exception:
        return "(desconocido)"

    rec = get_recorded_active_profile()
    if rec and (cuentas_dir / f"{rec}.json").is_file():
        try:
            if (cuentas_dir / f"{rec}.json").read_bytes() == current_bytes:
                return rec
        except Exception:
            pass
        active_key = extract_account_key(auth_path)
        rec_key = extract_account_key(cuentas_dir / f"{rec}.json")
        if active_key and rec_key and active_key == rec_key:
            return rec

    # 1. Búsqueda exacta por contenido
    for f in sorted(cuentas_dir.glob("*.json")):
        try:
            if f.read_bytes() == current_bytes:
                set_recorded_active_profile(f.stem)
                return f.stem
        except Exception:
            continue

    # 2. Búsqueda por clave de cuenta (en caso de refresco de tokens)
    active_key = extract_account_key(auth_path)
    if active_key:
        for f in sorted(cuentas_dir.glob("*.json")):
            try:
                if extract_account_key(f) == active_key:
                    return f.stem
            except Exception:
                continue

    # Si hay un perfil activo registrado y auth_path contiene credenciales
    if rec and (cuentas_dir / f"{rec}.json").is_file():
        return rec

    return "(sin guardar / temporal)"

def format_duration(seconds: float) -> str:
    if seconds <= 0:
        return "ahora"
    seconds = int(seconds)
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    mins = rem // 60
    parts = []
    if days > 0:
        parts.append(f"{days}d")
    if hours > 0:
        parts.append(f"{hours}h")
    if mins > 0 and days == 0:
        parts.append(f"{mins}m")
    return " ".join(parts) if parts else "<1m"


def render_bar(fraction_remaining: float, width: int = 10) -> str:
    fraction = max(0.0, min(1.0, fraction_remaining))
    filled = int(round(fraction * width))
    bar = "█" * filled + "░" * (width - filled)
    pct = int(round(fraction * 100))
    if pct > 40:
        color = "\033[1;32m"  # verde
    elif pct > 15:
        color = "\033[1;33m"  # amarillo
    else:
        color = "\033[1;31m"  # rojo
    return f"{color}[{bar}] {pct:3d}%\033[0m"


def refresh_codex_token(profile_path: Path, data: dict, active_profile: str = "") -> bool:
    tokens = data.get("tokens", {})
    rt = tokens.get("refresh_token")
    cid = (tokens.get("oauth_provenance") or {}).get("client_id") or "app_EMoamEEZ73f0CkXaXp7hrann"
    if not rt:
        return False
    body = urllib.parse.urlencode({
        "grant_type": "refresh_token",
        "refresh_token": rt,
        "client_id": cid,
    }).encode()
    req = urllib.request.Request(
        "https://auth.openai.com/oauth/token",
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded", "User-Agent": "codex-cli"},
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            res = json.loads(resp.read().decode())
            if "access_token" in res:
                tokens["access_token"] = res["access_token"]
                if "refresh_token" in res:
                    tokens["refresh_token"] = res["refresh_token"]
                if "id_token" in res:
                    tokens["id_token"] = res["id_token"]
                data["tokens"] = tokens
                data["last_refresh"] = datetime.now(timezone.utc).isoformat()
                
                # Guardar atómicamente el perfil refrescado
                content = json.dumps(data, indent=2).encode("utf-8")
                write_auth_atomic(profile_path, content)
                
                # Si este perfil es el activo en disco, sincronizar auth.json
                if active_profile and profile_path.stem == active_profile:
                    auth_path = get_auth_path()
                    write_auth_atomic(auth_path, content)
                return True
    except Exception:
        pass
    return False


def fetch_codex_quota(profile_path: Path, active_profile: str = "") -> dict:
    try:
        data = json.loads(profile_path.read_text(encoding="utf-8"))
    except Exception as e:
        return {"err_msg": f"Archivo ilegible: {e}"}

    tokens = data.get("tokens", {})
    access_token = tokens.get("access_token")
    account_id = tokens.get("account_id")
    api_key = data.get("OPENAI_API_KEY")

    if api_key and not access_token:
        return {"type": "api_key", "email": "API Key de OpenAI"}

    if not access_token:
        return {"err_msg": "Sin token de acceso"}

    def do_request(tok: str) -> dict:
        headers = {
            "Authorization": f"Bearer {tok}",
            "User-Agent": "codex-cli",
            "Accept": "application/json",
        }
        if account_id:
            headers["ChatGPT-Account-Id"] = account_id
        req = urllib.request.Request("https://chatgpt.com/backend-api/wham/usage", headers=headers)
        with urllib.request.urlopen(req, timeout=8) as resp:
            return json.loads(resp.read().decode())

    try:
        return do_request(access_token)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            if refresh_codex_token(profile_path, data, active_profile=active_profile):
                new_token = data.get("tokens", {}).get("access_token")
                try:
                    return do_request(new_token)
                except Exception as e2:
                    return {"err_msg": f"HTTP {e.code} tras refresco ({e2})"}
            return {"err_msg": "Sesión expirada (requiere login o codex-switch nueva)", "expired": True}
        return {"err_msg": f"HTTP {e.code}: {e.reason}"}
    except Exception as e:
        return {"err_msg": f"Sin conexión / {e}"}


def cmd_listar():
    sync_active_profile()
    auth_path = get_auth_path()
    cuentas_dir = get_cuentas_dir()
    account_info = decode_account_from_auth(auth_path)
    active_profile = find_active_profile_name(cuentas_dir, auth_path)
    last_sid = get_most_recent_session_id()

    print("\n╭─────────────────────────────────────────────────────────────╮")
    print("│  ✦ CODEX Multi-Cuenta · Perfiles Guardados (Offline)        │")
    print("╰─────────────────────────────────────────────────────────────╯")
    print(f"  • Cuenta en disco: \033[1;32m{account_info}\033[0m")
    print(f"  • Perfil guardado: \033[1;36m{active_profile}\033[0m")
    if last_sid:
        print(f"  • Última sesión  : \033[1;33m{last_sid}\033[0m")
    print(f"  • Credenciales   : {auth_path}")

    guardadas = list(cuentas_dir.glob("*.json"))
    print("\n  Cuentas disponibles en disco:")
    if not guardadas:
        print("    (No hay cuentas guardadas todavía. Usa: codex-switch guardar <nombre>)")
    else:
        for f in sorted(guardadas):
            p_name = f.stem
            p_acc = decode_account_from_auth(f)
            check = "★ [EN DISCO]" if p_name == active_profile else "  "
            print(f"    {check} \033[1m{p_name:14}\033[0m → {p_acc}")
    print("\n  Tip: Usa 'codex-switch status' para consultar tokens y límites restantes en tiempo real.\n")


def cmd_status(target: str = ""):
    sync_active_profile()
    auth_path = get_auth_path()
    cuentas_dir = get_cuentas_dir()
    account_info = decode_account_from_auth(auth_path)
    active_profile = find_active_profile_name(cuentas_dir, auth_path)
    last_sid = get_most_recent_session_id()

    print("\n╭─────────────────────────────────────────────────────────────╮")
    print("│  ✦ CODEX Multi-Cuenta · Estado de Cuotas & Tokens en Vivo  │")
    print("╰─────────────────────────────────────────────────────────────╯")
    print(f"  • Cuenta en disco: \033[1;32m{account_info}\033[0m")
    print(f"  • Perfil activo  : \033[1;36m{active_profile}\033[0m")
    if last_sid:
        print(f"  • Última sesión  : \033[1;33m{last_sid}\033[0m (Para continuar: codex-switch continuar)")

    guardadas = sorted(cuentas_dir.glob("*.json"))
    if target:
        guardadas = [f for f in guardadas if f.stem == target]
        if not guardadas:
            print(f"\n❌ Error: La cuenta '{target}' no existe en {cuentas_dir}.")
            print("   Usa 'codex-switch listar' para ver los perfiles existentes.")
            sys.exit(1)

    if not guardadas:
        print("\n  (No hay cuentas guardadas todavía. Usa: codex-switch guardar <nombre>)")
        return

    print("\n  Consultando cuota y tokens de cada cuenta...")

    def check_one(path: Path):
        return path, fetch_codex_quota(path, active_profile=active_profile)

    with ThreadPoolExecutor(max_workers=min(len(guardadas), 8) or 1) as pool:
        results = list(pool.map(check_one, guardadas))

    disponibles = []
    print("\n  Estado de Cuentas:")
    for f, q in results:
        p_name = f.stem
        is_active = (p_name == active_profile)
        check_mark = "★ [EN DISCO]" if is_active else " " * 12

        err = q.get("err_msg")
        if err:
            print(f"\n  {check_mark} \033[1m{p_name:14}\033[0m ⚠️  \033[1;31m{err}\033[0m")
            continue

        if q.get("type") == "api_key":
            print(f"\n  {check_mark} \033[1m{p_name:14}\033[0m [API KEY] \033[1;32m🟢 ACTIVA\033[0m")
            print("      Uso facturado por consumo directo de OpenAI API Key.")
            disponibles.append(p_name)
            continue

        email = q.get("email") or decode_account_from_auth(f)
        plan = (q.get("plan_type") or "desconocido").upper()
        rate = q.get("rate_limit") or {}
        allowed = rate.get("allowed", True)
        pw = rate.get("primary_window") or {}
        sw = rate.get("secondary_window") or {}

        if allowed:
            status_tag = "\033[1;32m🟢 DISPONIBLE\033[0m"
            disponibles.append(p_name)
        else:
            status_tag = "\033[1;31m🔴 AGOTADO\033[0m"

        print(f"\n  {check_mark} \033[1m{p_name:14}\033[0m [{plan}] {status_tag} → {email}")

        p_used = pw.get("used_percent", 0)
        p_rem_frac = max(0.0, 1.0 - (p_used / 100.0))
        p_res = pw.get("reset_after_seconds", 0)
        p_window_sec = pw.get("limit_window_seconds", 18000)
        p_win_label = f"{int(p_window_sec // 3600)}h" if p_window_sec < 86400 else f"{int(p_window_sec // 86400)}d"
        p_res_str = f"resetea en {format_duration(p_res)}" if p_res > 0 else "reseteado"
        print(f"      Cuota {p_win_label:3}: {render_bar(p_rem_frac)} restante · {p_used}% usado ({p_res_str})")

        if sw:
            s_used = sw.get("used_percent", 0)
            s_rem_frac = max(0.0, 1.0 - (s_used / 100.0))
            s_res = sw.get("reset_after_seconds", 0)
            s_res_str = f"resetea en {format_duration(s_res)}" if s_res > 0 else "reseteado"
            print(f"      Cuota Sem: {render_bar(s_rem_frac)} restante · {s_used}% usado ({s_res_str})")

        reset_credits = q.get("rate_limit_reset_credits", {}).get("available_count", 0)
        if reset_credits > 0:
            print(f"      Créditos : \033[1;33m★ {reset_credits} crédito(s) de reset disponible(s)\033[0m")

    if disponibles:
        disp_str = ", ".join(f"\033[1;36m{d}\033[0m" for d in disponibles)
        print(f"\n  💡 Cuentas con tokens disponibles ahora: {disp_str}")
        if active_profile not in disponibles and disponibles:
            print(f"     Sugerencia: cambia a una con: \033[1;33mcodex-switch usar {disponibles[0]}\033[0m")

    print("\n  Comandos frecuentes:")
    print("    codex-switch status [nombre]    Consulta cuotas y tokens en vivo (alias: tokens, cuota)")
    print("    codex-switch usar <nombre>      Cambia de cuenta y reinicia el daemon activo")
    print("    codex-switch agregar <nombre>   Agrega una cuenta en entorno aislado (sin tocar tu sesión)")
    print("    codex-switch listar             Lista rápida de cuentas en disco (offline)")
    print("    codex-switch nueva <nombre>     Inicia sesión con una cuenta adicional")
    print("    codex-switch eliminar <nombre>  Elimina un perfil guardado (alias: borrar, rm)")
    print("    codex-switch renombrar <a1> <a2> Renombra un perfil guardado (alias: mv)")
    print("    codex-switch version            Muestra la versión instalada y opciones de actualización")
    print("    codex-switch actualizar         Actualiza CLI Account Switch a la última versión (alias: update)")
    print("    codex-switch continuar          Reanuda la última tarea\n")

def cmd_guardar(nombre: str, force: bool = False):
    if not nombre:
        print("❌ Error: Especifica un nombre (ej: codex-switch guardar cuenta1)")
        sys.exit(1)
    validate_alias(nombre)
    auth_path = get_auth_path()
    if not auth_path.is_file():
        print("❌ Error: No existe un auth.json activo para guardar.")
        print("   • Si deseas agregar una cuenta adicional sin tocar tu sesión actual:")
        print(f"     \033[1;32mcodex-switch agregar {nombre}\033[0m")
        print("   • O inicia sesión primero con 'codex login'.")
        sys.exit(1)

    cuentas_dir = get_cuentas_dir()
    dest = cuentas_dir / f"{nombre}.json"
    active_key = extract_account_key(auth_path)
    account_info = decode_account_from_auth(auth_path)

    # 1. Si el archivo destino ya existe en disco, verificar si pertenece a OTRA cuenta
    if dest.is_file() and not force:
        dest_key = extract_account_key(dest)
        if dest_key and active_key and dest_key != active_key:
            old_info = decode_account_from_auth(dest)
            print(f"\n⚠️  El perfil '\033[1;36m{nombre}\033[0m' ya existe y pertenece a otra cuenta ({old_info}).")
            print("   Guardar ahora sobrescribirá ese perfil y se perderán sus credenciales.")
            print(f"   • Usa otro nombre o fuerza el reemplazo con: \033[1;33mcodex-switch guardar {nombre} --force\033[0m\n")
            sys.exit(1)

    # 2. Detección de duplicados: verificar si esta MISMA cuenta ya está guardada con otro alias
    if not force:
        try:
            auth_bytes = auth_path.read_bytes()
        except Exception:
            auth_bytes = b""

        for f in sorted(cuentas_dir.glob("*.json")):
            if f.stem == nombre:
                continue
            is_same = False
            f_key = extract_account_key(f)
            if active_key and f_key and active_key == f_key:
                is_same = True
            elif auth_bytes:
                try:
                    if f.read_bytes() == auth_bytes:
                        is_same = True
                except Exception:
                    pass

            if is_same:
                existing_alias = f.stem
                print("\n╭─────────────────────────────────────────────────────────────╮")
                print("│  ⚠️  CUENTA YA REGISTRADA CON OTRO ALIAS                   │")
                print("╰─────────────────────────────────────────────────────────────╯")
                print(f"  • Cuenta activa : \033[1;32m{account_info}\033[0m")
                print(f"  • Perfil actual : \033[1;36m{existing_alias}\033[0m (ya existe en disco)")
                print(f"  • Alias nuevo   : \033[1;33m{nombre}\033[0m")
                print("\n  Esta cuenta ya está guardada. Para evitar perfiles duplicados innecesarios:")
                print(f"    • Renombrar el perfil existente:")
                print(f"      \033[1;33mcodex-switch renombrar {existing_alias} {nombre}\033[0m")
                print(f"    • Si realmente deseas mantener dos perfiles para la misma cuenta:")
                print(f"      \033[1;33mcodex-switch guardar {nombre} --force\033[0m\n")
                sys.exit(1)

    is_update = dest.is_file()
    private_copy(auth_path, dest)
    set_recorded_active_profile(nombre)
    action_text = "actualizada" if is_update else "guardada"
    print(f"✅ Cuenta {action_text} con éxito:")
    print(f"   Perfil : \033[1;36m{nombre}\033[0m")
    print(f"   Cuenta : \033[1;32m{account_info}\033[0m")
    print(f"   Destino: {dest}")


def cmd_agregar(nombre: str, desde: str = "", device_auth: bool = False, force: bool = False):
    if not nombre:
        print("❌ Error: Especifica un nombre para la cuenta (ej: codex-switch agregar cuenta2)")
        sys.exit(1)
    validate_alias(nombre)

    cuentas_dir = get_cuentas_dir()
    auth_path = get_auth_path()
    active_profile = find_active_profile_name(cuentas_dir, auth_path)
    active_info = decode_account_from_auth(auth_path) if auth_path.is_file() else "(ninguna)"

    dest = cuentas_dir / f"{nombre}.json"

    with tempfile.TemporaryDirectory(prefix="codex-add-") as tmpdir:
        tmp_auth = Path(tmpdir) / "auth.json"

        if desde:
            # Importar desde archivo o JSON directo
            p = Path(desde).expanduser()
            if p.is_file():
                try:
                    raw_content = p.read_text(encoding="utf-8")
                except Exception as e:
                    print(f"❌ Error al leer el archivo '{desde}': {e}")
                    sys.exit(1)
            else:
                raw_content = desde.strip()

            try:
                data = json.loads(raw_content)
                if not isinstance(data, dict):
                    raise ValueError("El contenido debe ser un objeto JSON.")
            except Exception as e:
                print(f"❌ Error: El parámetro --desde debe ser una ruta a un archivo auth.json válido o un JSON ({e}).")
                sys.exit(1)

            tokens = data.get("tokens") or {}
            has_api_key = bool(data.get("OPENAI_API_KEY"))
            has_oauth = bool(tokens.get("access_token") and tokens.get("refresh_token"))
            if not (has_api_key or has_oauth):
                print("❌ Error: El archivo o JSON proporcionado no contiene credenciales válidas de Codex")
                print("   (requiere 'OPENAI_API_KEY' o 'access_token' y 'refresh_token').")
                sys.exit(1)

            tmp_auth.write_text(json.dumps(data, indent=2), encoding="utf-8")
        else:
            # Login interactivo aislado con CODEX_HOME temporal
            print("\n╭─────────────────────────────────────────────────────────────╮")
            print("│  ✦ AGREGAR CUENTA EN ENTORNO AISLADO (SIN TOCAR TU SESIÓN)  │")
            print("╰─────────────────────────────────────────────────────────────╯")
            print(f"  • Cuenta activa actual : \033[1;32m{active_info}\033[0m ({active_profile})")
            print(f"  • Nuevo perfil         : \033[1;36m{nombre}\033[0m")
            print("\n  🛡️  Esta operación se ejecutará en un entorno temporal aislado:")
            print("     • Tus chats abiertos, sesiones y daemon actual NO se interrumpirán.")
            print("     • Tu archivo auth.json activo NO sufrirá ninguna modificación.")
            print("     • El nuevo perfil se guardará exclusivamente en cuentas/ para monitoreo.")
            print("\n🚀 Iniciando flujo de inicio de sesión aislado de Codex...")
            if device_auth:
                print("   Se usará autenticación por dispositivo (--device-auth).")

            env = os.environ.copy()
            env["CODEX_HOME"] = tmpdir

            cmd = ["codex", "login"]
            if device_auth:
                cmd.append("--device-auth")

            try:
                result = subprocess.run(cmd, env=env, check=False)
                if result.returncode != 0 or not tmp_auth.is_file():
                    print("\n⚠️ El login en el entorno aislado no se completó.")
                    print("   No se guardó ninguna cuenta. Tu sesión activa sigue intacta.")
                    sys.exit(result.returncode or 1)
            except FileNotFoundError:
                print("\n❌ No se encontró el ejecutable 'codex'.")
                sys.exit(127)
            except KeyboardInterrupt:
                print("\n\n⚠️ Operación cancelada por el usuario. Tu sesión activa sigue intacta.")
                sys.exit(130)

        # Validar credenciales generadas
        try:
            auth_bytes = tmp_auth.read_bytes()
            auth_data = json.loads(auth_bytes)
            tokens = auth_data.get("tokens") or {}
            if not (auth_data.get("OPENAI_API_KEY") or (tokens.get("access_token") and tokens.get("refresh_token"))):
                raise ValueError("Credenciales incompletas.")
        except Exception as e:
            print(f"\n❌ Error: Las credenciales obtenidas no son válidas: {e}")
            sys.exit(1)

        new_key = extract_account_key(tmp_auth)
        new_info = decode_account_from_auth(tmp_auth)

        # 1. Si el perfil ya existe en disco y pertenece a otra cuenta
        if dest.is_file() and not force:
            dest_key = extract_account_key(dest)
            if dest_key and new_key and dest_key != new_key:
                old_info = decode_account_from_auth(dest)
                print(f"\n⚠️  El perfil '\033[1;36m{nombre}\033[0m' ya existe y pertenece a otra cuenta ({old_info}).")
                print("   Agregar con este nombre sobrescribirá ese perfil y se perderán sus credenciales.")
                print(f"   • Usa otro nombre o fuerza el reemplazo con: \033[1;33mcodex-switch agregar {nombre} --force\033[0m\n")
                sys.exit(1)

        # 2. Detección de duplicados: verificar si esta MISMA cuenta ya está guardada con otro alias
        if not force:
            for f in sorted(cuentas_dir.glob("*.json")):
                if f.stem == nombre:
                    continue
                is_same = False
                f_key = extract_account_key(f)
                if new_key and f_key and new_key == f_key:
                    is_same = True
                elif auth_bytes:
                    try:
                        if f.read_bytes() == auth_bytes:
                            is_same = True
                    except Exception:
                        pass

                if is_same:
                    existing_alias = f.stem
                    print("\n╭─────────────────────────────────────────────────────────────╮")
                    print("│  ⚠️  CUENTA YA REGISTRADA CON OTRO ALIAS                   │")
                    print("╰─────────────────────────────────────────────────────────────╯")
                    print(f"  • Cuenta detectada : \033[1;32m{new_info}\033[0m")
                    print(f"  • Perfil guardado  : \033[1;36m{existing_alias}\033[0m (ya existe en disco)")
                    print(f"  • Alias solicitado : \033[1;33m{nombre}\033[0m")
                    print("\n  Esta cuenta ya está registrada. Para evitar perfiles duplicados innecesarios:")
                    print(f"    • Renombrar el perfil existente: \033[1;33mcodex-switch renombrar {existing_alias} {nombre}\033[0m")
                    print(f"    • O forzar el nuevo alias:       \033[1;33mcodex-switch agregar {nombre} --force\033[0m\n")
                    sys.exit(1)

        is_update = dest.is_file()
        private_copy(tmp_auth, dest)
        action_text = "actualizada" if is_update else "agregada"
        print(f"\n✅ Cuenta {action_text} exitosamente como '\033[1;36m{nombre}\033[0m' ({new_info})!")
        print(f"\n  ℹ️  Tu sesión activa permanece en: \033[1;32m{active_info}\033[0m ({active_profile})")
        print("     Tus chats abiertos y daemon de Codex no sufrieron ninguna interrupción.")
        print("\n  📊 Opciones disponibles para la nueva cuenta:")
        print(f"     • Monitorear cuotas y tokens : \033[1;33mcodex-switch status {nombre}\033[0m")
        print("     • Ver en widget o bandeja    : \033[1;33mswitch-widget\033[0m  o  \033[1;33mswitch-tray\033[0m")
        print(f"     • Cambiar a esta cuenta      : \033[1;33mcodex-switch usar {nombre}\033[0m\n")


def cmd_eliminar(nombre: str):
    validate_alias(nombre)
    if not nombre:
        print("❌ Error: Especifica el nombre de la cuenta a eliminar (ej: codex-switch eliminar cuenta1)")
        sys.exit(1)

    cuentas_dir = get_cuentas_dir()
    target = cuentas_dir / f"{nombre}.json"
    if not target.is_file():
        print(f"❌ Error: El perfil '{nombre}' no existe en {cuentas_dir}.")
        print("   Usa 'codex-switch listar' para ver las cuentas guardadas.")
        sys.exit(1)

    account_info = decode_account_from_auth(target)
    auth_path = get_auth_path()
    is_active = (find_active_profile_name(cuentas_dir, auth_path) == nombre)

    target.unlink()
    if get_recorded_active_profile() == nombre:
        clear_recorded_active_profile()
    print(f"🗑️  Perfil '\033[1;36m{nombre}\033[0m' ({account_info}) eliminado con éxito.")
    if is_active:
        print("   ℹ️  Nota: Este perfil era el que estaba activo en tu sesión actual.")
        print("      La sesión continuará activa hasta que cambies de cuenta ('codex-switch usar <otra>')")
        print("      o cierres sesión con 'codex logout'.")


def cmd_renombrar(actual: str, nuevo: str):
    validate_alias(actual)
    validate_alias(nuevo)
    if not actual or not nuevo:
        print("❌ Error: Uso: codex-switch renombrar <nombre_actual> <nuevo_nombre>")
        sys.exit(1)

    if actual == nuevo:
        print(f"ℹ️ El nombre origen y destino son idénticos ('{actual}'). No se requieren cambios.")
        return

    cuentas_dir = get_cuentas_dir()
    src = cuentas_dir / f"{actual}.json"
    dst = cuentas_dir / f"{nuevo}.json"

    if not src.is_file():
        print(f"❌ Error: El perfil origen '{actual}' no existe.")
        print("   Usa 'codex-switch listar' para ver los perfiles disponibles.")
        sys.exit(1)

    if dst.is_file():
        print(f"❌ Error: Ya existe un perfil con el nombre '{nuevo}'.")
        print(f"   Elimínalo primero con 'codex-switch eliminar {nuevo}' o elige otro alias.")
        sys.exit(1)

    src.rename(dst)
    if get_recorded_active_profile() == actual:
        set_recorded_active_profile(nuevo)
    account_info = decode_account_from_auth(dst)
    print(f"✏️  Perfil renombrado con éxito:")
    print(f"   '\033[1;36m{actual}\033[0m' → '\033[1;32m{nuevo}\033[0m' ({account_info})")

def daemon_is_running() -> bool:
    """Detecta el daemon de este CODEX_HOME, sin iniciar uno nuevo."""
    pid_file = get_base_dir() / "app-server-daemon" / "daemon.pid"
    try:
        record = json.loads(pid_file.read_text(encoding="utf-8"))
        pid = int(record["pid"])
        if pid <= 0:
            return False
        os.kill(pid, 0)
        # Evita confundir un PID reutilizado con el servidor de Codex.
        proc = Path(f"/proc/{pid}")
        if proc.exists():
            args = (proc / "cmdline").read_bytes().split(b"\0")
            if b"app-server" not in args or b"--managed-daemon" not in args:
                return False
            identity = record.get("processIdentity", {})
            expected = identity.get("startTicks")
            if expected is not None:
                fields = (proc / "stat").read_text().rsplit(")", 1)[1].split()
                if int(fields[19]) != int(expected):
                    return False
        return True
    except (OSError, ValueError, KeyError, TypeError):
        return False

def write_auth_atomic(path: Path, content: bytes):
    """Publica credenciales completas con permisos privados."""
    fd, name = tempfile.mkstemp(prefix=".auth-switch-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)

def run_daemon_action(action: str) -> bool:
    try:
        result = subprocess.run(
            ["codex", "app-server", "daemon", action], check=False,
            timeout=60, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        if result.returncode == 0:
            return True
    except (OSError, subprocess.TimeoutExpired):
        pass
    print(f"❌ No se pudo ejecutar: codex app-server daemon {action}", flush=True)
    return False

def find_running_clients(tool: str = "codex") -> list:
    """Detecta procesos interactivos / clientes abiertos del CLI en el equipo."""
    current_pid = os.getpid()
    clients = []

    btime = 0
    try:
        with open("/proc/stat", encoding="utf-8") as f:
            for line in f:
                if line.startswith("btime "):
                    btime = int(line.split()[1])
                    break
    except Exception:
        pass
    clock_ticks = os.sysconf(os.sysconf_names.get("SC_CLK_TCK", 100)) or 100
    now = time.time()

    proc_dir = Path("/proc")
    if proc_dir.is_dir():
        for proc in proc_dir.glob("[0-9]*"):
            try:
                pid = int(proc.name)
                if pid == current_pid:
                    continue
                stat_file = proc / "stat"
                if not stat_file.exists():
                    continue
                stat_parts = stat_file.read_text().rsplit(")", 1)[1].split()
                if stat_parts[0] == "Z":  # Ignorar zombies
                    continue

                cmd_file = proc / "cmdline"
                if not cmd_file.exists():
                    continue
                raw = cmd_file.read_bytes()
                if not raw:
                    continue
                args = [a.decode("utf-8", errors="ignore") for a in raw.split(b"\0") if a]
                if not args:
                    continue

                cmd_str = " ".join(args)
                exe = os.path.basename(args[0])

                if "switch" in exe or "switch" in cmd_str:
                    continue

                is_client = False
                if tool == "codex":
                    if exe in ("codex", "codex.real") or "codex" in args[0]:
                        is_daemon = any(flag in cmd_str for flag in [
                            "--managed-daemon",
                            "pid-update-loop",
                            "app-server-daemon",
                            "daemon-updater",
                        ])
                        if not is_daemon:
                            is_client = True
                    elif exe in ("codex-code-mode-host", "codex-exec-server"):
                        is_client = True
                elif tool == "agy":
                    if exe in ("agy", "agy.real") or "agy" in args[0]:
                        is_client = True

                if not is_client:
                    continue

                tty = "?"
                try:
                    fd0 = os.readlink(proc / "fd" / "0")
                    if fd0.startswith("/dev/pts/") or fd0.startswith("/dev/tty"):
                        tty = fd0.replace("/dev/", "")
                except Exception:
                    pass

                if tty == "?":
                    tty_nr = int(stat_parts[4])
                    if tty_nr != 0:
                        tty = f"tty-{tty_nr}"
                    else:
                        tty = "segundo plano"

                elapsed_str = ""
                try:
                    start_ticks = int(stat_parts[19])
                    start_sec = btime + (start_ticks / clock_ticks)
                    elapsed = max(0, int(now - start_sec))
                    m, s = divmod(elapsed, 60)
                    h, m = divmod(m, 60)
                    if h > 0:
                        elapsed_str = f"hace {h}h {m}m"
                    elif m > 0:
                        elapsed_str = f"hace {m}m"
                    else:
                        elapsed_str = f"hace {s}s"
                except Exception:
                    pass

                clients.append({
                    "pid": pid,
                    "exe": exe,
                    "tty": tty,
                    "cmd": cmd_str,
                    "elapsed": elapsed_str,
                })
            except (OSError, ValueError):
                continue
    return clients


def cmd_usar(nombre: str, force: bool = False):
    validate_alias(nombre)
    if not nombre or nombre in (".", "..") or "/" in nombre or "\\" in nombre:
        print("❌ Especifica un alias válido: codex-switch usar <nombre> [--force]")
        sys.exit(1)
    src = get_cuentas_dir() / f"{nombre}.json"
    if not src.is_file():
        print(f"❌ La cuenta '{nombre}' no existe. Usa: codex-switch listar")
        sys.exit(1)

    auth_path = get_auth_path()
    cuentas_dir = get_cuentas_dir()
    active_profile = find_active_profile_name(cuentas_dir, auth_path)
    if nombre == active_profile:
        account_info = decode_account_from_auth(auth_path)
        print(f"ℹ️ La cuenta '\033[1;36m{nombre}\033[0m' ({account_info}) ya está seleccionada y activa en disco.")
        return

    # Verificación de seguridad: detectar sesiones/chats activos de Codex
    running_clients = find_running_clients("codex")
    if running_clients and not force:
        account_info = decode_account_from_auth(auth_path)
        print("\n╭─────────────────────────────────────────────────────────────╮")
        print("│  ⚠️  SESIONES ACTIVAS DE CODEX DETECTADAS                   │")
        print("╰─────────────────────────────────────────────────────────────╯")
        print(f"  • Cuenta activa actual : \033[1;32m{account_info}\033[0m ({active_profile})")
        print(f"  • Cuenta a seleccionar : \033[1;36m{nombre}\033[0m")
        print(f"\n  ⚠️  Se detectaron {len(running_clients)} sesión(es)/chat(s) de Codex en ejecución en este equipo:")
        for c in running_clients:
            pid = c["pid"]
            tty = c["tty"]
            cmd = c["cmd"]
            el = c["elapsed"]
            el_text = f" [{el}]" if el else ""
            print(f"     → \033[1mPID {pid}\033[0m en \033[1;33m{tty}\033[0m: {cmd}{el_text}")

        print("\n  🛡️  Cambiar de cuenta mientras tienes chats abiertos desconectaría esas sesiones,")
        print("     interrumpiría tareas en curso e invalidaría los tokens de tu cuenta actual.")

        if sys.stdin.isatty():
            try:
                resp = input("\n  ¿Deseas continuar y cambiar de cuenta de todas formas? (s/N): ").strip().lower()
            except (KeyboardInterrupt, EOFError):
                print("\n⛔ Operación cancelada por el usuario.")
                sys.exit(130)
            if resp in ("s", "si", "sí", "y", "yes"):
                force = True
            else:
                print("\n⛔ Cambio de cuenta cancelado por el usuario.\n")
                sys.exit(1)
        else:
            print("\n  Para cambiar de forma segura:")
            print("     1. Ve a las terminales indicadas arriba y cierra las sesiones (/exit o Ctrl+D).")
            print(f"     2. Vuelve a ejecutar: \033[1mcodex-switch usar {nombre}\033[0m")
            print("\n  Si deseas forzar el cambio en entornos no interactivos:")
            print(f"     \033[1;31mcodex-switch usar {nombre} --force\033[0m (o: \033[1;31m-y\033[0m)\n")
            sys.exit(1)

    if running_clients and force:
        print(f"\n⚠️  Advertencia: Continuando cambio de cuenta con {len(running_clients)} proceso(s) activo(s)...", flush=True)

    # Sincronizar credenciales salientes antes de conmutar para no perder tokens frescos o logins
    prev_active = get_recorded_active_profile() or active_profile
    if prev_active and not prev_active.startswith("(") and prev_active != nombre:
        prev_file = cuentas_dir / f"{prev_active}.json"
        if prev_file.is_file() and auth_path.is_file() and auth_path.stat().st_size > 20:
            try:
                if prev_file.read_bytes() != auth_path.read_bytes():
                    private_copy(auth_path, prev_file)
            except Exception:
                pass

    try:
        selected = src.read_bytes()
        data = json.loads(selected)
        tokens = data.get("tokens") or {}
        if not (data.get("OPENAI_API_KEY") or
                (tokens.get("access_token") and tokens.get("refresh_token"))):
            raise ValueError("credenciales incompletas")
    except (OSError, ValueError, AttributeError, TypeError):
        print("❌ El perfil no contiene credenciales válidas; no se cambió la cuenta.")
        sys.exit(1)

    running = daemon_is_running()
    if running:
        # Detener primero impide que el servidor vuelva a guardar la cuenta anterior.
        print("🔄 Deteniendo el servidor persistente para cambiar la cuenta...", flush=True)
        print("   Las conexiones abiertas se desconectarán y deberán reconectarse.", flush=True)
        if not run_daemon_action("stop"):
            print("   No se reemplazaron las credenciales.")
            sys.exit(1)
        if daemon_is_running():
            print("❌ El servidor sigue activo; no se reemplazaron las credenciales.")
            sys.exit(1)
    try:
        write_auth_atomic(auth_path, selected)
        set_recorded_active_profile(nombre)
    except OSError:
        print("❌ No se pudieron instalar las credenciales seleccionadas.")
        if running:
            run_daemon_action("start")
        sys.exit(1)
    if running and not run_daemon_action("start"):
        print(f"   El perfil '{nombre}' quedó en disco, pero el servidor no se inició.")
        print("   Para completar el cambio: codex app-server daemon start")
        sys.exit(1)

    account_info = decode_account_from_auth(auth_path)
    print(f"✅ Cuenta seleccionada: {nombre} ({account_info})", flush=True)
    if running:
        print("   Servidor persistente reiniciado con las credenciales seleccionadas.")
        print("   Reconecta la aplicación para continuar la conversación.")
    print("   Si tienes una CLI independiente abierta, ciérrala y reanúdala:")
    print("   codex-switch continuar")

    q = fetch_codex_quota(src, active_profile=nombre)
    if q.get("expired"):
        print(f"\n⚠️  Aviso: La sesión de '\033[1;36m{nombre}\033[0m' está expirada.")
        print("   • Al usar Codex o ejecutar \033[1;32mcodex-switch reautenticar\033[0m, se te pedirá iniciar sesión.")
        print("   • Switch guardará y registrará automáticamente la nueva sesión en este perfil para que no tengas que volver a iniciarla.\n")


def cmd_nueva(nombre: str, device_auth: bool = False, force: bool = False, aislada: bool = False):
    if not nombre:
        print("❌ Error: Especifica un nombre para la nueva cuenta (ej: codex-switch nueva cuenta2)")
        sys.exit(1)
    validate_alias(nombre)

    if aislada:
        cmd_agregar(nombre, device_auth=device_auth, force=force)
        return

    auth_path = get_auth_path()
    cuentas_dir = get_cuentas_dir()

    running_clients = find_running_clients("codex")
    if running_clients and not force:
        account_info = decode_account_from_auth(auth_path)
        active_profile = find_active_profile_name(cuentas_dir, auth_path)
        print("\n╭─────────────────────────────────────────────────────────────╮")
        print("│  ⚠️  SESIONES ACTIVAS DE CODEX DETECTADAS                   │")
        print("╰─────────────────────────────────────────────────────────────╯")
        print(f"  • Cuenta activa actual : \033[1;32m{account_info}\033[0m ({active_profile})")
        print(f"\n  ⚠️  Hay {len(running_clients)} chat(s)/sesión(es) activa(s) de Codex abiertas en este equipo:")
        for c in running_clients:
            pid = c["pid"]
            tty = c["tty"]
            cmd = c["cmd"]
            el = c["elapsed"]
            el_text = f" [{el}]" if el else ""
            print(f"     → \033[1mPID {pid}\033[0m en \033[1;33m{tty}\033[0m: {cmd}{el_text}")
        print("\n  Iniciar sesión con otra cuenta ahora reemplazará tus credenciales activas y puede")
        print("  interrumpir esas conversaciones.")
        print(f"\n  💡 Tip: Si solo deseas registrar la cuenta para monitorear sus tokens/cuotas")
        print(f"     sin cerrar tus chats activos ni cambiar la cuenta activa, usa:")
        print(f"     \033[1;32mcodex-switch agregar {nombre}\033[0m\n")

        if sys.stdin.isatty():
            try:
                resp = input("  ¿Deseas continuar e iniciar sesión de todas formas? (s/N): ").strip().lower()
            except (KeyboardInterrupt, EOFError):
                print("\n⛔ Operación cancelada por el usuario.")
                sys.exit(130)
            if resp in ("s", "si", "sí", "y", "yes"):
                force = True
            else:
                print("\n⛔ Operación cancelada por el usuario.\n")
                sys.exit(1)
        else:
            print("  Para continuar de todas formas en entornos no interactivos, usa: --force o -y\n")
            sys.exit(1)

    if running_clients and force:
        print(f"\n⚠️  Advertencia: Continuando inicio de sesión con {len(running_clients)} proceso(s) activo(s)...", flush=True)

    if auth_path.is_file():
        actual = find_active_profile_name(cuentas_dir, auth_path)
        if actual.startswith("(sin guardar"):
            backup = cuentas_dir / "anterior_auto.json"
            private_copy(auth_path, backup)
            print(f"ℹ️ Credenciales actuales respaldadas preventivamente como 'anterior_auto'.")

    temp_backup = get_base_dir() / "auth.json.bak"
    if auth_path.is_file():
        shutil.move(auth_path, temp_backup)

    login_cmd = ["codex", "login"]
    if device_auth:
        login_cmd.append("--device-auth")
    print("\n🚀 Iniciando flujo de login para la nueva cuenta de Codex...")
    if device_auth:
        print("   Se usará autenticación por dispositivo (--device-auth).")
    try:
        result = subprocess.run(login_cmd, check=False)
        if result.returncode == 0 and auth_path.is_file():
            dest = cuentas_dir / f"{nombre}.json"
            private_copy(auth_path, dest)
            set_recorded_active_profile(nombre)
            account_info = decode_account_from_auth(dest)
            print(f"\n✅ Nueva cuenta registrada y guardada como '\033[1;36m{nombre}\033[0m' ({account_info})!")
            if temp_backup.is_file():
                temp_backup.unlink()
        else:
            print("\n⚠️ El login no se completó correctamente. Restaurando credencial anterior...")
            if temp_backup.is_file():
                shutil.move(temp_backup, auth_path)
            sys.exit(result.returncode or 1)
    except FileNotFoundError:
        print("\n❌ No se encontró el ejecutable 'codex'. Restaurando credencial anterior...")
        if temp_backup.is_file():
            shutil.move(temp_backup, auth_path)
        sys.exit(127)


def cmd_reautenticar(nombre: str = "", device_auth: bool = False):
    """Reautentica una cuenta expirada y guarda automáticamente las nuevas credenciales en el perfil."""
    cuentas_dir = get_cuentas_dir()
    auth_path = get_auth_path()
    if not nombre:
        nombre = get_recorded_active_profile() or find_active_profile_name(cuentas_dir, auth_path)
        if not nombre or nombre.startswith("("):
            print("❌ Especifica el nombre de la cuenta a reautenticar (ej: codex-switch reautenticar cuenta1)")
            sys.exit(1)
    validate_alias(nombre)
    src = cuentas_dir / f"{nombre}.json"
    if not src.is_file():
        print(f"❌ La cuenta '{nombre}' no existe en {cuentas_dir}.")
        sys.exit(1)

    print(f"\n🔄 Preparando reautenticación para '\033[1;36m{nombre}\033[0m'...")
    set_recorded_active_profile(nombre)

    running_daemon = daemon_is_running()
    if running_daemon:
        run_daemon_action("stop")

    login_cmd = ["codex", "login"]
    if device_auth:
        login_cmd.append("--device-auth")

    try:
        res = subprocess.run(login_cmd, check=False)
        if res.returncode == 0 and auth_path.is_file() and auth_path.stat().st_size > 20:
            private_copy(auth_path, src)
            set_recorded_active_profile(nombre)
            account_info = decode_account_from_auth(src)
            print(f"\n✅ Cuenta '\033[1;36m{nombre}\033[0m' ({account_info}) reautenticada y guardada con éxito en disco!")
            if running_daemon:
                run_daemon_action("restart")
        else:
            print("\n⚠️ No se completó la reautenticación. Se conservaron las credenciales previas.")
            sys.exit(res.returncode or 1)
    except FileNotFoundError:
        print("\n❌ No se encontró el ejecutable 'codex'.")
        sys.exit(127)

def cmd_continuar(args: list[str]):
    last_sid = get_most_recent_session_id()
    cmd = ["codex", "resume"]
    if args:
        cmd.append(args[0])
    elif last_sid:
        cmd.append("--last")
    else:
        print("⚠️ No hay sesiones previas detectadas en session_index. Abriendo selector:")
    
    os.execvp(cmd[0], cmd)

def find_widget_executable() -> Path | None:
    here = Path(__file__).resolve().parent
    candidates = [
        here / "switch-widget",
        Path.home() / ".local" / "bin" / "switch-widget",
        Path("/usr/local/bin/switch-widget"),
    ]
    which = shutil.which("switch-widget")
    if which:
        candidates.insert(0, Path(which))
    for c in candidates:
        if c.is_file():
            return c
    return None


def find_tray_executable() -> Path | None:
    here = Path(__file__).resolve().parent
    candidates = [
        here / "switch-tray",
        Path.home() / ".local" / "bin" / "switch-tray",
        Path("/usr/local/bin/switch-tray"),
    ]
    which = shutil.which("switch-tray")
    if which:
        candidates.insert(0, Path(which))
    for c in candidates:
        if c.is_file():
            return c
    return None


def cmd_widget(extra_args: list):
    w = find_widget_executable()
    if not w:
        print("❌ Error: No se encontró el ejecutable 'switch-widget'.")
        print("   Ejecuta ./install.sh para instalarlo en tu sistema.")
        sys.exit(1)
    cmd = [sys.executable, str(w), "--filter", "codex"] + extra_args
    try:
        subprocess.run(cmd)
    except KeyboardInterrupt:
        pass


